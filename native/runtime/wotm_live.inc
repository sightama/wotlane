namespace wotm_live
{
inline const char *g_stage = "idle";   // native layer step in progress (to locate the crash)
#ifdef _WIN32
// Crash diagnostics: without windows.h (it conflicts with raylib), mirrors only what the filter needs.
struct ExcRecord
{
    unsigned long code, flags;
    ExcRecord *next;
    void *address;
    unsigned long nparams;
    unsigned long long info[15];
};
struct ExcPointers
{
    ExcRecord *rec;
    void *ctx;
};
extern "C" __declspec(dllimport) void *__stdcall SetUnhandledExceptionFilter(long(__stdcall *)(ExcPointers *));
extern "C" __declspec(dllimport) void *__stdcall GetModuleHandleA(const char *);
inline long __stdcall crashFilter(ExcPointers *e)
{
    const char *base = static_cast<const char *>(GetModuleHandleA(nullptr));
    std::fprintf(stderr, "[CRASH] code=0x%08lx addr=%p (exe+0x%llx) stage=%s", e->rec->code, e->rec->address,
                 (unsigned long long)(static_cast<const char *>(e->rec->address) - base), g_stage);
    if (e->rec->code == 0xC0000005)
        std::fprintf(stderr, " access=%s address=0x%llx", e->rec->info[0] == 1 ? "write" : (e->rec->info[0] == 8 ? "execute" : "read"), e->rec->info[1]);
    std::fprintf(stderr, "\n");
    std::fflush(stderr);
    return 0; // EXCEPTION_CONTINUE_SEARCH
}
#else
// Crash diagnostics outside Windows: the same [CRASH] line as crashFilter, from a signal handler, then the stack (wotmCrashTrace) and
// the signal's default action (the process ends with it; core dump if enabled). fprintf isn't async-signal-safe: like the Windows
// filter this runs once, in a process that is already dying, where a best-effort report is worth it. The alternate stack is only the
// installing thread's (the window's): a stack overflow on another thread ends without the report.
inline void crashSignal(int sig, siginfo_t *info, void *uctx)
{
    std::fprintf(stderr, "[CRASH] signal=%d (%s) addr=%p stage=%s\n", sig, strsignal(sig), info ? info->si_addr : nullptr, g_stage);
    std::fflush(stderr);
    static bool traced = false;   // only the first crash: the stack of a second one (inside the trace) doesn't help
    if (!traced)
    {
        traced = true;
        wotmCrashTrace(uctx);
    }
    raise(sig);   // SA_RESETHAND put the default action back
}
inline void installCrashHandler()
{
    static char altStack[1 << 16];
    stack_t ss{};
    ss.ss_sp = altStack;
    ss.ss_size = sizeof altStack;
    sigaltstack(&ss, nullptr);
    struct sigaction sa{};
    sa.sa_sigaction = crashSignal;
    sa.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_RESETHAND;
    sigemptyset(&sa.sa_mask);
    for (const int sig : {SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT})
        sigaction(sig, &sa, nullptr);
}
#endif // _WIN32
struct State
{
    wotm::Scene scene;
    RenderTexture2D rts[2]{};   // alternating: the previous frame's and the texture for texId 0 (the game samples the displayed buffer)
    RenderTexture2D vrts[4]{};  // split screen: one per view (half or quadrant of the frame), composited into rts[cur]
    wotm::msaa::Target ms, vms[4];   // with MSAA: where the frame and the views are drawn before being resolved into rts/vrts
    int cur = 0;
    uint32_t levelSig = 0;
    bool rtxChosen = false;
    std::string rtxPath;
    long frame = 0;
    wotm::Snapshot snap;   // the game's latest frame (drawn until the next one)
    // Frame interpolation (wotmDrawNative): the frame before snap (A; snap is B), the one before that (P, without the particle
    // copy: only the matrices and camera, for the instant before A when B arrives early) and the display clock
    wotm::Snapshot prev, prev2;
    double interpO = 0.0;      // host clock (s) at which the game would be at field 0, filtered (interpTarget)
    bool interpHaveO = false;
    float lastAlpha = -1.f;    // alpha of the last redraw (-1: no blending)
};

// Loaded stage: only the header of the level image at 0xA00000 (N and the N root-node pointers, docs/FORMATOS.md) and the texture
// address. The nodes right after it are live state (the menu rewrites matrices there every frame during screen transitions, which
// invalidated the whole scene each frame: screens at ~16/s).
inline uint32_t levelSignature(const wotm::Ram &ram)
{
    uint32_t h = ram.u32(wotm::addr::tempVramTexAddr) * 2654435761u;
    const uint32_t n = std::min<uint32_t>(ram.u32(0xA00000), 255u);
    for (uint32_t k = 0; k <= n; ++k)
        h = (h ^ ram.u32(0xA00000 + 4 * k)) * 16777619u;
    return h;
}

} // namespace wotm_live

// Draws the stage read from RAM (no VU1/GS) over the frame; returns false (and draws nothing) when no stage is loaded.
namespace wotm_live
{
static bool g_hideFps = false;   // replay (--vu1cmp, wotm_vu1check.inc): native image without the FPS counter
static bool g_force43 = false;   // replay: 4:3 frame, like the GS reference image
static bool g_localCollect = false;   // replay (--vu1cmp): with no game running, the present reads the snapshot's RAM itself
// WOTM_LOCALPLAYER=<n> (1..8): the local player's view (n - 1; 4..7 = players 5..8, native chase camera, Snapshot::chase);
// -1 without it (all views, as the game composes them)
static int localView()
{
    static const int v = [] { const char *e = std::getenv("WOTM_LOCALPLAYER"); const int n = e ? std::atoi(e) : 0; return n >= 1 && n <= 8 ? n - 1 : -1; }();
    return v;
}

// Widescreen (Hor+): the vertical FOV is the game's and the width follows the aspect ratio. The Aspect option (WOTM_ASPECT=W:H,
// wotm_settings.hpp, live) fixes the ratio (4:3 = the original screen, with side bars); when dynamic, the ratio follows the window
// (between 4:3 and 32:9), which opens at 16:9.
static float fixedAspect() { return wotm::settings::aspectRatio(); }
static float viewAspect()
{
    if (g_force43)
        return 4.f / 3.f;
    if (const float a = fixedAspect())
        return a;
    const float sh = static_cast<float>(GetScreenHeight());
    return sh > 0.f ? std::clamp(static_cast<float>(GetScreenWidth()) / sh, 4.f / 3.f, 32.f / 9.f) : 4.f / 3.f;
}
// Native frame height in pixels (Res option, WOTM_RES=<lines>, default 720, live; the PS2 screen has 448, 224 per field; 0 = the
// height of the window or fullscreen, in pixels) times the scale (RenderScale option, WOTM_RENDERSCALE=<%>: above 100 is supersampling,
// and the present scales down with a bilinear filter); the width comes from the aspect ratio, capped at 16384. When it changes, drawing
// rebuilds the frame textures (wotmDrawNative, sizeOk). Replay (--vu1cmp) stays at 720, like the comparisons already recorded.
static int baseHeight()
{
    const int res = wotm::settings::get(wotm::settings::Res);
    if (res > 0)
        return res;
    const int h = GetRenderHeight();
    static int logged = -1;
    if (h != logged)
    {
        logged = h;
        std::fprintf(stderr, "[native] frame from the window: %d lines (window %dx%d, framebuffer %dx%d)\n", h, GetScreenWidth(), GetScreenHeight(),
                     GetRenderWidth(), h);
    }
    return h > 0 ? h : 720;
}
static float viewAspect();
static int renderHeight()
{
    if (g_force43)
        return 720;
    const int scale = std::clamp(wotm::settings::get(wotm::settings::RenderScale), 25, 400);
    const int h = static_cast<int>(std::lround(baseHeight() * (scale / 100.0)));
    return std::clamp(h, 112, std::min(8640, static_cast<int>(16384.f / viewAspect())));
}
// Once, on the first present (wotmDrawScene, before the intro): WOTM_FULLSCREEN=1|2 goes to borderless or exclusive fullscreen (monitor
// aspect ratio; with a fixed WOTM_ASPECT the frame gets bars); otherwise the runtime's 960x720 window becomes the native frame size
// (renderHeight at the aspect ratio), shrunk to fit the monitor. The frame doesn't depend on the window: only the final upscale changes.
// Present rate: WOTM_HZ=<n> (default: the window's monitor rate) with the monitor's vsync (WOTM_VSYNC=0 turns it off and limits by the
// clock only). Game logic stays at 60: the present only redraws the scene when a new frame arrives (wotmDrawNative, "redraw") and
// otherwise re-presents the last image. The gain: steady pacing (no beat between raylib's 60 and the monitor), no tearing.
// The runtime opened with a fixed SetTargetFPS(60) (ps2_runtime.cpp); here it is replaced on the first present.
// Rate and Vsync options (wotm_settings.hpp), live: applyVideoSettings calls this again when they change.
static void initPresentRate()
{
    const int mon = GetCurrentMonitor(), monHz = GetMonitorRefreshRate(mon);
    int hz = wotm::settings::get(wotm::settings::Rate);
    if (hz <= 0)
        hz = monHz > 0 ? monHz : 60;
    hz = std::clamp(hz, 30, 1000);
    const bool vsync = wotm::settings::on(wotm::settings::Vsync);
    if (vsync)
        SetWindowState(FLAG_VSYNC_HINT);
    else
        ClearWindowState(FLAG_VSYNC_HINT);
    // with vsync at the monitor rate the buffer swap does the pacing; below it the time limit divides (60 out of 180 = 1 in 3)
    SetTargetFPS(vsync && hz >= monHz ? 0 : hz);
    const int eff = vsync && monHz > 0 ? std::min(hz, monHz) : hz;
    wotm::settings::g_presentHz.store(eff, std::memory_order_relaxed);
    std::fprintf(stderr, "[native] present: %d Hz (monitor %d Hz), vsync %s (WOTM_HZ, WOTM_VSYNC)\n", eff, monHz, vsync ? "on" : "off");
}

// Window at the native frame size (renderHeight at the fixed aspect ratio, or 16:9), shrunk to fit in 90% of the monitor and centered.
static void fitWindow(bool keepHeight = false)
{
    const float a = fixedAspect() ? fixedAspect() : 16.f / 9.f;
    const int res = wotm::settings::get(wotm::settings::Res);   // 0 (the window's): 720, or the current height (keepHeight)
    float h = static_cast<float>(res > 0 ? res : keepHeight && GetScreenHeight() > 0 ? GetScreenHeight() : 720), w = h * a;
    const int mon = GetCurrentMonitor();
    const float mw = 0.9f * GetMonitorWidth(mon), mh = 0.9f * GetMonitorHeight(mon);
    if (mw > 0.f && mh > 0.f)
    {
        const float k = std::min({1.f, mw / w, mh / h});
        w *= k;
        h *= k;
    }
    SetWindowSize(static_cast<int>(std::lround(w)), static_cast<int>(std::lround(h)));
    if (mw > 0.f && mh > 0.f)
    {
        const Vector2 p = GetMonitorPosition(mon);
        SetWindowPosition(static_cast<int>(p.x + (mw / 0.9f - w) * 0.5f), static_cast<int>(p.y + (mh / 0.9f - h) * 0.5f));
    }
}

// Fullscreen kind (Display option, WOTM_FULLSCREEN): 1 = borderless (a monitor-sized window, the desktop doesn't change mode), 2 =
// exclusive (the monitor switches to the window's mode, at its native resolution). F11 toggles between the window and the chosen kind
// (with the option set to windowed: borderless); it doesn't change the option.
static int g_fullscreenKind = 1;

static bool inFullscreen()
{
    return IsWindowState(FLAG_BORDERLESS_WINDOWED_MODE) || IsWindowFullscreen();
}

// OBS capture in borderless fullscreen (WOTM_CAPTUREFIX, default 1). GLFW makes the borderless window with WS_POPUP and raylib sizes
// it exactly to the monitor: when focused, the driver (NVIDIA OpenGL) promotes the window to "fullscreen" and presents directly, outside
// DWM composition (independent flip). Unfocused, the image goes through DWM and OBS records it; focused, the new capture (Windows Graphics
// Capture) freezes on the last composited image and the old one (BitBlt) goes black. 1 = removes WS_POPUP (becomes WS_OVERLAPPED with no
// frame, as in the Processing/JOGL report); 2 = that plus the window 1 px taller than the monitor (the driver only promotes a window that
// covers the monitor exactly; the extra line is off screen); 0 = as raylib leaves it. No windows.h (it conflicts with raylib).
#ifdef _WIN32
extern "C" __declspec(dllimport) long long __stdcall GetWindowLongPtrW(void *hwnd, int index);
extern "C" __declspec(dllimport) long long __stdcall SetWindowLongPtrW(void *hwnd, int index, long long value);
extern "C" __declspec(dllimport) int __stdcall SetWindowPos(void *hwnd, void *after, int x, int y, int cx, int cy, unsigned flags);
static void captureFriendlyBorderless()
{
    const char *e = std::getenv("WOTM_CAPTUREFIX");
    const int mode = e && *e ? std::atoi(e) : 1;
    void *hwnd = GetWindowHandle();
    if (mode <= 0 || !hwnd)
        return;
    constexpr int kGwlStyle = -16;
    constexpr long long kWsPopup = 0x80000000LL;
    constexpr unsigned kSwpNoSize = 0x1, kSwpNoMove = 0x2, kSwpNoZorder = 0x4, kSwpNoActivate = 0x10, kSwpFrameChanged = 0x20;
    const long long style = GetWindowLongPtrW(hwnd, kGwlStyle);
    SetWindowLongPtrW(hwnd, kGwlStyle, style & ~kWsPopup);   // WS_OVERLAPPED = 0: without WS_CAPTION it still has no frame
    SetWindowPos(hwnd, nullptr, 0, 0, 0, 0, kSwpNoSize | kSwpNoMove | kSwpNoZorder | kSwpNoActivate | kSwpFrameChanged);
    if (mode >= 2)
    {
        const int mon = GetCurrentMonitor();
        const Vector2 p = GetMonitorPosition(mon);
        SetWindowPos(hwnd, nullptr, static_cast<int>(p.x), static_cast<int>(p.y), GetMonitorWidth(mon), GetMonitorHeight(mon) + 1,
                     kSwpNoZorder | kSwpNoActivate);
    }
    std::fprintf(stderr, "[native] borderless fullscreen: style 0x%llx -> 0x%llx%s (WOTM_CAPTUREFIX=%d, for OBS)\n",
                 static_cast<unsigned long long>(style), static_cast<unsigned long long>(style & ~kWsPopup), mode >= 2 ? ", +1 px tall" : "",
                 mode);
}
#else
static void captureFriendlyBorderless() {}   // the driver promotion and capture problem above is Windows-only (DWM)
#endif

// Fullscreen on the window's monitor (monitor aspect ratio; with a fixed WOTM_ASPECT the frame gets bars) or back to the window.
static void setFullscreen(bool on)
{
    if (on == inFullscreen())
        return;
    if (on && g_fullscreenKind == 2)
    {
        // raylib 5.5's ToggleFullscreen asks the monitor for a mode at the window's current size: so first the window becomes the native resolution
        const int mon = GetCurrentMonitor();
        SetWindowSize(GetMonitorWidth(mon), GetMonitorHeight(mon));
        ToggleFullscreen();
        return;
    }
    if (on)
    {
        ToggleBorderlessWindowed();
        ClearWindowState(FLAG_WINDOW_TOPMOST);   // raylib 5.5 keeps the borderless window always on top (GLFW_FLOATING)
        captureFriendlyBorderless();
#ifdef __APPLE__
        wotmMacHideMenuBarAndDock(true);
#endif
        return;
    }
    if (IsWindowFullscreen())
        ToggleFullscreen();   // comes back at the monitor's size
    else
    {
        ToggleBorderlessWindowed();
#ifdef __APPLE__
        wotmMacHideMenuBarAndDock(false);
#endif
    }
    fitWindow();   // raylib returns to the previous size, which is the runtime's 960x720 (or the monitor's) when the session opened fullscreen
}

// WOTM_MONITOR=<n>: the window (and fullscreen) goes to raylib monitor n; without it, the monitor the window opened on. Runs before
// anything that reads the current monitor (present rate, frame height, fullscreen). The monitors are logged so you can find the number.
static void moveToChosenMonitor()
{
    const char *e = std::getenv("WOTM_MONITOR");
    const int n = GetMonitorCount();
    for (int i = 0; i < n; ++i)
    {
        const Vector2 p = GetMonitorPosition(i);
        std::fprintf(stderr, "[native] monitor %d: %s %dx%d at %.0f,%.0f%s\n", i, GetMonitorName(i), GetMonitorWidth(i), GetMonitorHeight(i), p.x, p.y,
                     i == GetCurrentMonitor() ? " (current)" : "");
    }
    if (!e || !*e)
        return;
    const int m = std::atoi(e);
    if (m < 0 || m >= n)
    {
        std::fprintf(stderr, "[native] WOTM_MONITOR=%d ignored: there are %d monitor(s)\n", m, n);
        return;
    }
    const Vector2 p = GetMonitorPosition(m);
    SetWindowPosition(static_cast<int>(p.x) + 40, static_cast<int>(p.y) + 40);
    std::fprintf(stderr, "[native] window on monitor %d (WOTM_MONITOR)\n", m);
}
// Video options already applied to the window (the window thread compares them with the current ones on every present)
static int g_appliedVideo[wotm::settings::kKeys] = {};

static void initWindowAspect()
{
    static bool done = false;
    if (done)
        return;
    done = true;
    SetExitKey(KEY_NULL);   // raylib's Esc closed the game; closing is Alt+F4 or the window's X (Esc goes back in menus)
    for (int k = 0; k < wotm::settings::kKeys; ++k)
        g_appliedVideo[k] = wotm::settings::get(wotm::settings::Key(k));
    // PS2X_HOSTPROF_WIN=1 (with PS2X_HOSTPROF): the sampler watches this thread (the window's) instead of the EE's
    if (std::getenv("PS2X_HOSTPROF") && std::getenv("PS2X_HOSTPROF_WIN"))
        ::wotmHostProfWatchThisThread();
    if (!g_localCollect && !g_hideFps)   // replay (--vu1cmp): no real window, leave it as is
    {
        moveToChosenMonitor();
        initPresentRate();
    }
    const int disp = wotm::settings::get(wotm::settings::Display);
    if (disp == 2)
        g_fullscreenKind = 2;
    if (disp)
        setFullscreen(true);
    else
        fitWindow();
}

// Video options changed live ("recompiled options" panel, EE thread): applied here, on the window thread, on every present.
// Display: windowed, borderless or exclusive (switching kind goes through windowed); Rate/Vsync: the present pacing;
// Res/Aspect: the frame rebuilds itself on the next draw, and the window (outside fullscreen) goes back to the frame size.
static void applyVideoSettings()
{
    using namespace wotm::settings;
    if (g_localCollect || g_hideFps)
        return;
    int now[kKeys];
    for (int k = 0; k < kKeys; ++k)
        now[k] = get(Key(k));
    if (now[Display] != g_appliedVideo[Display])
    {
        if (inFullscreen())
            setFullscreen(false);
        g_fullscreenKind = now[Display] == 2 ? 2 : 1;
        if (now[Display])
            setFullscreen(true);
        std::fprintf(stderr, "[settings] screen: %s\n", now[Display] == 2 ? "exclusive fullscreen" : now[Display] ? "borderless fullscreen" : "windowed");
    }
    if (now[Rate] != g_appliedVideo[Rate] || now[Vsync] != g_appliedVideo[Vsync])
        initPresentRate();
    if (((now[Res] != g_appliedVideo[Res] && now[Res] > 0) || now[Aspect] != g_appliedVideo[Aspect]) && !inFullscreen())
        fitWindow(true);
    if (now[Res] != g_appliedVideo[Res] || now[Aspect] != g_appliedVideo[Aspect] || now[RenderScale] != g_appliedVideo[RenderScale])
        std::fprintf(stderr, "[settings] frame: %s lines x %d%% = %d, aspect %s\n", format(Res, now[Res]).c_str(), now[RenderScale], renderHeight(),
                     format(Aspect, now[Aspect]).c_str());
    if (now[Msaa] != g_appliedVideo[Msaa])
        std::fprintf(stderr, "[settings] MSAA: %d samples (the driver accepts up to %d)\n", now[Msaa], wotm::msaa::maxSamples());
    for (int k = 0; k < kKeys; ++k)
        g_appliedVideo[k] = now[k];
}

// F11 toggles between fullscreen and windowed (on every present, on the window thread; works in the menu, in movies and in fights).
// It changes the DISPLAY MODE option (and settings.ini), which applyVideoSettings applies: the panel and the file stay in sync.
// Fullscreen goes back to the last kind used (borderless or exclusive).
static void fullscreenKey()
{
    if (!g_localCollect && !g_hideFps && IsKeyPressed(KEY_F11))
    {
        namespace st = wotm::settings;
        st::set(st::Display, inFullscreen() ? 0 : g_fullscreenKind);
    }
    applyVideoSettings();
    if (!g_localCollect)
        wotm_pad::mouseFrame();   // mouse for the modern camera (wotm_mouse.hpp)
}

// Captures the game frame on the EE thread (wotmCaptureFrame, called by wotm_overrides.cpp on entry to
// timerWaitForMinUpdateRate, a point shared by rtMain, ShellRtLoop::endField and userintMain, and in the sceGsSyncV at the end of the
// displayDialog loop, the pause menu and friends, which don't go through it): there the frame is ready (update, hier,
// particleDraw, HUD) and the next one's logic hasn't started. The present runs on another thread; reading RAM at the moment it
// saw g_frame change, it sometimes caught the next frame half-built (the HUD's _cs out of place, shadow blocker not
// marked: HUD, reticle and shadow flickering).
struct Capture
{
    std::mutex m;
    wotm::Snapshot snap;   // latest captured frame, not yet consumed by the present
    bool fresh = false;
    void publish(wotm::Snapshot &&s)   // with m locked
    {
        snap = std::move(s);
        fresh = true;
    }
    void drop() { fresh = false; }   // with m locked
    std::atomic<bool> on{false};   // the present draws natively (turned on by the first call to wotmDrawNative)
    std::atomic<float> wide{1.f};  // the present's Scene::wide (particle visibility test)
};
static Capture &capture()
{
    static Capture c;
    return c;
}
// Frame interpolation (INTERPOLATE FRAMES option, WOTM_INTERP; NATIVO.md, "Taxa de apresentacao"): a clock shared by the
// two threads (Snapshot::hostT stamp) and the per-sphere culling margin, which the window turns on and the capture reads (Scene::cullMargin)
static double hostNow()
{
    return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
}
static std::atomic<bool> g_interpCull{false};
static constexpr double kFieldSec = 1.001 / 60.0;   // one NTSC field (the display clock follows the real cadence through the filter)
// replay with several files in one run: the next wotmDrawNative restarts the present from scratch (scene, resources, previous frame),
// like in a new process; without this a file inherited the previous one's state when the stage was the same
static bool g_replayFresh = false;
// replay: big-screen movie texture taken from the snapshot's VRAM (no player; wotm_vu1check.inc); 0 = none
static unsigned (*g_replayMovieTex)() = nullptr;
static State *g_state = nullptr;      // the present's (wotmDrawNative), for the photos (wotm_foto.inc)
// The last native frame drawn (the window's, without the FPS counter on top) to a PNG
static bool exportFrame(const char *path)
{
    if (!g_state || g_state->rts[g_state->cur].id == 0)
        return false;
    Image img = LoadImageFromTexture(g_state->rts[g_state->cur].texture);
    ImageFlipVertical(&img);
    const bool ok = ExportImage(img, path);
    UnloadImage(img);
    return ok;
}
// Loaded resources (level and monsters), as shown in the [native] resources log line
static std::string resources() { return g_state ? g_state->rtxPath : std::string(); }
// Fades of the frame being built (EE thread): the emitter hooks (wotm_overrides.cpp) read the freshly built packet;
// wotmCaptureFrame passes them to the snapshot. Shell::FadeScreen is its own loop (no timerWaitForMinUpdateRate, so no
// capture): while it runs, the present reads its packet live (the loop only rewrites the alpha); the next capture turns it off.
// Without a redraw (b = false), the loop paints the fade again over the same buffer every field (two alternating buffers): in the
// current buffer the screen has already taken alphas a - 2·step, a - 4·step... since the start, and the darkening accumulates
// (Scene::drawScreenRects gets the equivalent alpha). g_shellFade: -1 = stopped; otherwise start | step << 8 | accumulate << 16.
static std::vector<wotm::ScreenRect> g_pendingRects;
// Per pending fade: 0 = sent directly (uiFadeScreen), 1 = in the gsPkt queue, 2 = queue already dispatched (DmaGsPktQueue). In
// fontDmaFontData, the state-2 ones go under the text (ScreenRect::underText).
static std::vector<uint8_t> g_pendingState;
// ScreenPolys HUD since the last capture: one quad per polyBuildPrim (wotmScreenPoly, wotm::screenPolyFromCall); the capture
// passes it to the snapshot.
static std::vector<wotm::TextQuad> g_pendingPolys;
// Health and energy bars over enemies (WOTM_ENEMYBARS mod, wotmBarRect) since the last capture: they go at the start of the
// frame's rectangles (the fades draw on top).
static std::vector<wotm::ScreenRect> g_pendingBars;
// Health icons since the last capture (wotmHudAnchor): the world point and the screen center; g_barAnchor = the one for the icon whose
// bars are being emitted now (wotmBarRect/wotmBarTex store it in ScreenRect::anchor)
static std::vector<wotm::HudAnchor> g_pendingAnchors;
static int g_barAnchor = -1;
// colorQuad of the highlighted pick-ups as enableHighlights left it, before hier (Scene::csColorAtDraw); the capture passes them to the collection.
static std::vector<wotm::Scene::CsColorAtDraw> g_pendingCsColor;
static std::atomic<int> g_shellFade{-1};
// Rectangle and color of the Shell::FadeScreen in progress (wotmShellFade, on entry) and the alpha the loop wrote last (wotmShellFadeStep).
static std::mutex g_shellFadeM;
static wotm::ScreenRect g_shellFadeRect{};
static std::atomic<int> g_shellFadeA{0};
static int g_shellFadeStart = 0, g_shellFadeEnd = 0, g_shellFadeStep = 0, g_shellFadeDir = 1, g_shellFadeSteps = 0;   // EE thread
// Game text through the font hooks (wotm::FontText; EE thread). The text of the last fontDmaFontData goes to g_textSent, which the
// present reads on every draw (as it used to read fontPacket live: dialog loops that skip the capture also update it).
static wotm::FontText g_font;
static std::mutex g_textM;
static std::vector<wotm::TextQuad> g_textSent;   // guarded by g_textM
static std::atomic<bool> g_textHooked{false};    // some fontDmaFontData went through the hook
// Live text (hooks); false in replay (--vu1cmp: no game, the text comes from the snapshot's fontPacket) or before the first frame.
static bool liveText(std::vector<wotm::TextQuad> &out)
{
    if (g_localCollect || !g_textHooked.load(std::memory_order_relaxed))
        return false;
    std::lock_guard<std::mutex> lk(g_textM);
    out = g_textSent;
    return true;
}
// Stage load (Shell::LoadLevelFiles until rtMain is entered): on the PS2 the screen holds on the last frame of the LOAD card (the
// load bar is drawn straight into the frame, without hier) and Shell::FadeScreen without a redraw only darkens it. Native can't redraw
// the card in the meantime: RAM already has the new level, and loadResources swaps the textures for its own (the card came out with some
// random level texture, like the green power-up glow in CENTRAL). While it holds, the capture publishes nothing and the
// present repeats the last frame drawn, with the Shell::FadeScreen fade on top (wotmDrawFrozen).
static std::atomic<bool> g_loadFreeze{false};
// Moving average of one redraw's time in the present (ms, starting from 0): interpolation is suspended if it doesn't fit in the period
static double g_drawMs = 0.0;

// Shell::FadeScreen fade in progress (g_shellFade): the entry rectangle with the current step's alpha; when accumulating, the
// equivalent alpha in the current buffer.
static bool shellFadeRect(wotm::ScreenRect &r)
{
    const int sf = g_shellFade.load(std::memory_order_relaxed);
    if (sf < 0)
        return false;
    {
        std::lock_guard<std::mutex> lk(g_shellFadeM);
        r = g_shellFadeRect;
    }
    r.a = static_cast<uint8_t>(std::min(255, std::max(0, g_shellFadeA.load(std::memory_order_relaxed))));
    const int start = sf & 0xFF, step = (sf >> 8) & 0xFF;
    if ((sf >> 16) && step > 0)
    {
        float keep = 1.f;   // fraction of the scene left in the current buffer
        for (int a = r.a; a >= start; a -= 2 * step)
            keep *= 1.f - std::min(a, 0x80) / 128.f;
        r.a = static_cast<uint8_t>(std::lround((1.f - keep) * 0x80));
    }
    return true;
}
} // namespace wotm_live

void wotmLoadFreeze(bool on)
{
    wotm_live::g_loadFreeze.store(on, std::memory_order_relaxed);
    if (on)
    {   // snapshot not drawn yet: it reads RAM from before the load, but would be drawn after it
        wotm_live::Capture &c = wotm_live::capture();
        std::lock_guard<std::mutex> lk(c.m);
        c.drop();
    }
}

// Exit of LevelPickups::enableHighlights (EE thread): records the colorQuad of the _cs of each player's highlighted pick-up
// (the first 4 m_monsters; highlightList[monster+0x28] -> node -> Pickup -> cs +0xC). All at once because, in split screen, one
// player's call returns the other's pick-up at 1; the last value wins.
void wotmPickupHighlights(const uint8_t *rdram)
{
    if (!rdram)
        return;
    const wotm::Ram ram{rdram, PS2_RAM_SIZE};
    for (uint32_t j = 0; j < 4; ++j)
    {
        const uint32_t m = ram.u32(wotm::sym::shellGame + 0x120380 + 4 * j) & 0x1FFFFFFFu;   // m_monsters[j]
        if (!ram.ok(m, 0x2C))
            continue;
        const uint32_t idx = ram.u32(m + 0x28);
        if (idx >= 16)
            continue;
        const uint32_t node = ram.u32(wotm::sym::x_12LevelPickups_s_highlightPickup + 4 * idx) & 0x1FFFFFFFu;
        const uint32_t pk = ram.ok(node) ? ram.u32(node) & 0x1FFFFFFFu : 0;
        const uint32_t cs = ram.ok(pk, 0x10) ? ram.u32(pk + 0xC) & 0x1FFFFFFFu : 0;
        if (!ram.ok(cs, 0x80))
            continue;
        wotm::Scene::CsColorAtDraw c{cs, {ram.f32(cs + 0x70), ram.f32(cs + 0x74), ram.f32(cs + 0x78), ram.f32(cs + 0x7C)}};
        auto &v = wotm_live::g_pendingCsColor;
        auto it = std::find_if(v.begin(), v.end(), [&](const wotm::Scene::CsColorAtDraw &e) { return e.cs == cs; });
        if (it != v.end())
            *it = c;
        else if (v.size() < 8)
            v.push_back(c);
    }
}

namespace wotm_live
{
static void pushRect(const wotm::ScreenRect &r, uint8_t state)
{
    if (g_pendingRects.size() >= 16)
        return;
    g_pendingRects.push_back(r);
    g_pendingState.push_back(state);
}
}
// WOTM_LOCALPLAYER with several views: the local player's view rectangle goes to the whole screen; the other views' are left out
static bool viewRectToLocal(const wotm::Ram &ram, int view, wotm::ScreenRect &r)
{
    if (wotm_live::localView() < 0 || !wotm::readViewCtx(ram, 0).shared())
        return true;
    if (view != wotm_live::localView())
        return false;
    const wotm::ViewCtx vc = wotm::readViewCtx(ram, view);
    vc.toFull(r.x0, r.y0);
    vc.toFull(r.x1, r.y1);
    return true;
}
// Black fade of the whole view, from the emitter's arguments: rtFadeScreen(view, amount) and uiFadeScreen(amount) write alpha
// 0x80 - amount (32 bits); TheGame's fades, its level. queued: goes through the gsPkt queue (AddCallToQueue), otherwise sent directly.
void wotmFadeView(const uint8_t *rdram, int view, uint32_t alpha, bool queued)
{
    wotm::ScreenRect r{};
    if (rdram && wotm::viewFadeRect(wotm::Ram{rdram, PS2_RAM_SIZE}, view, 0, 0, 0, alpha, r) &&
        viewRectToLocal(wotm::Ram{rdram, PS2_RAM_SIZE}, view, r))
        wotm_live::pushRect(r, queued ? 1 : 0);
}
// The 3-MILE power plant flash (threeMileDrawFlash, called by threeMileUpdateCountDown and threeMileUpdateTransition): white SPRITE
// over the current view (viewCurView), ALPHA_1 0x44, alpha = threeMileFlashAlpha (0x80 = 1.0), through the gsPkt queue. Read on entry:
// the packet carries the alpha from before the update that comes after the call.
void wotmThreeMileFlash(const uint8_t *rdram)
{
    if (!rdram)
        return;
    const wotm::Ram ram{rdram, PS2_RAM_SIZE};
    const uint32_t a = ram.u32(wotm::sym::threeMileFlashAlpha);
    wotm::ScreenRect r{};
    const int view = int32_t(ram.u32(wotm::sym::viewCurView));
    if (a && wotm::viewFadeRect(ram, view, 0xFF, 0xFF, 0xFF, a, r) && viewRectToLocal(ram, view, r))
        wotm_live::pushRect(r, 1);
}
// Exit of TheGame::updateFadeOut / updateFadeOutAndIn: the fade level (+0x120450, already updated) in each view; from view 1
// onward only with no movie and no unified view, like their loop.
void wotmTheGameFade(const uint8_t *rdram, uint32_t self)
{
    if (!rdram)
        return;
    const wotm::Ram ram{rdram, PS2_RAM_SIZE};
    self &= 0x1FFFFFFFu;
    const uint32_t g = ram.u32(wotm::sym::game) & 0x1FFFFFFFu;
    if (!ram.ok(self + 0x120450) || !ram.ok(g + 0x1203D8))
        return;
    const uint32_t level = ram.u32(self + 0x120450);
    const int views = int32_t(ram.u32(g + 0x1203D8));
    // with quadrants (3 and 4 players) the cutscene shows in every view (wotm_split4.inc), so the fade does too
    const bool quad = wotm::readViewCtx(ram, 0).h < 224.f;
    for (int v = 0; v < views && v < 5;)
    {
        wotmFadeView(rdram, v, level, true);
        if (++v >= views || (ram.u32(wotm::sym::moviePlaying) != 0 && !quad) || ram.u32(wotm::sym::gUseUnifiedView) != 0)
            break;
    }
}
// Menu letterbox bars (letterboxDmaData(alpha), sent by userintMain between hier(0,0) and hier(0,1)): two black SPRITEs of 24
// lines at the top and bottom of view 0, alpha fptoui(alpha * 128), no A+D (ALPHA_1 in effect). They go with the fades emitted before
// the text and the high-priority list (underText); they span the view's width, so in widescreen they go edge to edge of the window.
void wotmLetterbox(const uint8_t *rdram, float alpha)
{
    int cx, cy, w, h;
    if (!rdram || !wotm::viewGeom(wotm::Ram{rdram, PS2_RAM_SIZE}, 0, cx, cy, w, h))
        return;
    const float a = alpha * 128.f;
    const uint32_t ai = a > 0.f ? static_cast<uint32_t>(a) : 0u;
    const int x0 = cx - (w >> 1), top = cy - (h >> 1), bottom = cy + (h >> 1);
    wotm::ScreenRect r[2] = {wotm::fadeRect(x0, top, x0 + w, top + 24, 0, 0, 0, ai), wotm::fadeRect(x0, bottom - 24, x0 + w, bottom, 0, 0, 0, ai)};
    for (wotm::ScreenRect &x : r)
    {
        x.underText = true;
        wotm_live::pushRect(x, 3);   // already decided
    }
}
void wotmGsPktQueueSent()
{
    for (uint8_t &s : wotm_live::g_pendingState)
        if (s == 1) s = 2;
}
void wotmFontSent()
{
    for (size_t i = 0; i < wotm_live::g_pendingRects.size(); ++i)
        if (wotm_live::g_pendingState[i] == 2)
        {
            wotm_live::g_pendingRects[i].underText = true;
            wotm_live::g_pendingState[i] = 3;   // already decided
        }
}
void wotmFontInitPacket(uint32_t vram) { wotm_live::g_font.initPacket(vram); }
void wotmFontSetTexId(const uint8_t *rdram, uint32_t node)
{
    if (!rdram) return;
    wotm_live::g_font.setTexId(wotm::Ram{rdram, PS2_RAM_SIZE}, node);
    // font atlas for the training panel, which uses it with no game text in the frame (the fight writes nothing)
    if (wotm_training::g_fontTex0.exchange(wotm_live::g_font.tex0) != wotm_live::g_font.tex0)
        std::fprintf(stderr, "[training] font atlas %016llX\n", static_cast<unsigned long long>(wotm_live::g_font.tex0));
}
void wotmFontColor(const uint8_t *rdram, int font)
{
    if (rdram) wotm_live::g_font.setColor(wotm::Ram{rdram, PS2_RAM_SIZE}, font);
}
static int g_lastFontIdx = 0;   // font of the game's last glyph (in a fight, the "WINS" one): the one for the damage numbers
void wotmFontGlyph(const uint8_t *rdram, int font, int ch)
{
    if (rdram) wotm_live::g_font.glyph(wotm::Ram{rdram, PS2_RAM_SIZE}, font, ch);
    if (font == 0 || font == 1) g_lastFontIdx = font;
}
// Split screen: rtMain sends each view's text in its own fontDmaFontData (view 0, then 1, and 2 and 3 with 3 and 4 players). What is
// published is all of them together: view 0 goes out with the others' latest text (one frame behind until each sends its own), so the
// present never catches only part of the HUD. A view that hasn't sent text since the previous view 0 (dialog: only 0) gets none.
void wotmFontDma(const uint8_t *rdram)
{
    std::vector<wotm::TextQuad> q;
    if (!rdram || !wotm_live::g_font.sent(wotm::Ram{rdram, PS2_RAM_SIZE}, q))
        return;
    static std::vector<wotm::TextQuad> text[4];   // latest text of each view (split screen)
    static unsigned sentSince0 = 0;               // bits: views that sent text since view 0's last
    const wotm::Ram ram{rdram, PS2_RAM_SIZE};
    const uint32_t view = ram.u32(wotm::sym::viewCurView);
    // WOTM_LOCALPLAYER (each player on their own PC): only the text of the local player's view, moved from their view to the whole
    // screen (the present shows only that view); players 5..8 have no game view, so no text. The pause dialog and cutscenes use the
    // whole screen (full view 0) and pass through as they are.
    if (const int local = wotm_live::localView(); local >= 0 && view < 4 && wotm::readViewCtx(ram, 0).shared())
    {
        const wotm::ViewCtx vc = wotm::readViewCtx(ram, int(view));
        for (wotm::TextQuad &t : q)
        {
            vc.textToFull(t.x0, t.y0);
            vc.textToFull(t.x1, t.y1);
        }
        text[view] = std::move(q);
        q = local < 4 ? text[local] : std::vector<wotm::TextQuad>{};
        std::lock_guard<std::mutex> lk(wotm_live::g_textM);
        wotm_live::g_textSent.swap(q);
        wotm_live::g_textHooked.store(true, std::memory_order_relaxed);
        return;
    }
    // Quadrants (3 and 4 players): the Hud lays out text as in a 224-line view, starting at the quadrant's top (the font adds the
    // view origin). What falls in the bottom half of that view (the "WINS" at y 200) moves up 224 - h, to the bottom of its own
    // quadrant, without resizing. Only when the other views also send text (the rtMain loop): the pause dialog comes only through
    // view 0, with the whole screen.
    static const bool splitLog = std::getenv("WOTM_SPLITLOG") != nullptr;
    static unsigned textLogN = 0;
    if (splitLog && view < 4 && ++textLogN % 240 < 4)
        std::fprintf(stderr, "[split] text view %u: %zu glyphs\n", view, q.size());
    static bool multi = false;
    if (view == 0)
        multi = (sentSince0 & ~1u) != 0;
    else if (view < 4)
        multi = true;
    if (multi && view < 4)
        if (const wotm::ViewCtx vc = wotm::readViewCtx(ram, int(view)); vc.h < 224.f)
        {
            const float top = vc.cy - 2048.f + 112.f - 0.5f * vc.h;
            float lowX = 1e9f;   // x of the bottom-half text (the "WINS"), for the log
            for (wotm::TextQuad &t : q)
                if (std::min(t.y0, t.y1) - top >= vc.h)
                {
                    t.y0 -= 224.f - vc.h;
                    t.y1 -= 224.f - vc.h;
                    lowX = std::min(lowX, std::min(t.x0, t.x1));
                }
            static float lastLowX[4] = {-1.f, -1.f, -1.f, -1.f};
            if (splitLog && lowX < 1e9f && lowX != lastLowX[view])
            {
                std::fprintf(stderr, "[split] wins view %u: x %.1f (before %.1f)\n", view, lowX, lastLowX[view]);
                lastLowX[view] = lowX;
            }
        }
    if (!wotm::readViewCtx(ram, 0).full() && view < 4)
    {
        if (view == 0)
        {
            for (int v = 1; v < 4; ++v)
                if (!(sentSince0 & (1u << v)))
                    text[v].clear();
            sentSince0 = 0;
        }
        sentSince0 |= 1u << view;
        text[view] = q;
        q = text[0];
        for (int v = 1; v < 4; ++v)
            q.insert(q.end(), text[v].begin(), text[v].end());
    }
    else
    {
        for (auto &t : text)
            t.clear();
    }
    std::lock_guard<std::mutex> lk(wotm_live::g_textM);
    wotm_live::g_textSent.swap(q);
    wotm_live::g_textHooked.store(true, std::memory_order_relaxed);
}
void wotmScreenPoly(const uint8_t *rdram, int src, int x, int y, uint32_t pd)
{
    wotm::TextQuad t;
    if (!rdram || wotm_live::g_pendingPolys.size() >= 256 || !wotm::screenPolyFromCall(wotm::Ram{rdram, PS2_RAM_SIZE}, src, x, y, pd, t))
        return;
    const wotm::Ram ram{rdram, PS2_RAM_SIZE};
    // WOTM_LOCALPLAYER: only the quad of the local player's view (the one building it), at its place on the whole screen (wotmFontDma
    // does the same with the text)
    if (wotm_live::localView() >= 0 && wotm::readViewCtx(ram, 0).shared())
    {
        const uint32_t view = std::min(ram.u32(wotm::sym::viewCurView), 3u);
        if (static_cast<int>(view) != wotm_live::localView())
            return;
        wotm::readViewCtx(ram, static_cast<int>(view)).boxToFull(t.x0, t.y0, t.x1, t.y1);
    }
    wotm_live::g_pendingPolys.push_back(t);
}
static float g_iconCx = 0.f, g_iconCy = 0.f;   // center of the last measured icon (wotmScreenPolyBox): the bars are attached to it
// Box (x0, y0, x1, y1, game screen 640 x 224) of the quad addPoly(src, x, y, pd) would build, without building it
bool wotmScreenPolyBox(const uint8_t *rdram, int src, int x, int y, uint32_t pd, float box[4])
{
    wotm::TextQuad t;
    if (!rdram || !wotm::screenPolyFromCall(wotm::Ram{rdram, PS2_RAM_SIZE}, src, x, y, pd, t))
        return false;
    box[0] = std::min(t.x0, t.x1);
    box[1] = std::min(t.y0, t.y1);
    box[2] = std::max(t.x0, t.x1);
    box[3] = std::max(t.y0, t.y1);
    g_iconCx = 0.5f * (box[0] + box[2]);
    g_iconCy = 0.5f * (box[1] + box[3]);
    return true;
}
static int g_barView = 0;         // view of the bar being built (wotmHealthIconShift, wotmBarView)
static wotm::ViewCtx g_barVctx;   // and its geometry (game views 0..3; wotmHealthIconShift)
void wotmBarView(int view)
{
    g_barView = std::clamp(view, 0, 7);
    g_barVctx = wotm::ViewCtx{};
}
// WOTM_LOCALPLAYER: the local player's view bar moves with its icon to the icon's place on the whole screen, at the same size
static void barToLocal(float &x0, float &y0, float &x1, float &y1)
{
    if (g_barView < 4 && g_barView == wotm_live::localView())
    {
        float cx = g_iconCx, cy = g_iconCy;
        g_barVctx.toFull(cx, cy);
        x0 += cx - g_iconCx;
        x1 += cx - g_iconCx;
        y0 += cy - g_iconCy;
        y1 += cy - g_iconCy;
    }
}
// Cap on bar rectangles per frame: ~25 per enemy (frame, cells, portrait, strips) and up to 3 enemies per view; with the 4
// quadrant views the previous 512 ran out before view 3, which was left without bars
constexpr size_t kMaxPendingBars = 2048;
void wotmBarRect(float x0, float y0, float x1, float y1, uint8_t r, uint8_t g, uint8_t b, uint8_t a)
{
    barToLocal(x0, y0, x1, y1);
    if (wotm_live::g_pendingBars.size() < kMaxPendingBars)
    {
        wotm::ScreenRect s{x0, y0, x1, y1, r, g, b, a, false, static_cast<int8_t>(g_barView)};
        s.anchor = static_cast<int16_t>(wotm_live::g_barAnchor);
        wotm_live::g_pendingBars.push_back(s);
    }
}
// Health icon over a monster (EE thread, Hud::drawHealthIcon hook): projected world point (world, nullptr = none) and
// icon center on the game screen. With bars, the bars emitted next carry the index (until wotmHudAnchor(..., false) again).
void wotmHudAnchor(const uint8_t *rdram, float cx, float cy, const float *world, bool bars)
{
    wotm_live::g_barAnchor = -1;
    if (!world || !std::isfinite(world[0]) || !std::isfinite(world[1]) || !std::isfinite(world[2]) || wotm_live::g_pendingAnchors.size() >= 64)
        return;
    wotm::HudAnchor h;
    h.x = cx;
    h.y = cy;
    for (int i = 0; i < 3; ++i) h.w[i] = world[i];
    h.view = static_cast<int8_t>(std::min<uint32_t>(wotm::Ram{rdram, PS2_RAM_SIZE}.u32(wotm::sym::viewCurView), 3u));
    if (bars) wotm_live::g_barAnchor = static_cast<int>(wotm_live::g_pendingAnchors.size());
    wotm_live::g_pendingAnchors.push_back(h);
}
void wotmHudAnchorEnd() { wotm_live::g_barAnchor = -1; }
// Rectangle with a resident .RTX texture (enemy portrait): the image's tex0 and the (u0, v0)-(u1, v1) region in texels
void wotmBarTex(float x0, float y0, float x1, float y1, uint64_t tex0, float u0, float v0, float u1, float v1)
{
    barToLocal(x0, y0, x1, y1);
    if (wotm_live::g_pendingBars.size() < kMaxPendingBars)
    {
        wotm::ScreenRect s{x0, y0, x1, y1, 255, 255, 255, 0x80, false, static_cast<int8_t>(g_barView)};   // white tint, opaque
        s.anchor = static_cast<int16_t>(wotm_live::g_barAnchor);
        s.tex0 = tex0;
        s.u0 = u0;
        s.v0 = v0;
        s.u1 = u1;
        s.v1 = v1;
        wotm_live::g_pendingBars.push_back(s);
    }
}
// Bars over the enemy: Hud::drawHealthIcon clamps the projected x (rx, GS pixels) between center - w/2 + 8 and center + w/2 - 16 of
// the view, its 4:3 width; in widescreen the bar stopped short of the edge (photos 2026-10-19_132149). Returns how much x changes
// with the same limit at the window's width (w/2 * wide) and records the current view for the rectangles that follow.
// Window width over the game's 4:3 screen width (1 at 4:3; ~1.33 at 16:9)
float wotmScreenWide()
{
    return std::max(1.f, wotm_live::capture().wide.load(std::memory_order_relaxed));
}
float wotmHealthIconShift(const uint8_t *rdram, float rx)
{
    const wotm::Ram ram{rdram, PS2_RAM_SIZE};
    g_barView = static_cast<int>(std::min<uint32_t>(ram.u32(wotm::sym::viewCurView), 3u));
    const wotm::ViewCtx vc = wotm::readViewCtx(ram, g_barView);
    g_barVctx = vc;
    const float wide = std::max(1.f, wotm_live::capture().wide.load(std::memory_order_relaxed));
    if (!std::isfinite(rx)) return 0.f;
    const int x = static_cast<int>(rx > 0.f ? rx + 0.5f : rx - 0.5f);
    auto clampTo = [&](float hw) {
        const int lo = static_cast<int>(vc.cx - hw + 8.f), hi = static_cast<int>(vc.cx + hw - 16.f);
        return x < lo ? lo : (hi < x ? hi : x);
    };
    return static_cast<float>(clampTo(0.5f * vc.w * wide) - clampTo(0.5f * vc.w));
}
// Entry of Shell::FadeScreen(view, redraw, ..., r, g, b, start, end, step): the loop writes start, start +/- step... until it
// reaches end, one value per sceGsSyncV (wotmShellFadeStep); start == end draws nothing.
void wotmShellFade(const uint8_t *rdram, int view, uint32_t r, uint32_t g, uint32_t b, int start, int end, int step, bool redraw)
{
    wotm::ScreenRect rc{};
    if (!rdram || start == end || !wotm::viewFadeRect(wotm::Ram{rdram, PS2_RAM_SIZE}, view, r & 0xFF, g & 0xFF, b & 0xFF, 0, rc))
    {
        wotm_live::g_shellFade.store(-1, std::memory_order_relaxed);
        return;
    }
    {
        std::lock_guard<std::mutex> lk(wotm_live::g_shellFadeM);
        wotm_live::g_shellFadeRect = rc;
    }
    wotm_live::g_shellFadeStart = start;
    wotm_live::g_shellFadeEnd = end;
    wotm_live::g_shellFadeStep = step;
    wotm_live::g_shellFadeDir = start < end ? 1 : -1;
    wotm_live::g_shellFadeSteps = 0;
    wotm_live::g_shellFadeA.store(start, std::memory_order_relaxed);
    const bool accumulate = !redraw && start < end;   // no redraw, going up: accumulates
    wotm_live::g_shellFade.store((start & 0xFF) | ((step & 0xFF) << 8) | (accumulate ? 1 << 16 : 0), std::memory_order_relaxed);
}
// Entry of the k-th sceGsSyncV of the Shell::FadeScreen loop (k starting at 0): the alpha on screen is what the loop just wrote,
// start +/- step * k; the next one is only written on the way back around.
void wotmShellFadeStep()
{
    using namespace wotm_live;
    g_shellFadeA.store(g_shellFadeStart + g_shellFadeDir * g_shellFadeStep * g_shellFadeSteps, std::memory_order_relaxed);
    ++g_shellFadeSteps;
}
// Return from that sceGsSyncV: if the loop continues, it writes the next value right away.
void wotmShellFadeStepDone()
{
    using namespace wotm_live;
    const int next = g_shellFadeStart + g_shellFadeDir * g_shellFadeStep * g_shellFadeSteps;
    if (g_shellFadeDir > 0 ? next < g_shellFadeEnd : next > g_shellFadeEnd)
        g_shellFadeA.store(next, std::memory_order_relaxed);
}

// The scene (objects, sky, HUD, high-priority list, shadows, light, camera and palettes) is collected at the exit of hier(0, 0)
// (wotmCaptureScene, wotm_overrides.cpp hook): the PS2 draws the objects with the traversal state, and the gameUpdate and
// animationRunGlobal that follow already leave the next frame's monsters, palettes and camera in RAM. Collecting everything at the end
// of the frame, the mesh came out one frame ahead of the eye lights (lens flare, whose list hier builds) and of the PS2 itself. Particles,
// flares, text and fades are still taken at the end of the frame (wotmCaptureFrame): the PS2's particleDraw comes after gameUpdate.
// Split screen (two players, viewToggleSplitScreen: views 0 and 1 side by side, 320 x 224 each): rtMain runs hier(v, 0) for
// each view in the same frame (view 1 already with view 0's gameUpdate applied). Each is taken at the exit of its hier, with its own
// camera, culling and sky (Scene::vctx); views 1 to 3 ride in view 0's snapshot (Snapshot::views). With 3 and 4 players (wotm_split4.inc)
// there are 3 or 4 views in 320 x 112 quadrants. In a grapple (gUseUnifiedView) view 0 becomes fullscreen again (viewGrappleConfig,
// viewport 5) and the present goes back to a single view.
namespace wotm_live
{
constexpr int kMaxViews = 4;
static wotm::Scene &captureScene(int view = 0)
{
    static wotm::Scene cap[kMaxViews];   // collection only (RAM -> items); textures and meshes stay with the present's Scene
    return cap[std::clamp(view, 0, kMaxViews - 1)];
}
// Players 5..8 on their own PC (localView 4..7): the game has 4 cameras and they are simulation state, so their view is a native
// chase camera, drawing only: behind the monster (forward = row 1 of the _cs matrix, on the ground plane) and well above it, looking at
// 60 above it (~55 degrees down; the game's camera follows at 300..450). Without the game's camera collision (querying it during capture
// would risk determinism), the height keeps it out of buildings. Position and target ease toward the desired ones per game frame
// (interpolation smooths between frames); a jump over 1500 (respawn) snaps. Its scene skips game-view culling (chaseScene).
constexpr float kChaseBack = 260.f, kChaseUp = 380.f;
static wotm::Scene &chaseScene()
{
    static wotm::Scene s;   // collection only, like captureScene
    return s;
}
static wotm::GameCamera chaseCamera(const wotm::Ram &ram, uint32_t monster, float fovy)
{
    static bool init = false;
    static float pos[3], look[3], dir[2] = {0.f, 1.f};
    wotm::GameCamera c;
    const uint32_t cs = ram.u32(monster + 0xC);   // Monster::m_cs
    if (!ram.ok(cs, 0x60))
        return c;
    float p[3];
    for (int i = 0; i < 3; ++i)
        p[i] = ram.f32(cs + 0x10 + 4u * uint32_t(i));   // _cs::trans
    const float fx = ram.f32(cs + 0x30), fy = ram.f32(cs + 0x34), fn = std::sqrt(fx * fx + fy * fy);   // _cs::mat row 1 (forward)
    if (fn > 1e-3f)
        dir[0] = fx / fn, dir[1] = fy / fn;
    const float want[3] = {p[0] - dir[0] * kChaseBack, p[1] - dir[1] * kChaseBack, p[2] + kChaseUp}, wantLook[3] = {p[0], p[1], p[2] + 60.f};
    const float jx = want[0] - pos[0], jy = want[1] - pos[1], jz = want[2] - pos[2];
    if (!init || jx * jx + jy * jy + jz * jz > 1500.f * 1500.f)
    {
        std::memcpy(pos, want, sizeof pos);
        std::memcpy(look, wantLook, sizeof look);
        init = true;
    }
    for (int i = 0; i < 3; ++i)
    {
        pos[i] += (want[i] - pos[i]) * 0.2f;
        look[i] += (wantLook[i] - look[i]) * 0.4f;
    }
    float f[3] = {look[0] - pos[0], look[1] - pos[1], look[2] - pos[2]};
    const float n = std::sqrt(f[0] * f[0] + f[1] * f[1] + f[2] * f[2]);
    if (!(n > 1e-3f))
        return c;
    for (int i = 0; i < 3; ++i)
    {
        c.pos[i] = pos[i];
        c.fwd[i] = f[i] / n;
    }
    // up = Z minus its component along forward
    c.up[0] = -c.fwd[2] * c.fwd[0];
    c.up[1] = -c.fwd[2] * c.fwd[1];
    c.up[2] = 1.f - c.fwd[2] * c.fwd[2];
    const float un = std::sqrt(c.up[0] * c.up[0] + c.up[1] * c.up[1] + c.up[2] * c.up[2]);
    for (float &u : c.up)
        u /= un;
    c.fovy = fovy;
    c.ok = true;
    return c;
}
static wotm::Snapshot g_sceneSnap[kMaxViews];   // scene from the last hier(v, 0), not yet published (EE thread)
static bool g_sceneFresh[kMaxViews] = {};
}

void wotmCaptureScene(const uint8_t *rdram, int view)
{
    wotm_live::Capture &c = wotm_live::capture();
    if (!rdram || !c.on.load(std::memory_order_relaxed) || view < 0 || view >= wotm_live::kMaxViews)
        return;
    const wotm::Ram ram{rdram, PS2_RAM_SIZE};
    const uint32_t wc = ram.u32(wotm::addr::world);
    if (!ram.ok(wc, 0x40) || !ram.ok(ram.u32(wc)))
        return;
    wotm::Scene &cap = wotm_live::captureScene(view);
    cap.wide = c.wide.load(std::memory_order_relaxed);
    cap.vctx = wotm::readViewCtx(ram, view);
    static const bool splitLog = std::getenv("WOTM_SPLITLOG") != nullptr;   // diagnostics: the captured view and its geometry
    if (splitLog)
    {
        const wotm::GameCamera gc = wotm::readGameCamera(ram, view);
        std::fprintf(stderr, "[split] g=%u view %d: def %08x viewport %d center %.0f,%.0f size %.0fx%.0f views=%u unified=%u camera %d at %.0f,%.0f,%.0f fovy %.1f\n",
                     ram.u32(wotm::sym::g_frame), view, ram.u32(wotm::addr::viewInfo + 0x14u * uint32_t(view) + 4),
                     static_cast<int32_t>(ram.u32(wotm::addr::viewInfo + 0x14u * uint32_t(view) + 8)), cap.vctx.cx, cap.vctx.cy, cap.vctx.w,
                     cap.vctx.h, ram.u32(wotm::sym::viewNumViews), ram.u32(wotm::sym::gUseUnifiedView), gc.ok, gc.pos[0], gc.pos[1], gc.pos[2],
                     gc.fovy);
    }
    cap.csColorAtDraw = wotm_live::g_pendingCsColor;   // pick-up tint written by this frame's enableHighlights (same as RAM now)
    cap.cullMargin = wotm_live::g_interpCull.load(std::memory_order_relaxed) ? 1.2f : 1.f;
    cap.collect(ram);
    wotm_live::g_sceneSnap[view] = cap.takeSnapshot(ram, ram.u32(wotm::sym::g_frame));
    wotm_live::g_sceneFresh[view] = true;
}

// A Shell::FadeScreen step with redraw (b = true: hier(0, 0) and sceGsSyncV per step, no timerWaitForMinUpdateRate): publishes that
// hier's scene without turning off the fade (g_shellFade, which the present draws on top). Without this the loading screen fade-in
// (DisplayLoadBackground) went by with no native frame and the LOAD card only appeared once already bright.
void wotmCaptureFadeStep(const uint8_t *rdram)
{
    if (!wotm_live::g_sceneFresh[0] || wotm_live::g_loadFreeze.load(std::memory_order_relaxed))
        return;
    for (bool &f : wotm_live::g_sceneFresh)
        f = false;
    wotm_live::Capture &c = wotm_live::capture();
    if (!rdram || !c.on.load(std::memory_order_relaxed))
        return;
    wotm::Snapshot sn = std::move(wotm_live::g_sceneSnap[0]);
    sn.fx.clear();
    sn.sprites.clear();
    sn.flares = {};
    sn.screenRects.clear();
    sn.screenPolys.clear();
    sn.g = wotm::Ram{rdram, PS2_RAM_SIZE}.u32(wotm::sym::g_frame);
    sn.fields = wotm::Ram{rdram, PS2_RAM_SIZE}.u32(wotm::addr::fieldsAtFrameStart);
    sn.hostT = wotm_live::hostNow();
    std::lock_guard<std::mutex> lk(c.m);
    c.publish(std::move(sn));
}

void wotmMainMenuLogoFrame(uint8_t *rdram);   // wotm_mainmenu.inc: big-screen logo only on "press start"
void wotmCaptureFrame(const uint8_t *rdram)
{
    wotmMainMenuLogoFrame(const_cast<uint8_t *>(rdram));   // before collection: the frame already comes out without the logo
    // the lens flare copy is valid only for this frame: the next one without particleDraw (menu, LOAD) has no flares
    struct ConsumeFlares { ~ConsumeFlares() { wotm::Particles::consumeFlares(); } } consumeFlares;
    wotm_live::Capture &c = wotm_live::capture();
    std::vector<wotm::ScreenRect> rects;
    rects.swap(wotm_live::g_pendingBars);
    rects.insert(rects.end(), wotm_live::g_pendingRects.begin(), wotm_live::g_pendingRects.end());
    wotm_live::g_pendingRects.clear();
    wotm_live::g_pendingState.clear();
    std::vector<wotm::TextQuad> polys;
    polys.swap(wotm_live::g_pendingPolys);
    std::vector<wotm::HudAnchor> anchors;
    anchors.swap(wotm_live::g_pendingAnchors);
    std::vector<wotm::Scene::CsColorAtDraw> csColor;
    csColor.swap(wotm_live::g_pendingCsColor);
    wotm_live::g_shellFade.store(-1, std::memory_order_relaxed);
    const bool haveScene = wotm_live::g_sceneFresh[0];
    bool haveView[wotm_live::kMaxViews] = {};   // views 1 to 3 of this frame (split screen)
    for (int v = 1; v < wotm_live::kMaxViews; ++v)
        haveView[v] = haveScene && wotm_live::g_sceneFresh[v];
    for (bool &f : wotm_live::g_sceneFresh)
        f = false;
    if (!rdram || !c.on.load(std::memory_order_relaxed) || wotm_live::g_loadFreeze.load(std::memory_order_relaxed))
        return;
    const wotm::Ram ram{rdram, PS2_RAM_SIZE};
    const uint32_t wc = ram.u32(wotm::addr::world);
    if (!ram.ok(wc, 0x40) || !ram.ok(ram.u32(wc)))
        return;
    wotm::Scene &cap = wotm_live::captureScene();
    cap.wide = c.wide.load(std::memory_order_relaxed);
    wotm::Snapshot sn;
    std::vector<wotm::FxSystem> fxAll;   // systems from every view (a single shadow copy)
    bool multi = false;                  // the snapshot carries other views (Snapshot::views)
    if (haveScene) {   // scene from this frame's hier(0, 0); particles from now
        sn = std::move(wotm_live::g_sceneSnap[0]);
        cap.vctx = sn.vctx;
        cap.collectFx(ram);
        sn.fx = cap.fx.systems;
        sn.flares = cap.fx.flares;
        sn.sprites = cap.sprites;
        sn.screenPolys.clear();   // the frame's quads arrive through the polyBuildPrim hook (polys)
        sn.g = ram.u32(wotm::sym::g_frame);
        fxAll = sn.fx;
        for (int v = 1; v < wotm_live::kMaxViews; ++v) {   // split screen, quadrants, one view per player: particles culled per view
            if (!haveView[v] || !sn.vctx.shared())
                continue;
            auto vs = std::make_shared<wotm::Snapshot>(std::move(wotm_live::g_sceneSnap[v]));
            wotm::Scene &capv = wotm_live::captureScene(v);
            capv.wide = cap.wide;
            capv.vctx = vs->vctx;
            capv.collectFx(ram);
            vs->fx = capv.fx.systems;
            vs->flares = capv.fx.flares;
            vs->sprites = capv.sprites;
            vs->screenPolys.clear();
            vs->screenRects.clear();
            vs->g = sn.g;
            for (const wotm::FxSystem &s : vs->fx)
                if (std::none_of(fxAll.begin(), fxAll.end(), [&](const wotm::FxSystem &e) { return e.base == s.base; }))
                    fxAll.push_back(s);
            sn.views[v - 1] = std::move(vs);
            multi = true;
        }
    } else {   // frame without hier(0, 0) (movie, load): everything from now
        cap.csColorAtDraw = std::move(csColor);
        cap.vctx = wotm::readViewCtx(ram, 0);
        cap.collect(ram);
        sn = cap.takeSnapshot(ram, ram.u32(wotm::sym::g_frame));
        sn.screenPolys.clear();   // same (takeSnapshot reads s_polyBuffer, which is for replay)
    }
    // particle positions, ages and packets at this instant: the present draws later, with the next particleMove already
    // running (snapshot count with live data = the packet terminator read as a particle; 09_magmo_impacto.md)
    // split screen and quadrants: each view's matrix in the previous particleDraw (viewPrevMat already has this frame's; the earlier one
    // is kept here)
    // players 5..8: the whole scene (without the game views' culling) with the chase camera; its particles go into the shadow copy
    // and project with view 0's matrix swapped for the chase camera's (Snapshot::fxCam, Scene::aimFxRam)
    if (haveScene && wotm_live::localView() >= 4)
    {
        const int k = wotm_live::localView() - 4;
        const uint32_t m = ram.u32(wotm::sym::shellGame + 0x120380u + 4u * uint32_t(4 + k));   // TheGame::m_monsters[4 + k]
        if (ram.ok(m, 0x100))
        {
            wotm::Scene &cc = wotm_live::chaseScene();
            cc.wide = cap.wide;
            cc.fovCull = false;
            cc.fx.fovCull = false;
            cc.vctx = wotm::readViewCtx(ram, 0);
            // the camera before collection: its eye and the segment to the monster pick the transparent buildings (Scene::nativeEye)
            const wotm::GameCamera v0g = wotm::readGameCamera(ram, 0);
            const wotm::GameCamera chaseCam = wotm_live::chaseCamera(ram, m, v0g.ok ? v0g.fovy : 63.7f);
            cc.nativeEye.on = chaseCam.ok;
            if (chaseCam.ok)
            {
                const uint32_t mcs = ram.u32(m + 0xC);
                for (int i = 0; i < 3; ++i)
                {
                    cc.nativeEye.eye[i] = chaseCam.pos[i];
                    cc.nativeEye.target[i] = ram.f32(mcs + 0x10 + 4u * uint32_t(i)) + (i == 2 ? 60.f : 0.f);   // the point it looks at
                }
            }
            cc.collect(ram);
            auto ch = std::make_shared<wotm::Snapshot>(cc.takeSnapshot(ram, sn.g));
            const wotm::GameCamera v0 = ch->cam;   // view 0's camera, which is in the particles' shadow copy
            ch->cam = chaseCam;
            ch->hud.clear();
            ch->overlay.clear();
            ch->hp.clear();
            ch->hpOverlay.clear();
            ch->screenPolys.clear();
            ch->fxCam = v0;
            if (!multi)
                fxAll = sn.fx;
            for (const wotm::FxSystem &s : ch->fx)
                if (std::none_of(fxAll.begin(), fxAll.end(), [&](const wotm::FxSystem &e) { return e.base == s.base; }))
                    fxAll.push_back(s);
            multi = true;
            static unsigned logged = 0;
            static unsigned ghostFrames = 0;   // frames with some building made transparent for the chase camera
            ghostFrames += cc.ghosted > 0;
            if (ch->cam.ok && ++logged % 300u == 0)
            {
                const uint32_t cs = ram.u32(m + 0xC);
                const float dx = ch->cam.pos[0] - ram.f32(cs + 0x10), dy = ch->cam.pos[1] - ram.f32(cs + 0x14), dz = ch->cam.pos[2] - ram.f32(cs + 0x18);
                std::fprintf(stderr, "[chase] player %d: camera %.0f units from the monster, %zu objects in the scene (no culling), transparent building in %u of 300 frames\n",
                             5 + k, std::sqrt(dx * dx + dy * dy + dz * dz), ch->items.size(), ghostFrames);
                ghostFrames = 0;
            }
            sn.chase = std::move(ch);
        }
    }
    static float prevMats[wotm_live::kMaxViews][16];
    static bool havePrev = false;
    sn.fxRam = wotm::Particles::shadowRam(ram, multi ? fxAll : sn.fx, multi && havePrev ? &prevMats[0][0] : nullptr);
    sn.fxRamSize = sn.fxRam ? ram.size : 0;
    for (int k = 0; k < wotm_live::kMaxViews * 16; ++k)
        prevMats[k / 16][k % 16] = ram.f32(wotm::fxaddr::viewPrevMat + 4u * uint32_t(k));
    havePrev = true;
    for (auto &vs : sn.views)
        if (vs)
        {
            vs->fxRam = sn.fxRam;
            vs->fxRamSize = sn.fxRamSize;
        }
    if (sn.chase)
    {
        sn.chase->fxRam = sn.fxRam;
        sn.chase->fxRamSize = sn.fxRamSize;
    }
    sn.screenRects = std::move(rects);
    sn.screenPolys.insert(sn.screenPolys.end(), polys.begin(), polys.end());
    sn.anchors = std::move(anchors);
    wotm_trainview::capture(ram);   // training mode: this frame's body hulls and capsules and health
    sn.fields = ram.u32(wotm::addr::fieldsAtFrameStart);   // interpolation timestamp (Snapshot::fields/hostT)
    sn.hostT = wotm_live::hostNow();
    for (auto &vs : sn.views)
        if (vs)
        {
            vs->fields = sn.fields;
            vs->hostT = sn.hostT;
        }
    if (sn.chase)
    {
        sn.chase->fields = sn.fields;
        sn.chase->hostT = sn.hostT;
    }
    std::lock_guard<std::mutex> lk(c.m);
    c.publish(std::move(sn));
}

// Damage numbers (WOTM_DAMAGEPOP mod): the EE thread sends each hit (wotmDamagePopup: world point, value, kind) and the window
// projects them with the native scene's camera, rising and fading over ~1 s. The digits are glyphs from the game font (the fight's
// "WINS" one, from the last fontBuildPrim): on arrival, the EE thread copies that font's cell and size (fonts[2], 0x38 each), the atlas
// mode and the TEX0 in effect, and the window builds the quads with the same math as FontText::glyph, tinted by the GS color (0x80 =
// 1.0): a hit is white, a thrown object or monster (1) orange, a special (2) cyan and a bit larger.
namespace wotm_live
{
struct DamageFont
{
    uint64_t tex0 = 0;
    bool rtx = false;              // .RTX atlas (16 columns starting at 0) or the boot one (8 columns starting at '!')
    uint16_t cellU = 0, cellV = 0; // cell in the atlas (+0/+2), 1/16 texel
    uint16_t gw = 0, gh = 0;       // glyph in the atlas (+4/+6)
    uint16_t sw = 0, sh = 0;       // glyph on screen (+8/+0xA), 1/16 GS pixel
};
struct DamagePopup
{
    float p[3];
    float amount;
    int kind;
    float dx;      // sideways offset, so consecutive numbers don't overlap
    double t0;     // window clock on arrival (GetTime)
    DamageFont font;
};
static std::mutex g_damageM;
static std::vector<DamagePopup> g_damageNew;   // from the EE thread, no t0 yet
static std::vector<DamagePopup> g_damageLive;  // window only
}
void wotmDamagePopup(const uint8_t *rdram, const float p[3], float amount, int kind)
{
    static uint32_t n = 0;
    if (!rdram)
        return;
    const wotm::Ram ram{rdram, PS2_RAM_SIZE};
    wotm_live::DamageFont f;
    const uint32_t fa = wotm::FontText::kFonts + 0x38u * uint32_t(g_lastFontIdx);
    f.tex0 = wotm_live::g_font.tex0;
    f.rtx = ram.u32(wotm::FontText::kAtlasMode) != 0;
    f.cellU = ram.u16(fa);
    f.cellV = ram.u16(fa + 2);
    f.gw = ram.u16(fa + 4);
    f.gh = ram.u16(fa + 6);
    f.sw = ram.u16(fa + 8);
    f.sh = ram.u16(fa + 0xA);
    if (!f.tex0 || !f.sw || !f.sh)
        return;
    std::lock_guard<std::mutex> lk(wotm_live::g_damageM);
    if (wotm_live::g_damageNew.size() < 64)
        wotm_live::g_damageNew.push_back(wotm_live::DamagePopup{{p[0], p[1], p[2]}, amount, kind, float(int(n++ % 5) - 2), 0.0, f});
}
double wotmDamageIdleSeconds();   // wotm_overrides.cpp: time since the last Monster::update
bool wotmPaused();                // wotm_foto.inc: the EE thread is held by F7 (or photo mode)
// The numbers' clock only runs while the game runs Monster::update: in the fight's pause (the menu doesn't set isPaused), in dialogs
// and on F7 they freeze in mid-air and resume from where they were on return. In the pause menu and dialogs they are hidden (they'd
// cover the list); on F7 they stay visible, for the photo.
static void drawDamagePopups(wotm::Scene &scene, const Camera3D &cam, int rw, int rh)
{
    const bool frozen = wotmDamageIdleSeconds() > 0.1;
    using namespace wotm_live;
    static double s_clock = 0.0, s_real = -1.0;
    const double real = GetTime();
    if (s_real >= 0.0 && !frozen)
        s_clock += std::min(real - s_real, 0.1);
    s_real = real;
    const double now = s_clock;
    {
        std::lock_guard<std::mutex> lk(g_damageM);
        for (DamagePopup &d : g_damageNew)
        {
            d.t0 = now;
            g_damageLive.push_back(d);
        }
        g_damageNew.clear();
    }
    constexpr double kLife = 1.1;
    g_damageLive.erase(std::remove_if(g_damageLive.begin(), g_damageLive.end(), [&](const DamagePopup &d) { return now - d.t0 > kLife; }),
                       g_damageLive.end());
    if (g_damageLive.empty() || (frozen && !wotmPaused()))
        return;
    const wotm::GsScreenRect gr = wotm::gsScreenRect(float(rw), float(rh));
    std::vector<wotm::TextQuad> quads;
    for (const DamagePopup &d : g_damageLive)
    {
        // behind the camera: don't draw
        const float v[3] = {d.p[0] - cam.position.x, d.p[1] - cam.position.y, d.p[2] - cam.position.z};
        const float f[3] = {cam.target.x - cam.position.x, cam.target.y - cam.position.y, cam.target.z - cam.position.z};
        if (v[0] * f[0] + v[1] * f[1] + v[2] * f[2] <= 0.f)
            continue;
        const Vector2 s = GetWorldToScreenEx(Vector3{d.p[0], d.p[1], d.p[2]}, cam, rw, rh);
        const float age = float(now - d.t0), k = age / float(kLife);
        // enters large and settles (0.15 s), rises ~7% of the height, fades out over the last third
        const float pop = age < 0.15f ? 1.f + 0.6f * (1.f - age / 0.15f) : 1.f;
        const float alpha = k < 0.66f ? 1.f : std::max(0.f, (1.f - k) / 0.34f);
        char txt[16];
        if (d.amount >= 9.95f || std::fabs(d.amount - std::round(d.amount)) < 0.05f)   // whole number without ".0"
            std::snprintf(txt, sizeof txt, "%d", int(d.amount + 0.5f));
        else
            std::snprintf(txt, sizeof txt, "%.1f", d.amount);
        // visible digit at ~2.6% of the frame height (x1.25 for a special): 80% of the previous text (measured at 720p); the glyph fills
        // ~70% of the quad (WINS)
        const float hPx = float(rh) * (0.033f / 0.7f) * pop * (d.kind == 2 ? 1.25f : 1.f);
        const float gy = hPx * 224.f / float(rh), scale = gy / (float(d.font.sh) / 16.f);
        const float gw = float(d.font.sw) / 16.f * scale;   // width of one glyph (640-wide units)
        const float advance = gw * 0.8f;                    // the font is wide (outline): glyphs touching, as in the HUD
        const int n = int(std::strlen(txt));
        const float cx = (s.x - gr.x0) * 640.f / gr.w + d.dx * gw * 0.6f, cy = s.y * 224.f / float(rh) - 224.f * 0.07f * k;
        float x = cx - 0.5f * (advance * float(n - 1) + gw);
        const float y = cy - 0.5f * gy;
        // GS color (0x80 = 1.0; above that brightens the glyph): a hit like the HUD text, a throw orange, a special cyan
        const uint8_t r = d.kind == 1 ? 0xFF : d.kind == 2 ? 0x50 : 0x80, g = d.kind == 1 ? 0x90 : d.kind == 2 ? 0xD0 : 0x80,
                      b = d.kind == 1 ? 0x20 : d.kind == 2 ? 0xFF : 0x80, a = uint8_t(0x80 * alpha);
        for (int i = 0; i < n; ++i, x += advance)
        {
            int c = int8_t(txt[i]), row, column, base;
            if (d.font.rtx) { row = c >> 4; column = c & 15; base = 0x10; }
            else { const int q = c - 0x21; row = q >> 3; column = q & 7; base = 8; }
            const float u0 = float(d.font.cellU * column + base) / 16.f, v0 = float(d.font.cellV * row + base) / 16.f;
            wotm::TextQuad t{};
            t.u0 = u0; t.v0 = v0; t.u1 = u0 + float(d.font.gw) / 16.f; t.v1 = v0 + float(d.font.gh) / 16.f;
            t.x0 = x; t.y0 = y; t.x1 = x + gw; t.y1 = y + gy;
            t.r = r; t.g = g; t.b = b; t.a = a;
            t.tex0 = d.font.tex0;
            quads.push_back(t);
        }
    }
    scene.drawQuads(quads, float(rw), float(rh));
}

#include "wotm_narrator.inc"   // name of the monster picked on the select screen (before wotm_padsel.inc, which calls it)
namespace wotm_levelsel { bool resolveRandom(uint8_t *rdram); }   // wotm_levelsel.inc: RANDOM on the stage select (padsel calls it)
// 2-player side choice on the menu's big screen (menu hooks + drawing; wotmPadSelInstall, called from wotm_overrides.cpp)
#include "wotm_padsel.inc"
#include "wotm_levelsel.inc"   // stage select with the hidden stages and RANDOM (after wotm_padsel.inc: big-screen plane)
// Text main menu, with "Recompiled options" (wotmMainMenuInstall, called from wotm_overrides.cpp)
#include "wotm_gamescreens.inc"   // mouse on the menu screens that are still the game's (before wotm_mainmenu.inc, which calls it)
#include "wotm_menufont.inc"   // menu list words in the game's lettering (before wotm_mainmenu.inc)
#include "wotm_rumble.inc"   // gamepad rumble through XInput (before wotm_mainmenu.inc, which installs it)
#include "wotm_mainmenu.inc"
#include "wotm_optscreen.inc"   // the game's options screen with redrawn text (after wotm_mainmenu.inc)
#include "wotm_pausemenu.inc"   // pause menu: without CONTROL SCHEME, with mouse
#include "wotm_legend.inc"   // bottom legend and large hint for the native menus (after wotm_optscreen.inc: font)
#include "wotm_photo.inc"    // photo mode (F9 or L3 + R3; after wotm_legend.inc: legend)

double wotmThreadCpuMs();   // ps2_hostprof.cpp: CPU time of the current thread (user + kernel)

static bool wotmDrawNative(const uint8_t *rdram)
{
    static wotm_live::State S;
    if (wotm_live::g_replayFresh)
    {
        wotm_live::g_replayFresh = false;
        S.scene.invalidate();
        for (RenderTexture2D &r : S.rts)
            if (r.id != 0)
                UnloadRenderTexture(r);
        for (RenderTexture2D &r : S.vrts)
            if (r.id != 0)
                UnloadRenderTexture(r);
        S.ms.release();
        for (wotm::msaa::Target &t : S.vms)
            t.release();
        S.~State();
        new (&S) wotm_live::State();
    }
    wotm_live::g_state = &S;
    S.scene.movieTexture = []() -> unsigned {   // menu object with texId 999
#ifdef WOTM_HAVE_FMV
        if (const unsigned id = wotm::fmv::Player::get().screenTexture()) return id;
#endif
        return wotm_live::g_localCollect && wotm_live::g_replayMovieTex ? wotm_live::g_replayMovieTex() : 0u;
    };
    S.scene.screenTexture = []() { return S.rts[S.cur ^ 1].texture.id; };   // texId 0: previous frame
    // native frame: renderHeight tall (WOTM_RES) at the screen aspect ratio (wotm_live::viewAspect); the GS screen is the central 4:3 strip
    const int RH = wotm_live::renderHeight(), RW = static_cast<int>(std::lround(RH * wotm_live::viewAspect()));
    S.scene.wide = static_cast<float>(RW) / (RH * 4.f / 3.f);
    {   // one line when the frame or the window changes size
        static int lastRW = 0, lastRH = 0, lastSW = 0, lastSH = 0;
        const int sw = GetScreenWidth(), sh = GetScreenHeight();
        if (RW != lastRW || RH != lastRH || sw != lastSW || sh != lastSH)
        {
            lastRW = RW; lastRH = RH; lastSW = sw; lastSH = sh;
            std::fprintf(stderr, "[native] frame %dx%d, window %dx%d (%s; WOTM_RES, WOTM_FULLSCREEN)\n", RW, RH, sw, sh,
                         IsWindowState(FLAG_BORDERLESS_WINDOWED_MODE) ? "fullscreen" : "windowed");
        }
    }
    wotm_live::Capture &cap = wotm_live::capture();
    cap.wide.store(S.scene.wide, std::memory_order_relaxed);
    cap.on.store(true, std::memory_order_relaxed);
#ifdef _WIN32
    static bool filterInstalled = false;
    if (!filterInstalled)
    {
        filterInstalled = true;
        wotm_live::SetUnhandledExceptionFilter(wotm_live::crashFilter);
    }
#else
    static bool handlerInstalled = false;
    if (!handlerInstalled)
    {
        handlerInstalled = true;
        wotm_live::installCrashHandler();
    }
#endif
    const wotm::Ram ram{rdram, PS2_RAM_SIZE};
    // Stage load (g_loadFreeze): repeats the last frame drawn (S.rts[S.cur], untouched) with the Shell::FadeScreen fade on top,
    // in the other buffer; no snapshot and no resource swap until rtMain starts.
    if (wotm_live::g_loadFreeze.load(std::memory_order_relaxed) && !wotm_live::g_localCollect && S.rts[S.cur].id != 0)
    {
        {
            std::lock_guard<std::mutex> lk(cap.m);
            cap.drop();
        }
        const RenderTexture2D &base = S.rts[S.cur];
        RenderTexture2D &out = S.rts[S.cur ^ 1];
        if (out.id != 0 && (out.texture.width != base.texture.width || out.texture.height != base.texture.height))
        {
            UnloadRenderTexture(out);
            out = RenderTexture2D{};
        }
        if (out.id == 0)
        {
            out = LoadRenderTexture(base.texture.width, base.texture.height);
            SetTextureFilter(out.texture, TEXTURE_FILTER_BILINEAR);
            SetTextureWrap(out.texture, TEXTURE_WRAP_CLAMP);
        }
        const float bw = static_cast<float>(base.texture.width), bh = static_cast<float>(base.texture.height);
        BeginTextureMode(out);
        rlSetBlendFactors(RL_ONE, RL_ZERO, RL_FUNC_ADD);
        BeginBlendMode(BLEND_CUSTOM);
        DrawTexturePro(base.texture, Rectangle{0.f, 0.f, bw, -bh}, Rectangle{0.f, 0.f, bw, bh}, Vector2{0.f, 0.f}, 0.f, WHITE);
        EndBlendMode();
        S.scene.screenRects.clear();
        if (wotm::ScreenRect r{}; wotm_live::shellFadeRect(r))
            S.scene.screenRects.push_back(r);
        S.scene.drawScreenRects(bw, bh);
        EndTextureMode();
        const float sw = static_cast<float>(GetScreenWidth()), sh = static_cast<float>(GetScreenHeight());
        const float k = std::min(sw / bw, sh / bh);
        rlSetBlendFactors(RL_ONE, RL_ZERO, RL_FUNC_ADD);
        BeginBlendMode(BLEND_CUSTOM);
        DrawTexturePro(out.texture, Rectangle{0.f, 0.f, bw, -bh}, Rectangle{(sw - bw * k) * 0.5f, (sh - bh * k) * 0.5f, bw * k, bh * k},
                       Vector2{0.f, 0.f}, 0.f, WHITE);
        EndBlendMode();
        return true;
    }
    const uint32_t wc = ram.u32(wotm::addr::world);
    if (!ram.ok(wc, 0x40) || !ram.ok(ram.u32(wc)))
        return false;

    const uint32_t sig = wotm_live::levelSignature(ram);
    if (sig != S.levelSig)
    {
        S.scene.invalidate();
        S.levelSig = sig;
        S.rtxChosen = false;
        S.snap = wotm::Snapshot{};
        S.prev = wotm::Snapshot{};
        S.prev2 = wotm::Snapshot{};
    }
    // New game frame: the snapshot captured on the EE thread (wotmCaptureFrame). In replay (--vu1cmp) no game is running and the
    // snapshot's RAM is fixed: collection happens right here. The following draws repeat the snapshot.
    wotm::Snapshot sn;
    bool fresh = false;   // new snapshot in this present (redraw, below)
    if (wotm_live::g_localCollect)
    {
        const uint32_t gNow = ram.u32(wotm::sym::g_frame);
        if (!S.snap.valid || gNow != S.snap.g)
        {
            wotm_live::g_stage = "collect";
            S.scene.collect(ram);
            sn = S.scene.takeSnapshot(ram, gNow);
        }
    }
    else
    {
        std::lock_guard<std::mutex> lk(cap.m);
        if (cap.fresh)
        {
            sn = std::move(cap.snap);
            cap.fresh = false;
        }
    }
    if (sn.valid)
    {
        // No real stage (loading, empty screen): the GS frame stays. With a dialog in the high-priority list (McBackground frame:
        // "save?", save list) it counts even with the stage almost empty: in Tsunopolis, after the flying saucer takes the
        // monster in the final cutscene, 18 items remain and the save question came out all black.
        // The count includes what collect culled by view (Snapshot::culled): looking out into space on the UFO, or with the camera
        // pressed against a wall, fewer than 20 visible items remained and the whole fight (HUD included) went black.
        if ((sn.items.size() + sn.culled < 20 && sn.hp.empty()) || !sn.cam.ok)
        {
            S.snap = wotm::Snapshot{};
            return false;
        }
        {
            // level + monsters: names and palette bases come from fileStatus (idempotent; only reloads when they change)
            std::string log;
            wotm_live::g_stage = "loadResources";
            S.rtxChosen = S.scene.loadResources(ram, "", &log);
            if (!log.empty() && log != S.rtxPath)
            {
                S.rtxPath = log;
                std::fprintf(stderr, "[native] resources: %s\n", log.c_str());
                wotmBootDone("stage on screen");
            }
        }
        S.prev2 = std::move(S.prev);   // interpolation's P and A
        S.prev2.fxRam.reset();         // returns the particle copy to the pool (Particles::shadowRam)
        for (auto &vs : S.prev2.views)
            if (vs)
                vs.reset();
        S.prev2.chase.reset();
        S.prev = std::move(S.snap);
        S.snap = std::move(sn);
        fresh = true;
        if (S.snap.hostT > 0.0)
        {
            // display clock: O = hostT - fields * period, filtered (the capture varies a few ms with the EE's work in the frame)
            const double target = S.snap.hostT - double(S.snap.fields) * wotm_live::kFieldSec;
            if (!S.interpHaveO || std::fabs(target - S.interpO) > 2.0 * wotm_live::kFieldSec)
                S.interpO = target;
            else
                S.interpO += 0.05 * (target - S.interpO);
            S.interpHaveO = true;
        }
    }
    // Free camera with the game paused (F7): the capture's collection culled against the frozen view. With the EE thread stopped RAM
    // doesn't change, so the present collects again, once per paused frame, without culling (the rest of the snapshot stays the same).
    {
        static uint32_t uncullG = ~0u;
        if (S.snap.valid && (g_wotmFreeCam.load(std::memory_order_relaxed) || wotmPhotoActive()) && wotmPaused() && S.snap.g != uncullG)
        {
            uncullG = S.snap.g;
            static wotm::Scene rc;
            rc.wide = cap.wide.load(std::memory_order_relaxed);
            rc.fovCull = false;
            rc.fx.fovCull = false;
            rc.fx.frameGate = false;   // the stopped RAM is the captured frame's, which had a particleDraw
            wotm_live::g_stage = "collect (free camera)";
            rc.collect(ram);
            wotm::Snapshot un = rc.takeSnapshot(ram, S.snap.g);
            un.screenRects = S.snap.screenRects;
            un.screenPolys = S.snap.screenPolys;
            un.flares = S.snap.flares;
            un.anchors = S.snap.anchors;
            un.cam = S.snap.cam;
            S.snap = std::move(un);
            fresh = true;
        }
    }
    if (!S.snap.valid)
        return false;
    if (!S.snap.cam.ok)
        return false;
    // paused free camera: the show already gets the pose (back-face eye, fog, sprites), and the scene drops what follows the game camera
    // photo mode (F9, L3 + R3) takes the place of the debug free camera while it's on
    wotm_freecam::View freeView = wotm_photo::update(S.snap.cam);
    if (!freeView.on)
        freeView = wotm_freecam::update(S.snap.cam);
    wotmFreeCamLegend(freeView);   // F5: controls in the icon legend
    const wotm::GameCamera gameCam = S.snap.cam;
    if (freeView.override)
        S.snap.cam = wotm_freecam::camera(gameCam, freeView.pose, freeView.zoom);
    const wotm::GameCamera freeCam = S.snap.cam;
    // WOTM_NOHUD=1: never any HUD or game text, like photo mode with the HUD hidden (stage shots with WOTM_SHOTS)
    static const bool noHud = [] { const char *e = std::getenv("WOTM_NOHUD"); return e && e[0] == '1'; }();
    const bool photoHide = (freeView.override && freeView.photo && freeView.hideHud) || noHud;
    // Redraw: only with a new game frame (or a new free-camera snapshot), a changing Shell::FadeScreen fade, a paused free camera
    // or a resized window; when stuck without a new frame (pause, loops without capture) it goes back to redrawing at ~60/s. On the other
    // presents (monitor above 60 Hz, initPresentRate) the last image is just re-presented: the cost stays at 60's and texId 0
    // (previous frame, environment map/CLOAK) keeps being the previous drawing, not a copy of the same frame.
    const double nowT = GetTime();
    static double lastFreshT = 0.0, lastRenderT = 0.0;
    static long s_renders = 0, s_blends = 0;   // redraws and, of those, the ones blended by interpolation (PS2X_STATS, [native] line)
    static double s_drawMs[5] = {}, s_drawCpu[5] = {};   // redraws with 1 to 4 views since the last [native] line: wall time and thread CPU
    static long s_drawN[5] = {};
    int nViews = 1;
    if (fresh)
        lastFreshT = nowT;
    wotm::ScreenRect fadeNow{};
    const bool hasFade = wotm_live::shellFadeRect(fadeNow);
    static wotm::ScreenRect lastFade{};
    static bool lastHasFade = false;
    const bool fadeChanged = hasFade != lastHasFade || (hasFade && std::memcmp(&fadeNow, &lastFade, offsetof(wotm::ScreenRect, underText)) != 0);
    const RenderTexture2D &shown = S.rts[S.cur];
    const bool sizeOk = shown.id != 0 && shown.texture.width == RW && shown.texture.height == RH;
    // WOTM_INTERP=redraw: redraws on every present (interpolation stage 0: measures the cost of redrawing at the monitor rate)
    static const bool s_redrawAll = [] {
        const char *e = std::getenv("WOTM_INTERP");
        return e && std::strstr(e, "redraw") != nullptr;
    }();
    // Frame interpolation (INTERPOLATE FRAMES option, on by default; NATIVO.md, "Taxa de apresentacao"): with the
    // present above 60 Hz (or up to 60 with the game at 30: slowGame), each present draws the blend of A (S.prev) and B
    // (S.snap) at instant D of the display clock, one game frame
    // behind the newest (plus a margin, so a late capture still arrives before alpha hits 1). With no new frame the
    // alpha stops at 1 (B; no extrapolation). Off for: replay, free camera or photo, pause, A without a timestamp, a gap in fields or in the
    // clock (dialog, load), and in training with spheres or outlines (drawn with B's pose).
    float alpha = 1.f;
    bool interpOn = false, interpOld = false;   // interpOld: the pair is (P, A), not (A, B)
    {
        static const float fixedAlpha = [] { const char *e = std::getenv("WOTM_INTERP_ALPHA"); return e && *e ? std::clamp(float(std::atof(e)), 0.f, 1.f) : -1.f; }();
        static const double marginSec = [] { const char *e = std::getenv("WOTM_INTERP_DELAY"); return (e && *e ? std::atof(e) : 3.0) / 1000.0; }();
        // Game at 30 (2-field frames): half or more of the last 64 pairs with a gap >= 2 turns it on, 1/8 or fewer turns it off. With
        // the present at up to 60 Hz blending only helps in this case (with the game at 60 it would just add a frame of delay).
        static bool slowGame = false;
        static uint64_t gapBits = 0;   // 1 = pair with a gap >= 2, one bit per new frame
        static uint32_t lastGapG = 0;
        if (S.snap.g != lastGapG && S.prev.valid && S.snap.fields > S.prev.fields)
        {
            lastGapG = S.snap.g;
            gapBits = (gapBits << 1) | (S.snap.fields - S.prev.fields >= 2 ? 1u : 0u);
            int slow = 0;
            for (uint64_t b = gapBits; b; b &= b - 1)
                ++slow;
            if (!slowGame && slow >= 32)
                slowGame = true;
            else if (slowGame && slow <= 8)
                slowGame = false;
        }
        const int presentHz = wotm::settings::g_presentHz.load(std::memory_order_relaxed);
        // A draw that doesn't fit in the present period (wotm_live::g_drawMs, the redraw average): with blending vsync would drop to
        // half, worse than without it. Above 85% of the period it suspends; it comes back below 60%.
        static bool tooSlow = false;
        if (presentHz > 0)
        {
            const double periodMs = 1000.0 / presentHz, ms = wotm_live::g_drawMs;
            const bool was = tooSlow;
            if (!tooSlow && ms > 0.85 * periodMs)
                tooSlow = true;
            else if (tooSlow && ms < 0.6 * periodMs)
                tooSlow = false;
            if (tooSlow != was)
                std::fprintf(stderr, "[interp] redraw of %.2f ms for a period of %.2f ms: blending %s\n", ms, periodMs, tooSlow ? "suspended" : "back on");
        }
        const bool want = wotm::settings::on(wotm::settings::Interp) && (presentHz > 60 || (presentHz > 0 && slowGame)) && !tooSlow &&
                          !wotm_live::g_localCollect;
        wotm_live::g_interpCull.store(want, std::memory_order_relaxed);
        const bool trainOverlay = wotm_training::g_on.load(std::memory_order_relaxed) &&
                                  (wotm_training::g_opts.load(std::memory_order_relaxed) &
                                   (wotm_training::kShowAttacks | wotm_training::kShowHulls | wotm_training::kShowCapsule));
        // blendable pair (x, y): both timestamped, a gap of 1 to 4 fields, no clock gap
        auto pairOk = [](const wotm::Snapshot &x, const wotm::Snapshot &y) {
            const int gap = int(y.fields - x.fields);
            return x.valid && y.valid && x.hostT > 0.0 && y.hostT > 0.0 && gap > 0 && gap <= 4 && y.hostT - x.hostT < 0.1;
        };
        const wotm::Snapshot &A = S.prev, &B = S.snap;
        if (want && !freeView.override && !wotmPaused() && !trainOverlay && S.interpHaveO && pairOk(A, B))
        {
            interpOn = true;
            // displayed instant, in fields: one frame (the gap from A to B) behind the game clock, minus the margin
            const int gap = int(B.fields - A.fields);
            const double D = (wotm_live::hostNow() - S.interpO - marginSec) / wotm_live::kFieldSec - double(gap);
            if (fixedAlpha >= 0.f)
                alpha = fixedAlpha;
            else if (D < double(A.fields) && !B.views[0] && !B.views[1] && !B.views[2] && !B.chase && pairOk(S.prev2, A) &&
                     D >= double(S.prev2.fields))
            {
                // B arrived early: the instant is still between P and A
                interpOld = true;
                alpha = float((D - double(S.prev2.fields)) / double(A.fields - S.prev2.fields));
            }
            else
                alpha = float(std::clamp((D - double(A.fields)) / double(gap), 0.0, 1.0));
        }
        static const bool interpLog = std::getenv("WOTM_INTERPLOG") != nullptr;
        if (interpLog && want)
            std::fprintf(stderr, "[interp] t=%.4f g=%u fA=%u fB=%u alpha=%.3f%s%s%s\n", wotm_live::hostNow(), B.g, interpOld ? S.prev2.fields : A.fields,
                         interpOld ? A.fields : B.fields, alpha, interpOn ? "" : " (off)", interpOld ? " (P-A)" : "", fresh ? " new" : "");
    }
    const bool rerender = s_redrawAll || fresh || fadeChanged || freeView.override || !sizeOk || wotm_live::g_localCollect ||
                          (interpOn && alpha - (interpOld ? 2.f : 0.f) != S.lastAlpha) || (nowT - lastFreshT >= 0.04 && nowT - lastRenderT >= 1.0 / 60.0 - 0.001);
    if (rerender)
    {
        S.lastAlpha = interpOn ? alpha - (interpOld ? 2.f : 0.f) : -1.f;   // the (P, A) pair sits below -1
        s_blends += interpOn && alpha < 1.f;
    }
    wotm::GameCamera gc = S.snap.cam;
    if (rerender)
    {
        lastRenderT = nowT;
        // redraw time (CPU, until the end of this block), moving average: the interpolation lock (tooSlow) reads it
        struct DrawTimer
        {
            double t0 = wotm_live::hostNow();
            ~DrawTimer()
            {
                // each sample counts for at most two periods: a single isolated redraw (texture load, stage change) doesn't suspend on its own
                const int hz = wotm::settings::g_presentHz.load(std::memory_order_relaxed);
                const double ms = std::min((wotm_live::hostNow() - t0) * 1000.0, hz > 0 ? 2000.0 / hz : 1000.0);
                wotm_live::g_drawMs += (ms - wotm_live::g_drawMs) * 0.05;   // starts at 0: the first redraw (textures) doesn't weigh alone
            }
        } drawTimer;
        ++s_renders;
        const double tDraw0 = GetTime(), cpuDraw0 = wotmThreadCpuMs();   // redraw cost by number of views (PS2X_STATS)
        lastFade = fadeNow;
        lastHasFade = hasFade;
        // Split screen (Snapshot::views): each view is drawn into a half-frame texture, with its own camera, as if it were the
        // whole screen (whatever measures the framebuffer, like flares and the camera aspect ratio, works unchanged), and the two are
        // composited side by side. With 3 and 4 players (320 x 112 views, wotm_split4.inc) the textures are quadrants: view v in column v & 1
        // and row v >> 1; with 3, view 2 is the whole bottom row (640 x 112 viewDef, strip). The free camera (F5) shows only
        // view 0 in fullscreen.
        bool viewOk[4] = {true, false, false, false};
        for (int v = 1; v < 4; ++v)
        {
            const auto &vs = S.snap.views[v - 1];
            viewOk[v] = vs && vs->valid && vs->cam.ok && S.snap.vctx.shared() && !freeView.override;
            nViews += viewOk[v] && wotm_live::localView() < 0;
        }
        // WOTM_LOCALPLAYER=<n> (netcode, each player on their own PC): only player n's view, fullscreen, with its HUD; players 5..8: the
        // chase view (Snapshot::chase); without it, player 1's
        const int localView = wotm_live::localView();
        const bool chaseOk = localView >= 4 && S.snap.chase && S.snap.chase->valid && S.snap.chase->cam.ok;
        const bool ownView = localView > 0 && localView < 4 && viewOk[localView];
        const wotm::Snapshot *own = chaseOk ? S.snap.chase.get() : ownView ? S.snap.views[localView - 1].get() : nullptr;
        const wotm::Snapshot *ownPrev = chaseOk ? S.prev.chase.get() : ownView ? S.prev.views[localView - 1].get() : nullptr;
        const bool split = localView < 0 && (viewOk[1] || viewOk[2] || viewOk[3]);
        const bool quad = split && S.snap.vctx.h < 224.f;
        {
            static const bool splitLog = std::getenv("WOTM_SPLITLOG") != nullptr;
            if (splitLog)
                std::fprintf(stderr, "[split] draw g=%u views %d%d%d full=%d -> %d%s\n", S.snap.g, viewOk[1], viewOk[2], viewOk[3],
                             S.snap.vctx.full(), split, quad ? " (quadrants)" : "");
        }
        const bool strip = quad && viewOk[2] && !viewOk[3] && S.snap.views[1]->vctx.w >= 640.f;
        const int VW = RW / 2, VH = quad ? RH / 2 : RH;
        auto viewW = [&](int v) { return strip && v == 2 ? RW : VW; };   // width of view v's texture
        // bars over enemies: in each view's draw, before the HUD (Scene::barPass); drawBar already wants the split-screen cuts
        S.scene.splitEdges = split;
        S.scene.stripView = strip ? 2 : -1;
        S.scene.barsUnderHud = true;
        // MSAA (ANTI-ALIASING option, WOTM_MSAA): drawing into a multisample framebuffer, resolved into the usual texture (wotm_msaa.hpp)
        const int msaaSamples = wotm_live::g_force43 ? 0 : wotm::settings::get(wotm::settings::Msaa);
        wotm::g_beforeDepthRead = wotm::msaa::readDepthIfMsaa;
        wotm::g_depthReadIsMsaa = [] { return wotm::msaa::g_current != nullptr; };
        S.scene.setTexFilter(wotm_live::g_force43 ? 0 : wotm::settings::get(wotm::settings::TexFilter));
        if (msaaSamples <= 1)
            for (wotm::msaa::Target &t : S.vms)
                if (t.on())
                    t.release();
        if (wotm::drawProfOn())
            ++wotm::drawProf().redraws;
        wotm::ProfScope psFrame(wotm::DrawProf::RFrame);
        wotm::GpuTimer::Scope gpuScope;
        // interpolation in split screen: the game's bars and health icon (in view 0's snapshot) and each view's flares go
        // to that view's blended camera (Scene::blendAnchors, blendFlares in showBlend), in a copy made view by view before it's
        // drawn; the icon (whole-window polys) goes back to the Scene after view 0
        static std::vector<wotm::ScreenRect> barsMix;
        static std::vector<wotm::TextQuad> polysMix;
        static wotm::Particles::FlareFrame flaresMix[4];
        const bool splitMix = interpOn && split;
        if (splitMix)
        {
            barsMix = S.snap.screenRects;
            polysMix = S.snap.screenPolys;
        }
        auto drawView = [&](RenderTexture2D &vrt, const wotm::GameCamera &vc) {
            wotm::ProfScope psView(wotm::DrawProf::RView);
            const int W = viewW(static_cast<int>(&vrt - S.vrts));
            if (vrt.id != 0 && (vrt.texture.width != W || vrt.texture.height != VH))
            {
                UnloadRenderTexture(vrt);
                vrt = RenderTexture2D{};
            }
            if (vrt.id == 0)
            {
                vrt = LoadRenderTexture(W, VH);
                SetTextureFilter(vrt.texture, TEXTURE_FILTER_BILINEAR);
                SetTextureWrap(vrt.texture, TEXTURE_WRAP_CLAMP);
            }
            wotm::msaa::Target &vms = S.vms[&vrt - S.vrts];
            const bool vmsOn = vms.ensure(W, VH, msaaSamples);
            BeginTextureMode(vmsOn ? vms.render() : vrt);
            wotm::msaa::g_current = vmsOn ? &vms : nullptr;
            ClearBackground(BLACK);
            rlSetClipPlanes(0.5, 30000.0);
            Camera3D vc3{};
            vc3.position = {vc.pos[0], vc.pos[1], vc.pos[2]};
            vc3.target = {vc.pos[0] + vc.fwd[0], vc.pos[1] + vc.fwd[1], vc.pos[2] + vc.fwd[2]};
            vc3.up = {vc.up[0], vc.up[1], vc.up[2]};
            vc3.fovy = vc.fovy;
            vc3.projection = CAMERA_PERSPECTIVE;
            BeginMode3D(vc3);
            wotm_live::g_stage = "draw (view)";
            {
                // this view's bars (they're in view 0's snapshot), at the corner of its texture in the window
                const int v = static_cast<int>(&vrt - S.vrts);
                S.scene.barPass = {splitMix ? &barsMix : &S.snap.screenRects, static_cast<float>(RW), static_cast<float>(RH), v,
                                   static_cast<float>((v & 1) * (RW - VW)), static_cast<float>((v >> 1) * (RH - VH)),
                                   static_cast<float>(W), static_cast<float>(VH)};
            }
            S.scene.draw(ram, false);
            S.scene.barPass = {};
            wotm::endMode3DInTexture();
            BeginMode3D(vc3);   // the view's high-priority list (in rtMain, its hier(v, 1) comes before the text)
            S.scene.drawHp(ram);
            wotm::endMode3DInTexture();
            wotm_live::g_stage = "idle";
            EndTextureMode();
            wotm::msaa::g_current = nullptr;
            if (vmsOn)
                vms.resolve(vrt.id);
        };
        // split screen: each view's flares after all of them are drawn (Scene::deferFlares; the occlusion test waits on the GPU)
        wotm::GameCamera viewCam[4]{};
        S.scene.deferFlares = split;
        ++S.scene.redrawId;
        // each view's depth without waiting on the GPU (the newest ready copy, AsyncDepth; Scene::drawFlaresFor requests this one).
        // In fullscreen, view 0's serves Scene::draw's flare (Scene::fullDepth).
        static wotm::AsyncDepth depth[4];
        static const bool flareSync = std::getenv("WOTM_FLARESYNC") != nullptr;   // the direct read, for comparison
        {
            wotm::ProfScope ps(wotm::DrawProf::RFlares);
            for (int v = 0; v < (split ? 4 : 1); ++v)
                if (viewOk[v])
                    depth[v].fetch(S.scene.redrawId);   // even without a flare: valid tracks the age
        }
        wotm_levelsel::prepare(S.scene, ram);   // our own picture for stages with no art in SHELL (Scene::nodeTexture); outside the menu, none
        for (int v = 1; v < 4; ++v)
            if (split && viewOk[v])
            {
                {
                    wotm::ProfScope ps(wotm::DrawProf::RShow);
                    const auto &va = S.prev.views[v - 1];
                    viewCam[v] = interpOn && va && va->valid ? S.scene.showBlend(*va, *S.snap.views[v - 1], alpha)
                                                             : S.scene.show(*S.snap.views[v - 1]);
                    if (splitMix)
                    {
                        S.scene.blendAnchors(S.snap.anchors, &S.prev.anchors, barsMix, &polysMix);
                        flaresMix[v] = S.scene.fx.flares;
                    }
                }
                drawView(S.vrts[v], viewCam[v]);
            }
        {
            wotm::ProfScope ps(wotm::DrawProf::RShow);
            static long s_cuts = 0;
            bool cut = false;
            gc = !interpOn ? S.scene.show(S.snap) : interpOld ? S.scene.showBlend(S.prev2, S.prev, alpha, &cut) : S.scene.showBlend(S.prev, S.snap, alpha, &cut);
            static const bool interpLog = std::getenv("WOTM_INTERPLOG") != nullptr;
            if (cut && interpLog)
                std::fprintf(stderr, "[interp] camera cut g=%u (%ld)\n", S.snap.g, ++s_cuts);
            if (splitMix)
            {
                if (!interpOld)   // in the (P, A) pair A's anchors don't match B's bars
                {
                    S.scene.blendAnchors(S.snap.anchors, &S.prev.anchors, barsMix, &polysMix);
                    S.scene.screenPolys = polysMix;
                }
                flaresMix[0] = S.scene.fx.flares;
            }
        }
        if (own)   // the local view's scene and camera; bars, fades and HUD quads belong to the frame (they're in view 0's snapshot)
        {
            wotm::ProfScope ps(wotm::DrawProf::RShow);
            std::vector<wotm::ScreenRect> rects = std::move(S.scene.screenRects);
            std::vector<wotm::TextQuad> polys = std::move(S.scene.screenPolys);
            gc = interpOn && !interpOld && ownPrev && ownPrev->valid ? S.scene.showBlend(*ownPrev, *own, alpha) : S.scene.show(*own);
            S.scene.screenRects = std::move(rects);
            S.scene.screenPolys = std::move(polys);
            if (chaseOk)   // the HUD quads belong to the game views; the chase view keeps its own bars (emitChaseHud)
                S.scene.screenPolys.clear();
        }
        S.scene.localView = S.snap.vctx.shared() || chaseOk ? localView : -1;
        wotm_levelsel::prepare(S.scene, ram);   // with this frame's objects
        viewCam[0] = gc;
        S.snap.cam = gameCam;
        if (freeView.override && freeView.photo)
            wotm_photo::applyToScene(S.scene, ram, gameCam, freeCam, freeView, S.snap.anchors, !S.snap.vctx.full());
        else if (freeView.override)
            wotm_freecam::applyToScene(S.scene, gameCam, freeView.pose);
        if (noHud)
        {
            S.scene.hud.clear();
            S.scene.hp.clear();
            S.scene.hpOverlay.clear();
            S.scene.overlay.clear();
            S.scene.screenPolys.clear();
            auto &rects = S.scene.screenRects;
            rects.erase(std::remove_if(rects.begin(), rects.end(), [](const wotm::ScreenRect &r) { return r.barView >= 0; }), rects.end());
        }
        if (wotm::ScreenRect r{}; wotm_live::shellFadeRect(r))
            S.scene.screenRects.push_back(r);

        S.cur ^= 1;
        for (RenderTexture2D &r : S.rts)
            if (r.id != 0 && (r.texture.width != RW || r.texture.height != RH))   // aspect ratio changed (window resized): rebuild both
            {
                UnloadRenderTexture(r);
                r = RenderTexture2D{};
            }
        for (RenderTexture2D &r : S.rts)
            if (r.id == 0)
            {
                r = LoadRenderTexture(RW, RH);
                SetTextureFilter(r.texture, TEXTURE_FILTER_BILINEAR);
                // texId 0 (previous frame): the video/CLOAK environment map uses REGION_CLAMP on the GS's 640x224 screen, which is the
                // whole texture at 4:3 and the central strip in widescreen (Scene::envUv, gsScreenRect)
                SetTextureWrap(r.texture, TEXTURE_WRAP_CLAMP);
            }
        RenderTexture2D &rt = S.rts[S.cur];

        if (split)
        {
            drawView(S.vrts[0], gc);
            wotm::ProfScope psFl(wotm::DrawProf::RFlares);
            for (int v = 0; v < 4; ++v)
            {
                if (!viewOk[v])
                    continue;
                const wotm::Snapshot &sn = v ? *S.snap.views[v - 1] : S.snap;
                const wotm::GameCamera &vc = viewCam[v];
                // with MSAA the view's depth only exists in the multisample target: the flares go there and the color is resolved again
                const bool vmsOn = S.vms[v].on();
                BeginTextureMode(vmsOn ? S.vms[v].render() : S.vrts[v]);
                wotm::msaa::g_current = vmsOn ? &S.vms[v] : nullptr;
                rlSetClipPlanes(0.5, 30000.0);
                Camera3D vc3{};
                vc3.position = {vc.pos[0], vc.pos[1], vc.pos[2]};
                vc3.target = {vc.pos[0] + vc.fwd[0], vc.pos[1] + vc.fwd[1], vc.pos[2] + vc.fwd[2]};
                vc3.up = {vc.up[0], vc.up[1], vc.up[2]};
                vc3.fovy = vc.fovy;
                vc3.projection = CAMERA_PERSPECTIVE;
                BeginMode3D(vc3);
                S.scene.drawFlaresFor(ram, splitMix ? flaresMix[v] : sn.flares, sn.vctx, flareSync ? nullptr : &depth[v], vmsOn ? S.vms[v].render().id : S.vrts[v].id);
                wotm::endMode3DInTexture();
                EndTextureMode();
                wotm::msaa::g_current = nullptr;
                if (vmsOn)
                    S.vms[v].resolve(S.vrts[v].id);
            }
        }
        S.scene.deferFlares = false;
        // side-choice texture (outside the frame's BeginTextureMode); the font is the previous frame's text atlas
        wotm_padsel::renderUi(S.scene, ram, S.scene.text.empty() ? 0ull : S.scene.text.front().tex0);
        wotm_mainmenu::renderUi(S.scene, ram, S.scene.text.empty() ? 0ull : S.scene.text.front().tex0);
        // panel in the fight's pause: the atlas from the last frame with text (with the panel open the game doesn't write the pause list)
        wotm_mainmenu::renderPauseUi(S.scene, ram, wotm_photo::fontTex0(S.scene.text));
        wotm_optscreen::renderUi();
        if (wotm_legend::g_n)   // native legend in place of the game's (wotm_legend.inc): without its button icons
        {
            S.scene.overlay.clear();
            S.scene.hpOverlay.clear();
        }
        {   // 3D monster on the save list (wotm_savepics.hpp): into its RenderTexture, before the frame; the draw below pastes it in
            static const PS2Runtime::IoPaths &io = PS2Runtime::getIoPaths();
            const wotm::GsScreenRect gr = wotm::gsScreenRect(static_cast<float>(RW), static_cast<float>(RH));
            wotm::savepics::drawer().prepare(io.cdRoot, io.cdImage.string(), gr.w, static_cast<float>(RH));
        }
        const bool msOn = S.ms.ensure(RW, RH, msaaSamples);
        BeginTextureMode(msOn ? S.ms.render() : rt);
        wotm::msaa::g_current = msOn ? &S.ms : nullptr;
        ClearBackground(BLACK);
        rlSetClipPlanes(0.5, 30000.0);
        Camera3D c3{};
        c3.position = {gc.pos[0], gc.pos[1], gc.pos[2]};
        c3.target = {gc.pos[0] + gc.fwd[0], gc.pos[1] + gc.fwd[1], gc.pos[2] + gc.fwd[2]};
        c3.up = {gc.up[0], gc.up[1], gc.up[2]};
        c3.fovy = gc.fovy;
        c3.projection = CAMERA_PERSPECTIVE;
        if (!split)
        {
            wotm_mainmenu::frameCamera(S.scene, ram, c3, static_cast<float>(RW) / static_cast<float>(RH));   // panel open: big screen head-on
            wotm_padsel::frameCamera(S.scene, ram, c3, static_cast<float>(RW) / static_cast<float>(RH));     // 3- and 4-player select: same
        }
        if (split)
        {
            // the halves (or quadrants) copied as they are (GS alpha included, as in the present) and the black strip from
            // Hud::buildSeparator: 6 GS px at view 0's right edge, down to the screen center; with quadrants, also a strip of
            // 3 GS lines between the two rows of views
            rlSetBlendFactors(RL_ONE, RL_ZERO, RL_FUNC_ADD);
            BeginBlendMode(BLEND_CUSTOM);
            for (int v = 0; v < (quad ? 4 : 2); ++v)
                if (viewOk[v])
                    DrawTexturePro(S.vrts[v].texture, Rectangle{0.f, 0.f, static_cast<float>(viewW(v)), -static_cast<float>(VH)},
                                   Rectangle{static_cast<float>((v & 1) * (RW - VW)), static_cast<float>((v >> 1) * (RH - VH)),
                                             static_cast<float>(viewW(v)), static_cast<float>(VH)},
                                   Vector2{0.f, 0.f}, 0.f, WHITE);
            EndBlendMode();
            const wotm::GsScreenRect gr = wotm::gsScreenRect(static_cast<float>(RW), static_cast<float>(RH));
            const float sepW = std::max(1.f, 6.f * gr.w / 640.f);
            DrawRectangleRec(Rectangle{gr.x0 + gr.w * 0.5f - sepW, 0.f, sepW, static_cast<float>(strip ? RH / 2 : RH)}, BLACK);
            if (quad)
            {
                const float sepH = std::max(1.f, 3.f * static_cast<float>(RH) / 224.f);
                DrawRectangleRec(Rectangle{0.f, 0.5f * static_cast<float>(RH) - 0.5f * sepH, static_cast<float>(RW), sepH}, BLACK);
            }
        }
        else
        {
            BeginMode3D(c3);
            wotm_live::g_stage = "draw";
            S.scene.fullDepth = flareSync ? nullptr : &depth[0];
            S.scene.fullDepthFbo = msOn ? S.ms.render().id : rt.id;
            S.scene.barPass = {&S.scene.screenRects, static_cast<float>(RW), static_cast<float>(RH), -1, 0.f, 0.f,
                               static_cast<float>(RW), static_cast<float>(RH)};   // already with the photo mode offset
            S.scene.draw(ram, false);
            S.scene.barPass = {};
            S.scene.fullDepth = nullptr;
            wotm_padsel::drawOnTelao(S.scene, ram, c3);   // 2-player side choice (only in the menu, during the choice)
            wotm_mainmenu::drawOnTelao(S.scene, ram, c3);   // text main menu list
            wotm_gamescreens::frame(S.scene, ram, c3, RW, RH);   // mouse on the game's screens: each item's rectangle
            wotm_optscreen::drawOnBoard(S.scene, ram, c3);   // the game's options screen
            wotm_trainview::draw3d();   // training mode: on top of the scene, no depth test
            wotm_live::g_stage = "idle";
            wotm::endMode3DInTexture();
        }
        S.scene.splitEdges = split;
        S.scene.stripView = strip ? 2 : -1;
        if (!wotm_live::liveText(S.scene.text))   // game text (pause menu, HUD): font hooks (wotm::FontText)
            S.scene.updateText(ram);              // replay: GS sprites read from the snapshot's fontPacket
        const uint64_t fontTex0 = wotm_photo::fontTex0(S.scene.text);   // the legend writes with it even with no text in the frame
        if (photoHide)
            S.scene.text.clear();   // photo mode with the HUD hidden
        S.scene.drawQuads(S.scene.screenPolys, static_cast<float>(RW), static_cast<float>(RH));   // ScreenPolys HUD (health icon)
        S.scene.drawScreenRects(static_cast<float>(RW), static_cast<float>(RH), true);   // fades dispatched before the text
        if (!split)
        {
            BeginMode3D(c3);   // high-priority list: after those fades (ShellRtLoop::endField), before the text
            S.scene.drawHp(ram);
            wotm::endMode3DInTexture();
        }
        {
            // Monster logo and stage picture on the save list (wotm_savepics.hpp): over the frame, under the text
            static const PS2Runtime::IoPaths &io = PS2Runtime::getIoPaths();
            const wotm::GsScreenRect gr = wotm::gsScreenRect(static_cast<float>(RW), static_cast<float>(RH));
            wotm::savepics::drawer().draw(io.cdRoot, io.cdImage.string(), gr.x0, gr.w, static_cast<float>(RH));
        }
        wotm_pausemenu::drawBox2d(RW, RH, !S.scene.text.empty());   // pause list box (under its text)
        S.scene.drawQuads(S.scene.text, static_cast<float>(RW), static_cast<float>(RH));
        wotm_levelsel::drawBadge(S.scene.text, ram, RW, RH);   // UNUSED badge next to the names of stages the retail game doesn't offer
        wotm_mainmenu::drawPausePanel2d(RW, RH);   // "recompiled options" panel in the fight's pause (wotm_pausemenu.inc)
        wotm_padsel::drawBar2d(RW, RH);            // monster bar for the native select screen (above the bottom black strip)
        {
            // Save list (wotm_save.inc, on the EE thread): the name of the confirm button on the current device, for "press ...
            // again to overwrite", and the bottom legend when loading (in the menu; when saving, in a stage, the black strip would cover the fight)
            namespace st = wotm::settings;
            using wotm_legend::bind;
            const wotm_legend::Icon ok = bind(st::BCross);
            const int style = wotm_prompts::currentStyle();
            std::string lbl = "X";
            if (style == st::PromptKeyboard && ok.key)
            {
                lbl = ok.key;
                std::replace(lbl.begin(), lbl.end(), '_', ' ');
            }
            else if (ok.pad >= GAMEPAD_BUTTON_RIGHT_FACE_UP && ok.pad <= GAMEPAD_BUTTON_RIGHT_FACE_LEFT)
            {
                static const char *const kNames[3][4] = {{"Y", "B", "A", "X"}, {"TRIANGLE", "CIRCLE", "CROSS", "SQUARE"}, {"X", "A", "B", "Y"}};
                lbl = kNames[style == st::PromptXbox ? 0 : style == st::PromptNintendo ? 2 : 1][ok.pad - GAMEPAD_BUTTON_RIGHT_FACE_UP];
            }
            {
                std::lock_guard<std::mutex> lk(wotm::mouse::g_lblM);
                wotm::mouse::g_confirmLabel = lbl;
            }
            if (wotm::mouse::saveListMode() == 1)
                wotm_legend::post({{bind(st::BUp), bind(st::BDown), "SELECT"}, {ok, {}, "LOAD"}, {bind(st::BTriangle), {}, "BACK"}}, 1.f);
        }
        wotm_legend::draw(S.scene, ram, fontTex0, RW, RH);   // legend and hint for the native menus and photo mode
        S.scene.drawScreenRects(static_cast<float>(RW), static_cast<float>(RH));   // the remaining fades, on top of everything
        if (!split && !photoHide)
            drawDamagePopups(S.scene, c3, RW, RH);   // damage numbers (WOTM_DAMAGEPOP mod; empty without it)
        if (!photoHide)
            wotm_trainview::drawPanel(S.scene, ram, fontTex0, RW, RH);   // training mode: damage panel (empty when off)
        EndTextureMode();
        wotm::msaa::g_current = nullptr;
        if (msOn)
            S.ms.resolve(rt.id);
        wotm_photo::afterRender();   // photo mode: saves the requested frame (it came out without the legend)
        s_drawMs[nViews] += (GetTime() - tDraw0) * 1000.0;
        s_drawCpu[nViews] += wotmThreadCpuMs() - cpuDraw0;   // 15.6 ms steps on Windows: only meaningful as an average
        ++s_drawN[nViews];

        {   // WOTM_SHOTS=<s>[,<s>...]: saves the native frame to shot_<s>.png (current folder) when the window clock passes each <s>
            // seconds; for checking screens live with a scripted pad (PS2X_PAD), without a key
            static std::vector<double> shots = [] {
                std::vector<double> v;
                if (const char *s = std::getenv("WOTM_SHOTS"))
                    for (const char *p = s; *p;) {
                        char *e = nullptr;
                        const double t = std::strtod(p, &e);
                        if (e == p) break;
                        v.push_back(t);
                        p = (*e == ',') ? e + 1 : e;
                    }
                return v;
            }();
            static size_t next = 0;
            if (next < shots.size() && GetTime() >= shots[next]) {
                char name[64];
                std::snprintf(name, sizeof name, "shot_%g.png", shots[next]);
                if (wotm_live::exportFrame(name)) std::fprintf(stderr, "[shot] %s (g_frame %u)\n", name, ram.u32(0x006F7E38));
                ++next;
            }
        }
    }

    // frame in the window, keeping the aspect ratio (bars only if the window leaves 4:3..32:9 or with a fixed WOTM_ASPECT)
    const float sw = static_cast<float>(GetScreenWidth()), sh = static_cast<float>(GetScreenHeight());
    const float k = std::min(sw / RW, sh / RH);
    const Rectangle src{0.f, 0.f, static_cast<float>(RW), -static_cast<float>(RH)};
    const Rectangle dst{(sw - RW * k) * 0.5f, (sh - RH * k) * 0.5f, RW * k, RH * k};
    wotm_pad::pointerFrame(dst, RW, RH);   // mouse in menus: position in the native frame, clicks and wheel (wotm_mouse.hpp)
    {   // and in PS2 screen units (game text), for the EE thread
        const wotm::mouse::Pointer &p = wotm::mouse::g_ptr;
        const wotm::GsScreenRect gr = wotm::gsScreenRect(static_cast<float>(RW), static_cast<float>(RH));
        wotm::mouse::publishGs(p.in, (p.x - gr.x0) * 640.f / gr.w, p.y * 224.f / static_cast<float>(RH));
    }
    // No blending: the frame's alpha is whatever the GS blends left (normal ones lower it, additive raises it to 1.0), not opacity. With
    // BLEND_ALPHA over black the scene came out darkened by the alpha, and the additive quads (power-up halo) became bright rectangles.
    rlSetBlendFactors(RL_ONE, RL_ZERO, RL_FUNC_ADD);
    BeginBlendMode(BLEND_CUSTOM);
    DrawTexturePro(S.rts[S.cur].texture, src, dst, Vector2{0.f, 0.f}, 0.f, WHITE);
    EndBlendMode();

    {   // FPS counter (off at startup; F3 toggles): "game" = game frames per second (g_frame, 0x6F7E38); "screen" = native draws per second
        static bool show = false;
        static uint32_t lastG = 0;
        static double lastT = 0.0;
        static int drawn = 0;
        static float gameFps = 0.f, screenFps = 0.f;
        if (IsKeyPressed(KEY_F3))
            show = !show;
        ++drawn;
        const double now = GetTime();
        static const bool camLog = std::getenv("WOTM_CAMLOG") != nullptr;   // diagnostics: time series of the camera read (one [cam] per draw)
        if (camLog)
        {
            // _cs of views 0 and 1 (pointers) and the forward of worldToScreenMat (row 3), read now: tells a camera switch apart from a torn read
            const uint32_t wm = wotm::addr::worldToScreenMat;
            const uint32_t cs = ram.u32(wotm::addr::viewInfo);
            float csp[3] = {0, 0, 0}, csu[3] = {0, 0, 0};
            if (ram.ok(cs, 0x60))
                for (int i = 0; i < 3; ++i) { csp[i] = ram.f32(cs + 0x10 + 4 * i); csu[i] = ram.f32(cs + 0x40 + 4 * i); }
            std::fprintf(stderr, "[cam] t=%.4f g=%u fov=%.2f pos=%.2f,%.2f,%.2f fwd=%.4f,%.4f,%.4f cs=%x,%x wm3=%.4f,%.4f,%.4f csp=%.2f,%.2f,%.2f "
                                 "up=%.4f,%.4f,%.4f csu=%.4f,%.4f,%.4f\n",
                         now, ram.u32(wotm::sym::g_frame), gc.fovy, gc.pos[0], gc.pos[1], gc.pos[2], gc.fwd[0], gc.fwd[1], gc.fwd[2], cs,
                         ram.u32(wotm::addr::viewInfo + 0x14), ram.f32(wm + 0x30), ram.f32(wm + 0x34), ram.f32(wm + 0x38), csp[0], csp[1], csp[2],
                         gc.up[0], gc.up[1], gc.up[2], csu[0], csu[1], csu[2]);
        }
        if (lastT == 0.0)
        {
            lastT = now;
            lastG = ram.u32(wotm::sym::g_frame);
        }
        else if (now - lastT >= 0.5)
        {
            const uint32_t g = ram.u32(wotm::sym::g_frame);
            gameFps = static_cast<float>(g - lastG) / static_cast<float>(now - lastT);
            screenFps = static_cast<float>(drawn) / static_cast<float>(now - lastT);
            lastG = g;
            drawn = 0;
            lastT = now;
        }
        if (show && !wotm_live::g_hideFps)
        {
            char line[128];
            std::snprintf(line, sizeof line, "game %.1f fps | screen %.1f fps", gameFps, screenFps);
            DrawText(line, 11, 11, 20, BLACK);
            DrawText(line, 10, 10, 20, gameFps >= 55.f ? GREEN : (gameFps >= 30.f ? YELLOW : RED));
        }
    }

    {   // debug menu (F1 opens/closes; while open, 1..6 toggle). Arrows and Enter belong to the pad (ps2_pad.cpp): they don't work here.
        // It only writes g_wotmCheats; the EE thread applies it (monsterUpdateCheats, wotm_overrides.cpp).
        static bool open = false;
        if (IsKeyPressed(KEY_F1) && !wotm_netstatus::g_active)   // cheats change the game on one PC only: not during a network match
            open = !open;
        uint32_t c = g_wotmCheats.load(std::memory_order_relaxed);
        const uint32_t st = (c & kCheatStaminaMask) / kCheatStamina1;
        if (open)
        {
            uint32_t n = c;
            if (IsKeyPressed(KEY_ONE)) n ^= kCheatInvincible;
            if (IsKeyPressed(KEY_TWO)) n = (n & ~kCheatStaminaMask) | ((st + 1u) % 3u) * kCheatStamina1;
            if (IsKeyPressed(KEY_THREE)) n ^= kCheatSpecial;
            if (IsKeyPressed(KEY_FOUR)) n ^= kCheatCloak;
            if (IsKeyPressed(KEY_FIVE)) n ^= kCheatGod;
            if (IsKeyPressed(KEY_SIX)) g_wotmCheatWin = true;
            if (n != c)
            {
                g_wotmCheats = n;
                std::fprintf(stderr, "[debug] cheats 0x%x -> 0x%x\n", c, n);
                c = n;
            }
        }
        const uint32_t s2 = (c & kCheatStaminaMask) / kCheatStamina1;
        static const char *const stName[3] = {"normal", "full", "rage (130)"};
        const int fs = 20, x = 10, top = 40;
        if (open)
        {
            char lines[8][64];
            int nl = 0;
            std::snprintf(lines[nl++], 64, "DEBUG (F1 closes)");
            std::snprintf(lines[nl++], 64, "1  Invincible        %s", (c & kCheatInvincible) ? "ON" : "-");
            std::snprintf(lines[nl++], 64, "2  Stamina           %s", stName[s2]);
            std::snprintf(lines[nl++], 64, "3  Special ready     %s", (c & kCheatSpecial) ? "ON" : "-");
            std::snprintf(lines[nl++], 64, "4  Cloak (invisible) %s", (c & kCheatCloak) ? "ON" : "-");
            std::snprintf(lines[nl++], 64, "5  Game's god mode   %s", (c & kCheatGod) ? "ON" : "-");
            std::snprintf(lines[nl++], 64, "6  Win the fight (knocks out the AIs)");
            int w = 0;
            for (int i = 0; i < nl; ++i)
                w = std::max(w, MeasureText(lines[i], fs));
            DrawRectangle(x - 6, top - 6, w + 12, nl * (fs + 4) + 8, Color{0, 0, 0, 170});
            for (int i = 0; i < nl; ++i)
                DrawText(lines[i], x, top + i * (fs + 4), fs, i == 0 ? YELLOW : RAYWHITE);
        }
        else if (c)
        {   // closed: short reminder of what's on
            char line[96];
            std::snprintf(line, sizeof line, "debug:%s%s%s%s%s", (c & kCheatInvincible) ? " INV" : "", s2 == 1 ? " STA" : (s2 == 2 ? " RAGE" : ""),
                          (c & kCheatSpecial) ? " SPC" : "", (c & kCheatCloak) ? " CLOAK" : "", (c & kCheatGod) ? " GOD" : "");
            DrawText(line, x + 1, top + 1, fs, BLACK);
            DrawText(line, x, top, fs, ORANGE);
        }
    }


    if (wotm_netstatus::g_active)
    {   // network match: ping and delay in the corner; when waiting for someone or stopped, the message in the center
        const int fs = 18, sw = GetScreenWidth(), sh = GetScreenHeight();
        char line[64];
        std::snprintf(line, sizeof line, "ping %u ms | delay %u", wotm_netstatus::g_pingMs.load(), wotm_netstatus::g_delay.load());
        const int lw = MeasureText(line, fs);
        DrawText(line, sw - lw - 9, 11, fs, BLACK);
        DrawText(line, sw - lw - 10, 10, fs, LIGHTGRAY);
        const std::string msg = wotm_netstatus::message();
        if (!msg.empty())
        {
            const int mfs = 28, mw = MeasureText(msg.c_str(), mfs);
            DrawRectangle((sw - mw) / 2 - 16, sh / 2 - mfs, mw + 32, mfs * 2, Color{0, 0, 0, 190});
            DrawText(msg.c_str(), (sw - mw) / 2, sh / 2 - mfs / 2, mfs, YELLOW);
        }
    }

    if (++S.frame % 300 == 0 && std::getenv("PS2X_STATS"))
        std::fprintf(stderr, "[native] frame %ld redraws=%ld blended=%ld t=%.1f items=%zu sky=%zu rtx=%s\n", S.frame, s_renders, s_blends, GetTime(),
                     S.scene.items.size(), S.scene.sky.size(), S.rtxPath.c_str());
    if (S.frame % 300 == 0 && std::getenv("PS2X_STATS"))
    {
        std::fprintf(stderr, "[native] redraw:");
        for (int n = 1; n <= 4; ++n)
            if (s_drawN[n])
                std::fprintf(stderr, " %d view%s %.2f ms (CPU %.2f) x %ld;", n, n > 1 ? "s" : "", s_drawMs[n] / s_drawN[n], s_drawCpu[n] / s_drawN[n], s_drawN[n]);
        std::fprintf(stderr, "\n");
        for (int n = 0; n < 5; ++n)
        {
            s_drawMs[n] = s_drawCpu[n] = 0.0;
            s_drawN[n] = 0;
        }
        if (wotm::drawProfOn())   // WOTM_DRAWSTATS: per-drawn-view average of each Scene::draw phase
        {
            wotm::DrawProf &p = wotm::drawProf();
            const double k = p.views ? 1.0 / double(p.views) : 0.0;
            std::fprintf(stderr, "[native] draw per view (x %ld): sky %.2f traversal %.2f OT %.2f shadows %.2f (silhouettes %.2f) sprites %.2f "
                         "particles %.2f HUD %.2f ms (batch flushes %.2f, vertices on threads %.2f); %.0f batches (%.0f draws), %.0f vertices (%.0f emitted, %.0f from the arena, %.0f uploaded to it); silhouettes %ld rebuilt, %ld reused\n", p.views, p.ms[wotm::DrawProf::Sky] * k, p.ms[wotm::DrawProf::Trav] * k,
                         p.ms[wotm::DrawProf::AlphaOT] * k, p.ms[wotm::DrawProf::Shadows] * k, p.ms[wotm::DrawProf::ShadowTex] * k,
                         p.ms[wotm::DrawProf::Sprites] * k, p.ms[wotm::DrawProf::Fx] * k, p.ms[wotm::DrawProf::Hud] * k, p.ms[wotm::DrawProf::Flush] * k, p.ms[wotm::DrawProf::Jobs] * k,
                         double(p.batches) * k, double(p.draws) * k,
                         double(p.verts) * k, double(p.emitted) * k, double(p.resident) * k, double(p.resUp) * k, p.shadowMiss, p.shadowHit);
            const double r = p.redraws ? 1.0 / double(p.redraws) : 0.0;
            {
                wotm::GpuTimer &g = wotm::GpuTimer::get();
                std::fprintf(stderr, "[native] GPU per redraw: %.2f ms (x %ld)\n", g.n ? g.ms / double(g.n) : 0.0, g.n);
                g.ms = 0.0;
                g.n = 0;
                std::fprintf(stderr, "[native] VtxStream per redraw: upload %.2f ms (%.2f MB), draws and states %.2f ms\n", wotm::VtxStream::upMs * r,
                             wotm::VtxStream::upBytes * r / 1048576.0, wotm::VtxStream::drawMs * r);
                wotm::VtxStream::upMs = wotm::VtxStream::drawMs = wotm::VtxStream::upBytes = 0.0;
            }
            std::fprintf(stderr, "[native] per redraw (x %ld): total %.2f, show %.2f, views %.2f, deferred flares %.2f, rest %.2f ms\n", p.redraws,
                         p.ms[wotm::DrawProf::RFrame] * r, p.ms[wotm::DrawProf::RShow] * r, p.ms[wotm::DrawProf::RView] * r,
                         p.ms[wotm::DrawProf::RFlares] * r,
                         (p.ms[wotm::DrawProf::RFrame] - p.ms[wotm::DrawProf::RShow] - p.ms[wotm::DrawProf::RView] - p.ms[wotm::DrawProf::RFlares]) * r);
            p = wotm::DrawProf{};
        }
    }
    return true;
}
// Called on the game thread right after particleDraw (hook_particleDraw, main.cpp): copies the already projected lens flare list
// (Particles::captureFlares); the present arrives too late (the next frame's hier has already rebuilt it).
void wotmFlareCapture(const uint8_t *rdram)
{
    if (rdram)
        wotm::Particles::captureFlares(wotm::Ram{rdram, PS2_RAM_SIZE});
}
