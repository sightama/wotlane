// VU0 microcode without VIF0 (FRONTEIRA.md, step 7). Every frame hier calls hierLoadVu0Ucode, which sends a fixed chain from the
// ELF over DMA channel 0: only MPG, the whole microprogram image (shadows and particles included), never UNPACK.
// In the game executable the hook copies the image (wotmVu0CodeImage, generated by tools/vu0native.py from the same package) straight
// into VU0 code memory, only when it changes (the new generation makes the translated microprograms check the hash again); VIF0
// doesn't exist in wotm. In the test executable the original still runs, and the first load checks that VIF0 left the same image.
#if __has_include("wotm_vu0_native.h") && __has_include("wotm_syms.h")
#include "wotm_vu0_native.h"
#include "wotm_syms.h"
namespace wotm_vu0ucode
{
static_assert(PS2_VU0_CODE_SIZE == 4096, "the vu0native.py image is 4096 bytes");
static PS2Runtime::RecompiledFunction g_orig = nullptr;
inline bool sameAsImage(PS2Runtime *rt)
{
    const uint8_t *img = wotmVu0CodeImage();
    const uint8_t *code = rt->memory().getVU0Code();
    return img && code && std::memcmp(code, img, PS2_VU0_CODE_SIZE) == 0;
}
inline void load(uint8_t *, R5900Context *, PS2Runtime *rt)
{
    if (sameAsImage(rt))
        return;
    static int s_loads = 0;
    if (++s_loads <= 3)
        std::fprintf(stderr, "[vu0] microcode copied from the image (#%d)\n", s_loads);
    std::memcpy(rt->memory().getVU0Code(), wotmVu0CodeImage(), PS2_VU0_CODE_SIZE);
    rt->memory().markVU0CodeModified();
}
// hierInit sends the same chain to VIF0 on its own (boot), and the microprograms run before the first hierLoadVu0Ucode
static PS2Runtime::RecompiledFunction g_origInit = nullptr;
inline void initThenLoad(uint8_t *rdram, R5900Context *ctx, PS2Runtime *rt)
{
    g_origInit(rdram, ctx, rt);
    load(rdram, ctx, rt);
}
// VIF0's DMA is applied later (PS2Memory queue): check on the second call, before the original, what the first one left behind
inline void loadAndCheck(uint8_t *rdram, R5900Context *ctx, PS2Runtime *rt)
{
    static int s_calls = 0;
    if (++s_calls == 2)
        std::fprintf(stderr, "[vu0] VIF0 microcode %s the generated image (wotmVu0CodeImage)\n", sameAsImage(rt) ? "matches" : "DIFFERS FROM");
    g_orig(rdram, ctx, rt);
}
} // namespace wotm_vu0ucode

void wotmVu0UcodeInstall(PS2Runtime &runtime)
{
    if (!wotmVu0CodeImage())
    {
        std::fprintf(stderr, "[vu0] wotm_vu0_native.gen.inc has no microcode image: run build_runtime.bat (tools/vu0native.py)\n");
        return;
    }
#if PS2X_HW_EMU
    wotm_vu0ucode::g_orig = runtime.lookupFunction(wotm::fn::hierLoadVu0Ucode__Fv);
    if (wotm_vu0ucode::g_orig)
        runtime.registerFunction(wotm::fn::hierLoadVu0Ucode__Fv, hostLeaf<wotm_vu0ucode::loadAndCheck>);
#else
    runtime.registerFunction(wotm::fn::hierLoadVu0Ucode__Fv, hostLeaf<wotm_vu0ucode::load>);
    wotm_vu0ucode::g_origInit = runtime.lookupFunction(wotm::fn::hierInit__Fv);
    if (wotm_vu0ucode::g_origInit)
        runtime.registerFunction(wotm::fn::hierInit__Fv, hostLeaf<wotm_vu0ucode::initThenLoad>);
    else
        std::fprintf(stderr, "[vu0] hierInit not found: the microcode only goes up on the first hierLoadVu0Ucode\n");
#endif
}
#else
void wotmVu0UcodeInstall(PS2Runtime &) {}
#endif

// Boot trace: from process start to the game's first movie or frame, each step goes to stderr with the time since start
// ("[boot]  3.21 s  disc: ...") and is written on the black screen. A step stuck for more than 3 s repeats in the log with the EE PC,
// to find the bottleneck on machines where the black screen lingers. Called from main.cpp, initialize/run, sceCdSearchFile and the IOP log.
#include <chrono>
#include <cstdarg>
#include <mutex>
namespace wotm_boot
{
inline const std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
inline std::mutex mx;
inline std::string step = "starting";
inline double stepAt = 0.0;
inline std::atomic<bool> done{false}, presenting{false};
inline std::thread::id mainThread;
inline double now() { return std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count(); }
// Windows Consolas (loaded on the window thread, the first time); without the file, raylib's default font
inline Font font()
{
    static Font f = [] {
        Font r = LoadFontEx("C:/Windows/Fonts/consola.ttf", 40, nullptr, 0);
        if (r.texture.id == 0)
            return GetFontDefault();
        SetTextureFilter(r.texture, TEXTURE_FILTER_BILINEAR);
        return r;
    }();
    return f;
}
inline void drawOverlay()
{
    std::string s;
    double at;
    {
        std::lock_guard<std::mutex> lk(mx);
        s = step;
        at = stepAt;
    }
    const double t = now();
    const float h = static_cast<float>(GetScreenHeight());
    DrawTextEx(font(), TextFormat("Loading... %.1f s", t), Vector2{16.0f, h - 54.0f}, 20.0f, 0.0f, LIGHTGRAY);
    DrawTextEx(font(), TextFormat("%s%s", s.c_str(), t - at >= 3.0 ? TextFormat("  (%.0f s in this step)", t - at) : ""), Vector2{16.0f, h - 28.0f},
               16.0f, 0.0f, GRAY);
}
} // namespace wotm_boot

void wotmBoot(const char *fmt, ...)
{
    if (wotm_boot::done.load(std::memory_order_relaxed))
        return;
    char buf[256];
    va_list ap;
    va_start(ap, fmt);
    std::vsnprintf(buf, sizeof(buf), fmt, ap);
    va_end(ap);
    for (size_t n = std::strlen(buf); n > 0 && (buf[n - 1] == '\n' || buf[n - 1] == '\r' || buf[n - 1] == ' '); --n)
        buf[n - 1] = '\0';   // the IOP printf comes with a line break
    const double t = wotm_boot::now();
    {
        std::lock_guard<std::mutex> lk(wotm_boot::mx);
        if (wotm_boot::mainThread == std::thread::id())
            wotm_boot::mainThread = std::this_thread::get_id();
        wotm_boot::step = buf;
        wotm_boot::stepAt = t;
    }
    std::fprintf(stderr, "[boot] %6.2f s  %s\n", t, buf);
    std::fflush(stderr);
    // before the present loop (ELF, hooks) nobody draws: the main thread draws a frame with the step
    if (!wotm_boot::presenting.load(std::memory_order_relaxed) && IsWindowReady() && std::this_thread::get_id() == wotm_boot::mainThread)
    {
        BeginDrawing();
        ClearBackground(BLACK);
        wotm_boot::drawOverlay();
        EndDrawing();
    }
}

// Once per present, while boot isn't finished: writes the step on screen, repeats a stuck step in the log (with the EE PC) and
// ends the trace on the first movie; with no movie (WOTM_MATCH skips the intro), when the native layer loads the stage (wotmBootDone).
// g_frame and world don't work for this: both are already filled in before the intro.
static void wotmBootDone(const char *what)
{
    if (wotm_boot::done.load(std::memory_order_relaxed))
        return;
    wotmBoot("ready: %s", what);
    wotm_boot::done.store(true, std::memory_order_relaxed);
}
// The vsyncs per second in the warning show whether the wait is the virtual clock running slowly (boot waits on vsyncs).
static void wotmBootPresent(uint32_t eePc, uint64_t vsync)
{
    if (wotm_boot::done.load(std::memory_order_relaxed))
        return;
    wotm_boot::presenting.store(true, std::memory_order_relaxed);
#ifdef WOTM_HAVE_FMV
    const wotm::fmv::Player &fp = wotm::fmv::Player::get();
    if (fp.active(wotm::fmv::Player::Full) || fp.active(wotm::fmv::Player::Screen))
        return wotmBootDone("first movie");
#endif
    static double s_lastBeat = 0.0;
    static uint64_t s_lastVsync = 0;
    const double t = wotm_boot::now();
    if (s_lastBeat == 0.0)
    {
        s_lastBeat = t;
        s_lastVsync = vsync;
    }
    std::string s;
    double at;
    {
        std::lock_guard<std::mutex> lk(wotm_boot::mx);
        s = wotm_boot::step;
        at = wotm_boot::stepAt;
    }
    if (t - at >= 2.0 && t - s_lastBeat >= 2.0)
    {
        const double rate = double(vsync - s_lastVsync) / (t - s_lastBeat);
        std::fprintf(stderr, "[boot] %6.2f s  ... still in \"%s\" for %.1f s (EE PC 0x%06x, vsync %llu, %.0f/s)\n", t, s.c_str(), t - at,
                     eePc, (unsigned long long)vsync, rate);
        std::fflush(stderr);
        s_lastBeat = t;
        s_lastVsync = vsync;
    }
    wotm_boot::drawOverlay();
}

