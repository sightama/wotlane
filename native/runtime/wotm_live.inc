{
    setReturnS32(ctx, static_cast<int32_t>(wotm::fmv::hooks::cmovieUpdate(rdram, getRegU32(ctx, 4), getRegU32(ctx, 5))));
}
inline void cmovieEnd(uint8_t *rdram, R5900Context *ctx, PS2Runtime *)
