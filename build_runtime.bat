@echo off
rem Rebuilds the runtime (ps2EntryRunner.exe) so the live game picks up changes in native/.
rem Ninja doesn't track native/wotm_native.hpp (it lives outside the PS2Recomp tree), so this script "touches" ps2_runtime.cpp
rem before building. Finds the runtime folder by itself (the same one run_live.bat uses).
rem Usage: build_runtime.bat           -> build_dev (no LTCG, ~1.5 min; what run_live.bat uses by default)
rem       build_runtime.bat build     -> build with LTCG (slower; used by run_live.bat -Build build)
rem       build_runtime.bat nm        -> build_dev_nm: "guinea pig" runtime, translated from the ELF with the rewritten functions (recomp\nm,
rem                                      generated by sh tools/wsl/recomp_nm.sh in WSL); run it with run_live.bat -Build build_dev_nm
setlocal enableextensions
set "REPO=%~dp0"
if "%REPO:~-1%"=="\" set "REPO=%REPO:~0,-1%"
set "FOUND="

if defined WOTM_RECOMP_DIR if exist "%WOTM_RECOMP_DIR%\run_live.ps1" set "FOUND=%WOTM_RECOMP_DIR%"

rem set /p and the use of SAVED on separate lines: inside a ( ) block %SAVED% is expanded before set /p runs
if not defined FOUND if exist "%REPO%\.wotm_recomp_dir" set /p SAVED=<"%REPO%\.wotm_recomp_dir"
if not defined FOUND if defined SAVED call :check "%SAVED%"
if not defined FOUND call :check "%REPO%"
if not defined FOUND call :check "%REPO%\..\wotm-recomp-win"
if not defined FOUND for /d %%D in ("%REPO%\..\*") do if not defined FOUND call :check "%%~fD"

if not defined FOUND (
    echo Could not find run_live.ps1 near "%REPO%".
    set /p ASKED=Paste the path of the runtime folder ^(the one with run_live.ps1^):
    call :check "%ASKED%"
    if not defined FOUND (
        echo Invalid folder.
        exit /b 1
    )
)
> "%REPO%\.wotm_recomp_dir" echo %FOUND%

set "BAT=build_dev.bat"
set "LOG=logs\build_dev.log"
if /i "%~1"=="build" (
    set "BAT=build.bat"
    set "LOG=logs\build.log"
)
if /i "%~1"=="nm" (
    set "BAT=build_dev_nm.bat"
    set "LOG=logs\build_dev_nm.log"
)
if /i not "%~1"=="nm" if not exist "%FOUND%\%BAT%" (
    echo Could not find "%FOUND%\%BAT%".
    exit /b 1
)

echo Runtime: %FOUND%
echo Building with %BAT% ^(log in %FOUND%\%LOG%^)...
powershell -NoProfile -ExecutionPolicy Bypass -File "%REPO%\tools\build_runtime.ps1" "%FOUND%" "%BAT%" "%LOG%"
set "RC=%errorlevel%"
echo.
if "%RC%"=="0" (echo Executable updated.) else (echo Build failed ^(code %RC%^); see %FOUND%\%LOG%.)
exit /b %RC%

:check
rem %1 = candidate folder; sets FOUND if it has run_live.ps1
if exist "%~1\run_live.ps1" set "FOUND=%~f1"
exit /b 0
