@echo off
rem ABOUTME: Builds the game (wotm.exe) and the test executable (ps2EntryRunner.exe) in build_dev; called by build_runtime.bat.
rem ABOUTME: Generated by tools\setup_runtime.ps1; the log goes to logs\build_dev.log, which build_runtime.ps1 follows.
cd /d "%~dp0"
call "@VCVARS@" @VCVARS_ARGS@ >nul
set "PATH=@CMAKE_BIN@;%PATH%"
if not exist logs mkdir logs
cmake --build build_dev --target ps2EntryRunner wotm > logs\build_dev.log 2>&1
