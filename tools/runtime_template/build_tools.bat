@echo off
rem ABOUTME: Builds PS2Recomp's analyzer and recompiler (ps2_analyzer, ps2_recomp) in build_tools.
rem ABOUTME: Generated by tools\setup_runtime.ps1; only needs to run again if PS2Recomp changes.
cd /d "%~dp0"
call "@VCVARS@" @VCVARS_ARGS@ >nul
set "PATH=@CMAKE_BIN@;%PATH%"
cmake -S PS2Recomp -G Ninja -DCMAKE_BUILD_TYPE=Release -DPS2X_BUILD_RUNTIME=OFF -DPS2X_BUILD_TEST=OFF -DPS2X_BUILD_STUDIO=OFF -B build_tools || exit /b 1
cmake --build build_tools
