+
+// --- volume mestre e modos
+void setMasterVolume(uint8_t *, R5900Context *ctx, PS2Runtime *)
+{
+    SND_LOG("SetMasterVolume grupo %d = %#x\n", sarg(ctx, 0), sarg(ctx, 1));
+    Engine::get().setMasterVolume(sarg(ctx, 0), sarg(ctx, 1));
+}
