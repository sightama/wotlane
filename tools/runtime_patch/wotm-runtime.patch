+        bits = _mm_blendv_epi8(bits, _mm_or_si128(sign, _mm_set1_epi32(0x7F7FFFFF)), laneMask(c.o));
+        return _mm_castsi128_ps(bits);
+    }
+
+    inline __m256d W(__m128 v) { return _mm256_cvtps_pd(v); }
+
+    template <int D>
+    inline __m128 ADD4(__m128 a, __m128 b, Fm &f) { return fin4<D>(_mm_add_ps(a, b), _mm256_add_pd(W(a), W(b)), f); }
+    template <int D>
+    inline __m128 SUB4(__m128 a, __m128 b, Fm &f) { return fin4<D>(_mm_sub_ps(a, b), _mm256_sub_pd(W(a), W(b)), f); }
+    template <int D>
+    inline __m128 MUL4(__m128 a, __m128 b, Fm &f) { return fin4<D>(_mm_mul_ps(a, b), _mm256_mul_pd(W(a), W(b)), f); }
+
+    // madd/msub: acc +- a*b (dois arredondamentos no float), e o sticky do produto (calculateFmacProductSticky)
+    template <int D>
+    inline __m128 MADD4(__m128 c, __m128 a, __m128 b, Fm &f, bool sub)
+    {
+        const __m256d p = _mm256_mul_pd(W(a), W(b));
+        const __m128 pf = _mm_mul_ps(a, b);
+        const __m128 r = sub ? _mm_sub_ps(c, pf) : _mm_add_ps(c, pf);
+        const __m256d e = sub ? _mm256_sub_pd(W(c), p) : _mm256_add_pd(W(c), p);
+        f.ext |= flagsOf(classify4<D>(p));
+        return fin4<D>(r, e, f);
+    }
+
+    // escreve as lanes de D (x = bit 0)
+    template <int D>
+    inline void ST(float *dst, __m128 v) { _mm_storeu_ps(dst, _mm_blend_ps(_mm_loadu_ps(dst), v, D)); }
+
+    inline uint32_t addr16(int32_t vi, int32_t imm) { return ((uint32_t)(vi + imm) * 16u) & 0xFFFu; }
+
+    // FTOI0 (vuFloatToInt com escala 1): satura no int32 e trunca
+    inline int32_t F2I(float value)
+    {
+        const double scaled = (double)value;
+        if (scaled >= 2147483647.0)
+            return 2147483647;
+        if (scaled <= -2147483648.0)
+            return (int32_t)0x80000000u;
+        return (int32_t)scaled;
+    }
+
+    inline void finish(VU1State &s, uint32_t pc, uint64_t cycles)
+    {
+        s.vf[0][0] = 0.0f;
+        s.vf[0][1] = 0.0f;
+        s.vf[0][2] = 0.0f;
+        s.vf[0][3] = 1.0f;
+        s.vi[0] = 0;
+        s.pc = pc;
+        s.cycles = cycles;
+    }
+}
+
+#if __has_include("wotm_vu0_native.gen.inc")
+#include "wotm_vu0_native.gen.inc"
+#else
+static const WotmVu0Program kPrograms[] = {{0, 0, 0, 0, nullptr}};
+static constexpr size_t kProgramCount = 0;
+#endif
+
+namespace
+{
+    uint64_t fnv1a(const uint8_t *p, uint32_t n)
+    {
+        uint64_t h = 0xcbf29ce484222325ull;
+        for (uint32_t k = 0; k < n; ++k)
+            h = (h ^ p[k]) * 0x100000001b3ull;
+        return h;
+    }
+}
+
+WotmVu0Fn wotmVu0NativeLookup(const uint8_t *vu0Code, uint32_t codeSize, uint64_t generation, uint32_t pc)
+{
+    static WotmVu0Fn s_byPc[512];
+    static uint64_t s_generation = ~0ull;
+    static const bool s_disabled = std::getenv("WOTM_VU0_INTERP") != nullptr;
+    if (s_disabled || pc >= codeSize)
+        return nullptr;
+    if (generation != s_generation)
+    {
+        s_generation = generation;
+        std::memset(s_byPc, 0, sizeof(s_byPc));
+        for (size_t k = 0; k < kProgramCount; ++k)
+        {
+            const WotmVu0Program &p = kPrograms[k];
+            if (p.hashStart + p.length <= codeSize && fnv1a(vu0Code + p.hashStart, p.length) == p.hash)
+                s_byPc[(p.start >> 3) & 511u] = p.fn;
+        }
+    }
+    return s_byPc[(pc >> 3) & 511u];
+}
+
+void wotmVu0NativeRun(WotmVu0Fn fn, VU1State &state, uint8_t *vu0Data)
+{
+    // arredondamento para zero, como o VU (e como VU1Interpreter::run): so o MXCSR, a conta e toda em SSE
+    const unsigned int csr = _mm_getcsr();
+    _mm_setcsr((csr & ~0x6000u) | 0x6000u);
+    fn(state, vu0Data);
+    _mm_setcsr(csr);
+}
diff --git a/ps2xRuntime/src/lib/vu/wotm_vu0_native.h b/ps2xRuntime/src/lib/vu/wotm_vu0_native.h
new file mode 100644
index 0000000..481f867
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu/wotm_vu0_native.h
@@ -0,0 +1,27 @@
+#ifndef WOTM_VU0_NATIVE_H
+#define WOTM_VU0_NATIVE_H
+
+#include "runtime/ps2_vu1.h"
+
+#include <cstddef>
+#include <cstdint>
+
+// Microprograma do VU0 em C++ (gerado por tools/vu0native.py): recebe o estado ja copiado do contexto do EE e a memoria de
+// dados do VU0, e deixa estado e memoria como o interpretador deixaria ao fim do programa (inclusive pc, ciclos e flags).
+using WotmVu0Fn = void (*)(VU1State &state, uint8_t *vu0Data);
+
+struct WotmVu0Program
+{
+    uint32_t start;       // pc de entrada (bytes)
+    uint32_t hashStart;   // inicio do trecho conferido pelo hash (todos os pares que o programa pode executar)
+    uint32_t length;      // bytes desse trecho
+    uint64_t hash;     // FNV-1a 64 desses bytes
+    WotmVu0Fn fn;
+};
+
+// Versao nativa do programa em pc, ou nullptr (sem versao nativa, codigo diferente do esperado, ou WOTM_VU0_INTERP definido).
+WotmVu0Fn wotmVu0NativeLookup(const uint8_t *vu0Code, uint32_t codeSize, uint64_t generation, uint32_t pc);
+// Roda com o arredondamento do VU (para zero).
+void wotmVu0NativeRun(WotmVu0Fn fn, VU1State &state, uint8_t *vu0Data);
+
+#endif
diff --git a/ps2xRuntime/src/lib/wotm_live.inc b/ps2xRuntime/src/lib/wotm_live.inc
new file mode 100644
index 0000000..96232d5
--- /dev/null
+++ b/ps2xRuntime/src/lib/wotm_live.inc
@@ -0,0 +1,266 @@
+// wotm_live.inc: desenho nativo ao vivo (incluido por wotm_scene.inc, no escopo global de ps2_runtime.cpp).
+// Usa native/wotm_native.hpp (do repo WoTM; passe -DWOTM_NATIVE_DIR=<WoTM>/native ao CMake). Sem o header, nao faz nada.
+// Filmes (FMV) nativos: native/wotm_fmv.hpp do repo WoTM, ligado com PS2X_FMV=1 (wotmFmvInstall, chamado do main.cpp).
+// Substitui CMovie::Play/Update/End e playMpegMovieWithDB/updateMpegMovieDecoding (o decodificador do jogo espera a IPU, que o
+// runtime nao emula) e toca o .PSS do disco (pasta cdRoot ou a ISO de PS2X_CD_IMAGE) com o FFmpeg. Sem o header ou sem o FFmpeg,
+// PS2X_FMV so avisa.
+#if __has_include("wotm_fmv.hpp") && __has_include(<libavcodec/avcodec.h>)
+#include "wotm_fmv.hpp"
+#define WOTM_HAVE_FMV 1
+namespace wotm_fmv_hooks
+{
+inline void playWithDB(uint8_t *rdram, R5900Context *ctx, PS2Runtime *)
+{
+    setReturnS32(ctx, static_cast<int32_t>(wotm::fmv::hooks::playMpegMovieWithDB(rdram, getRegU32(ctx, 4), getRegU32(ctx, 5))));
+}
+inline void updateDecoding(uint8_t *rdram, R5900Context *ctx, PS2Runtime *)
+{
+    setReturnS32(ctx, static_cast<int32_t>(wotm::fmv::hooks::updateMpegMovieDecoding(rdram, getRegU32(ctx, 4))));
+}
+inline void cmoviePlay(uint8_t *rdram, R5900Context *ctx, PS2Runtime *)
+{
+    setReturnS32(ctx, static_cast<int32_t>(wotm::fmv::hooks::cmoviePlay(rdram, getRegU32(ctx, 4), getRegU32(ctx, 5), getRegU32(ctx, 6))));
+}
+inline void cmovieUpdate(uint8_t *rdram, R5900Context *ctx, PS2Runtime *)
+{
+    setReturnS32(ctx, static_cast<int32_t>(wotm::fmv::hooks::cmovieUpdate(rdram, getRegU32(ctx, 4), getRegU32(ctx, 5))));
+}
+inline void cmovieEnd(uint8_t *rdram, R5900Context *ctx, PS2Runtime *)
+{
+    setReturnS32(ctx, static_cast<int32_t>(wotm::fmv::hooks::cmovieEnd(rdram, getRegU32(ctx, 4))));
+}
+} // namespace wotm_fmv_hooks
+
+void wotmFmvInstall(PS2Runtime &runtime)
+{
+    const PS2Runtime::IoPaths &io = PS2Runtime::getIoPaths();
+    wotm::fmv::Player &p = wotm::fmv::Player::get();
+    p.discRoot = io.cdRoot;
+    p.isoPath = io.cdImage;
+    runtime.registerFunction(0x0020F4B0u, hostLeaf<wotm_fmv_hooks::playWithDB>);     // playMpegMovieWithDB
+    runtime.registerFunction(0x0020F540u, hostLeaf<wotm_fmv_hooks::updateDecoding>); // updateMpegMovieDecoding
+    runtime.registerFunction(0x00210090u, hostLeaf<wotm_fmv_hooks::cmoviePlay>);     // CMovie::Play
+    runtime.registerFunction(0x00210360u, hostLeaf<wotm_fmv_hooks::cmovieEnd>);      // CMovie::End
+    runtime.registerFunction(0x00210408u, hostLeaf<wotm_fmv_hooks::cmovieUpdate>);   // CMovie::Update
+    std::fprintf(stderr, "[fmv] filmes nativos ligados (disco: %s, iso: %s)\n", io.cdRoot.string().c_str(), io.cdImage.string().c_str());
+}
+
+// Uma vez por apresentacao (thread da janela, dentro do BeginDrawing): avanca os filmes, copia o do menu para a VRAM do GS e
+// desenha o de tela cheia por cima.
+static void wotmFmvPresent(uint8_t *gsVram)
+{
+    wotm::fmv::Player &p = wotm::fmv::Player::get();
+    p.pump(gsVram, PS2_GS_VRAM_SIZE);
+    p.drawFullscreen();
+}
+#else
+void wotmFmvInstall(PS2Runtime &)
+{
+    std::fprintf(stderr, "[fmv] PS2X_FMV ignorado: falta native/wotm_fmv.hpp (WOTM_NATIVE_DIR) ou o FFmpeg (PS2X_ENABLE_FFMPEG)\n");
+}
+static void wotmFmvPresent(uint8_t *) {}
+#endif
+
+// Som nativo (native/wotm_snd.hpp), ligado com PS2X_SND=1 (wotmSndInstall, chamado do main.cpp)
+#include "wotm_snd.inc"
+
+#if __has_include("wotm_native.hpp")
+#include "wotm_native.hpp"
+#include <filesystem>
+#define WOTM_HAVE_NATIVE 1
+
+namespace wotm_live
+{
+// Diagnostico de queda: sem windows.h (conflita com o raylib), espelha so o que o filtro precisa.
+struct ExcRecord
+{
+    unsigned long code, flags;
+    ExcRecord *next;
+    void *address;
+    unsigned long nparams;
+    unsigned long long info[15];
+};
+struct ExcPointers
+{
+    ExcRecord *rec;
+    void *ctx;
+};
+extern "C" __declspec(dllimport) void *__stdcall SetUnhandledExceptionFilter(long(__stdcall *)(ExcPointers *));
+extern "C" __declspec(dllimport) void *__stdcall GetModuleHandleA(const char *);
+inline const char *g_stage = "idle";   // etapa da camada nativa em andamento (para localizar a queda)
+inline long __stdcall crashFilter(ExcPointers *e)
+{
+    const char *base = static_cast<const char *>(GetModuleHandleA(nullptr));
+    std::fprintf(stderr, "[CRASH] code=0x%08lx addr=%p (exe+0x%llx) stage=%s", e->rec->code, e->rec->address,
+                 (unsigned long long)(static_cast<const char *>(e->rec->address) - base), g_stage);
+    if (e->rec->code == 0xC0000005)
+        std::fprintf(stderr, " acesso=%s endereco=0x%llx", e->rec->info[0] == 1 ? "escrita" : (e->rec->info[0] == 8 ? "execucao" : "leitura"), e->rec->info[1]);
+    std::fprintf(stderr, "\n");
+    std::fflush(stderr);
+    return 0; // EXCEPTION_CONTINUE_SEARCH
+}
+struct State
+{
+    wotm::Scene scene;
+    RenderTexture2D rt{};
+    uint32_t levelSig = 0;
+    bool rtxChosen = false;
+    std::string rtxPath;
+    long frame = 0;
+    wotm::Snapshot A, B;   // quadros do jogo anterior e atual (interpolacao: o jogo anda a 30/s, a tela desenha a 60)
+    bool interp = std::getenv("WOTM_NOINTERP") == nullptr;   // F4 liga/desliga a interpolacao (WOTM_NOINTERP: comeca desligada)
+};
+
+inline uint32_t levelSignature(const wotm::Ram &ram)
+{
+    uint32_t h = ram.u32(wotm::addr::tempVramTexAddr) * 2654435761u;
+    for (uint32_t a = 0xA00000; a < 0xA00400; a += 4)
+        h = (h ^ ram.u32(a)) * 16777619u;
+    return h;
+}
+
+} // namespace wotm_live
+
+// Desenha a fase lida da RAM (sem VU1/GS) por cima do quadro; devolve falso (e nao desenha) quando nao ha fase carregada.
+static bool wotmDrawNative(const uint8_t *rdram)
+{
+    static wotm_live::State S;
+#ifdef WOTM_HAVE_FMV
+    S.scene.movieTexture = []() { return wotm::fmv::Player::get().screenTexture(); };   // objeto do menu com texId 999
+#endif
+    static bool filterInstalled = false;
+    if (!filterInstalled)
+    {
+        filterInstalled = true;
+        wotm_live::SetUnhandledExceptionFilter(wotm_live::crashFilter);
+    }
+    const wotm::Ram ram{rdram, PS2_RAM_SIZE};
+    const uint32_t wc = ram.u32(wotm::addr::world);
+    if (!ram.ok(wc, 0x40) || !ram.ok(ram.u32(wc)))
+        return false;
+
+    const uint32_t sig = wotm_live::levelSignature(ram);
+    if (sig != S.levelSig)
+    {
+        S.scene.invalidate();
+        S.levelSig = sig;
+        S.rtxChosen = false;
+        S.A = wotm::Snapshot{};
+        S.B = wotm::Snapshot{};
+    }
+    // Quadro novo do jogo (g_frame em 0x6F7E38 mudou): le a cena da RAM e guarda como instantaneo B (o anterior vira A). Nos desenhos
+    // seguintes so mistura A e B: o jogo termina o quadro e espera o pacing, entao a RAM e consistente logo depois do g_frame++.
+    const uint32_t gNow = ram.u32(0x6F7E38);
+    const double tNow = GetTime();
+    if (!S.B.valid || gNow != S.B.g)
+    {
+        wotm_live::g_stage = "collect";
+        S.scene.collect(ram);
+        if (S.scene.items.size() < 20)
+            return false;
+        {
+            // nivel + monstros: nomes e bases das paletas vem de fileStatus (idempotente; refaz so quando mudam)
+            std::string log;
+            wotm_live::g_stage = "loadResources";
+            S.rtxChosen = S.scene.loadResources(ram, "", &log);
+            if (!log.empty() && log != S.rtxPath)
+            {
+                S.rtxPath = log;
+                std::fprintf(stderr, "[native] recursos: %s\n", log.c_str());
+            }
+        }
+        wotm_live::g_stage = "snapshot";
+        wotm::Snapshot sn = S.scene.takeSnapshot(ram, tNow, gNow);
+        if (!sn.cam.ok)
+            return false;
+        S.A = S.B.valid ? std::move(S.B) : sn;
+        S.B = std::move(sn);
+    }
+    if (!S.B.valid)
+        return false;
+    if (IsKeyPressed(KEY_F4))
+        S.interp = !S.interp;
+    float alpha = 1.f;
+    {
+        const double span = S.B.t - S.A.t;   // duracao do quadro anterior do jogo; o atual deve durar parecido
+        if (S.interp && span > 0.004 && span < 0.25)
+            alpha = static_cast<float>((tNow - S.B.t) / span);
+    }
+    const wotm::GameCamera gc = S.scene.blend(S.A, S.B, alpha);
+    if (!gc.ok)
+        return false;
+
+    const int RW = 960, RH = 720;
+    if (S.rt.id == 0)
+        S.rt = LoadRenderTexture(RW, RH);
+
+    BeginTextureMode(S.rt);
+    ClearBackground(Color{30, 40, 60, 255});
+    rlSetClipPlanes(0.5, 30000.0);
+    Camera3D c3{};
+    c3.position = {gc.pos[0], gc.pos[1], gc.pos[2]};
+    c3.target = {gc.pos[0] + gc.fwd[0], gc.pos[1] + gc.fwd[1], gc.pos[2] + gc.fwd[2]};
+    c3.up = {gc.up[0], gc.up[1], gc.up[2]};
+    c3.fovy = gc.fovy;
+    c3.projection = CAMERA_PERSPECTIVE;
+    BeginMode3D(c3);
+    wotm_live::g_stage = "draw";
+    S.scene.draw(ram, false);
+    wotm_live::g_stage = "idle";
+    EndMode3D();
+    S.scene.updateText(ram);   // texto do jogo (menu de pausa, HUD): sprites do GS lidos de fontPacket
+    S.scene.drawText(ram, static_cast<float>(RW), static_cast<float>(RH));
+    EndTextureMode();
+
+    // letterbox 4:3 na janela
+    const float sw = static_cast<float>(GetScreenWidth()), sh = static_cast<float>(GetScreenHeight());
+    const float k = std::min(sw / RW, sh / RH);
+    const Rectangle src{0.f, 0.f, static_cast<float>(RW), -static_cast<float>(RH)};
+    const Rectangle dst{(sw - RW * k) * 0.5f, (sh - RH * k) * 0.5f, RW * k, RH * k};
+    DrawTexturePro(S.rt.texture, src, dst, Vector2{0.f, 0.f}, 0.f, WHITE);
+
+    {   // contador de FPS (F3 liga/desliga): "jogo" = quadros do jogo por segundo (g_frame, 0x6F7E38); "tela" = desenhos nativos por segundo
+        static bool show = true;
+        static uint32_t lastG = 0;
+        static double lastT = 0.0;
+        static int drawn = 0;
+        static float gameFps = 0.f, screenFps = 0.f;
+        if (IsKeyPressed(KEY_F3))
+            show = !show;
+        ++drawn;
+        const double now = GetTime();
+        static const bool camLog = std::getenv("WOTM_CAMLOG") != nullptr;   // diagnostico: serie temporal da camera lida (um [cam] por desenho)
+        if (camLog)
+            std::fprintf(stderr, "[cam] t=%.4f g=%u fov=%.2f pos=%.2f,%.2f,%.2f fwd=%.4f,%.4f,%.4f\n", now, ram.u32(0x6F7E38), gc.fovy, gc.pos[0],
+                         gc.pos[1], gc.pos[2], gc.fwd[0], gc.fwd[1], gc.fwd[2]);
+        if (lastT == 0.0)
+        {
+            lastT = now;
+            lastG = ram.u32(0x6F7E38);
+        }
+        else if (now - lastT >= 0.5)
+        {
+            const uint32_t g = ram.u32(0x6F7E38);
+            gameFps = static_cast<float>(g - lastG) / static_cast<float>(now - lastT);
+            screenFps = static_cast<float>(drawn) / static_cast<float>(now - lastT);
+            lastG = g;
+            drawn = 0;
+            lastT = now;
+        }
+        if (show)
+        {
+            char line[128];
+            std::snprintf(line, sizeof line, "jogo %.1f fps | tela %.1f fps | fov %.1f | interp %s (F4)", gameFps, screenFps, gc.fovy, S.interp ? "ligada" : "desligada");
+            DrawText(line, 11, 11, 20, BLACK);
+            DrawText(line, 10, 10, 20, gameFps >= 55.f ? GREEN : (gameFps >= 30.f ? YELLOW : RED));
+        }
+    }
+
+    if (++S.frame % 300 == 0 && std::getenv("PS2X_STATS"))
+        std::fprintf(stderr, "[native] frame %ld itens=%zu ceu=%zu nos=%u rtx=%s\n", S.frame, S.scene.items.size(), S.scene.sky.size(),
+                     S.scene.visited, S.rtxPath.c_str());
+    return true;
+}
+#else
+static bool wotmDrawNative(const uint8_t *) { return false; }
+#endif
diff --git a/ps2xRuntime/src/lib/wotm_overrides.cpp b/ps2xRuntime/src/lib/wotm_overrides.cpp
new file mode 100644
index 0000000..e47374e
--- /dev/null
+++ b/ps2xRuntime/src/lib/wotm_overrides.cpp
@@ -0,0 +1,240 @@
+// Correcoes especificas de War of the Monsters (SCUS_971.97) aplicadas por substituicao de funcoes do codigo recompilado.
+//
+// Limite do updateRate: `timerGetUpdateRate` (0x2236D8) devolve D_006F8DB8, quantos quadros por segundo o ultimo quadro
+// do jogo "valeu" (60 = 1 vsync). A fisica integra por Euler com `dt = 1 / rate` (mola do pelo em BoneSpring::update,
+// giro dos monstros em MonsterDynamics::updatePosition, veiculos, detritos...). No retail o rate e 60 ou 30; neste
+// runtime o jogo roda a ~20 quadros logicos/s e o rate oscila quadro a quadro entre 60 e 8, ou seja, dt ate 7x maior
+// que o previsto. Com esse dt os integradores ficam instaveis: o pelo do Congar estica pela cena toda e o controle de giro
+// (amortecimento ~ -40.5 * velRot, estavel so com dt < 2/40.5, rate >= 21) inverte e amplifica a velocidade a cada quadro
+// (monstro girando sozinho, a camera atras dele gira junto).
+// A correcao devolve no minimo WOTM_RATEMIN (padrao 30; 0 desliga) para o jogo inteiro: nos quadros lentos o jogo anda
+// um pouco mais devagar em vez de pular, e todo integrador fica na margem para a qual foi feito. Nada muda quando o rate
+// ja e >= 30 (retail). Substitui os limites pontuais anteriores (WOTM_SPRINGMIN na mola, WOTM_TURNMIN no giro).
+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+#include "runtime/ee_scheduler.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+extern std::atomic<unsigned long long> g_wotmIdleUs, g_wotmPaceUs;
+extern bool g_wotmCycleProf;
+extern uint64_t g_wotmEeCycle, g_wotmIdleCycles;
+extern uint32_t g_wotmProfPc[4096];
+extern uint64_t g_wotmProfCyc[4096];
+extern uint32_t g_wotmFreeSpinPc;
+
+namespace
+{
+    constexpr uint32_t kTimerGetUpdateRate = 0x2236D8u;
+    constexpr uint32_t kUpdateRateVar = 0x6F8DB8u;   // D_006F8DB8, lido pelo gp
+
+    int g_minRate = 30;
+    unsigned long long g_clamped = 0;
+
+    // Fields do quadro = vblanks que passaram desde o inicio dele (relogio do WotM, g_wotmFreeSpinPc != 0).
+    // O jogo mede o quadro pelo timer 1: timer1Handler soma ceil(T1 / 9619) ao contador de fields (D_006F8DBC) e espera o
+    // vsync; timerWaitForMinUpdateRate tira fields = D_006F8DBC - D_006F8DC0 e updateRate = 60 / fields. No PS2 o quadro
+    // comeca logo apos um vblank, entao "a logica cruzou n vblanks" e "T1 >= n fields" sao a mesma coisa. Aqui o timer anda
+    // pelo relogio virtual e o quadro comeca alguns ms (de host) depois do vblank: a logica cruza um vblank com T1 < 1 field,
+    // o jogo conta 1 field num quadro de 2 vsyncs e anda mais devagar que o relogio (18% dos quadros, ~11% de lentidao
+    // na luta). A correcao: na entrada de timerWaitForMinUpdateRate o contador passa a ser no minimo os vblanks desde o
+    // inicio do quadro (marcado pelo timerGetCurTics no fim de timerWaitForMinUpdateRate / em timerSetFrameStart).
+    constexpr uint32_t kTimerWaitForMinUpdateRate = 0x223568u;
+    constexpr uint32_t kTimerGetCurTics = 0x2236B8u;
+    constexpr uint32_t kFrameStartRa[2] = {0x22369Cu, 0x223480u};   // retorno do jal em timerWaitForMinUpdateRate / timerSetFrameStart
+    constexpr uint32_t kFieldCounter = 0x6F8DBCu, kFieldCounterAtStart = 0x6F8DC0u;
+    PS2Runtime::RecompiledFunction g_origWaitMinRate = nullptr, g_origGetCurTics = nullptr;
+    uint64_t g_frameStartVsync = 0;
+    bool g_frameStartValid = false;
+
+    void getCurTicsMarked(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t ra = GPR_U32(ctx, 31);
+        g_origGetCurTics(rdram, ctx, runtime);
+        if (ra == kFrameStartRa[0] || ra == kFrameStartRa[1])
+        {
+            g_frameStartVsync = runtime->eeScheduler().currentVSyncTick();
+            g_frameStartValid = true;
+        }
+    }
+
+
+    // WOTM_TURNLOG: uma linha [turn] por MonsterDynamics::updatePosition (cada monstro, cada quadro do jogo):
+    // quadro (g_frame), monstro, rate, acelRot (+0x110, zerada pela funcao), velRot (+0x100) antes/depois e os angulos
+    // (Monster+0xC -> +0x60, em radianos) depois da integracao. O rate mostrado e o da variavel (sem o limite).
+    constexpr uint32_t kMonsterDynamicsUpdatePosition = 0x165100u;
+    PS2Runtime::RecompiledFunction g_origUpdatePosition = nullptr;
+
+    void updatePositionLogged(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        auto readF = [&](uint8_t *, uint32_t addr)
+        {
+            const uint32_t w = READ32(addr);
+            float f;
+            std::memcpy(&f, &w, 4);
+            return f;
+        };
+        const uint32_t dyn = GPR_U32(ctx, 4);
+        float acc[3], v0[3];
+        for (int i = 0; i < 3; ++i)
+        {
+            acc[i] = readF(rdram, dyn + 0x110 + 4 * i);
+            v0[i] = readF(rdram, dyn + 0x100 + 4 * i);
+        }
+        const int32_t rate = static_cast<int32_t>(READ32(kUpdateRateVar));
+        g_origUpdatePosition(rdram, ctx, runtime);
+        const uint32_t mon = READ32(dyn);
+        const uint32_t cs = READ32(mon + 0xC);
+        std::fprintf(stderr, "[turn] g=%u mon=%06x rate=%d acc=%+.3f,%+.3f,%+.3f vel=%+.3f,%+.3f,%+.3f -> %+.3f,%+.3f,%+.3f ang=%+.3f,%+.3f,%+.3f\n",
+                     READ32(0x6F7E38u), mon, rate, acc[0], acc[1], acc[2], v0[0], v0[1], v0[2], readF(rdram, dyn + 0x100), readF(rdram, dyn + 0x104),
+                     readF(rdram, dyn + 0x108), readF(rdram, cs + 0x60), readF(rdram, cs + 0x64), readF(rdram, cs + 0x68));
+    }
+
+    // WOTM_FIELDLOG: uma linha [field] por quadro do jogo, detectado quando timerWaitForMinUpdateRate atualiza
+    // D_006F8DC0 (contagem de fields no inicio do quadro). Mostra os fields que o jogo mediu pelo timer 1 (D_006F8DB4),
+    // os ciclos virtuais do EE gastos (em fields: total, saltados no ocio e os 3 pcs de checkpoint que mais gastaram) e o
+    // tempo real (total, ocioso esperando evento e esperando o relogio de parede para soltar um prazo).
+    bool g_fieldLog = false;
+    // Chamadas a sceGsSyncV no quadro (cada uma espera 1 vsync) e o $ra das 4 primeiras: mostra quem gasta os fields.
+    constexpr uint32_t kSceGsSyncV = 0x231450u;
+    PS2Runtime::RecompiledFunction g_origSyncV = nullptr;
+    uint32_t g_syncVCalls = 0, g_syncVRa[4];
+    void syncVLogged(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        if (g_syncVCalls < 4)
+            g_syncVRa[g_syncVCalls] = GPR_U32(ctx, 31);
+        ++g_syncVCalls;
+        g_origSyncV(rdram, ctx, runtime);
+    }
+    uint32_t g_lastFieldStart = 0;
+    uint64_t g_lastCycle = 0, g_lastIdleUs = 0, g_lastPaceUs = 0;
+    std::chrono::steady_clock::time_point g_lastHost;
+
+    void fieldLogFrame(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t start = READ32(0x6F8DC0u);
+        if (start == g_lastFieldStart)
+            return;
+        g_lastFieldStart = start;
+        const auto now = std::chrono::steady_clock::now();
+        const uint64_t idleUs = g_wotmIdleUs.load(std::memory_order_relaxed), paceUs = g_wotmPaceUs.load(std::memory_order_relaxed);
+        int top[3] = {-1, -1, -1};
+        for (int i = 0; i < 4096; ++i)
+        {
+            if (!g_wotmProfCyc[i])
+                continue;
+            for (int k = 0; k < 3; ++k)
+            {
+                if (top[k] < 0 || g_wotmProfCyc[i] > g_wotmProfCyc[top[k]])
+                {
+                    for (int m = 2; m > k; --m)
+                        top[m] = top[m - 1];
+                    top[k] = i;
+                    break;
+                }
+            }
+        }
+        const double field = 294912000.0 / 59.94;
+        static uint32_t lastTics = 0;   // D_006F8DC4: ticks do timer 1 que o jogo acumulou (9619 por field)
+        const uint32_t tics = READ32(0x6F8DC4u);
+        std::fprintf(stderr, "[field] g=%u fields=%d rate=%d tics=%.2f ee=%.2f idle=%.2f host=%.1fms ocioso=%.1fms ritmo=%.1fms top",
+                     READ32(0x6F7E38u), static_cast<int32_t>(READ32(0x6F8DB4u)), static_cast<int32_t>(READ32(kUpdateRateVar)),
+                     (tics - lastTics) / 9619.0,
+                     (g_wotmEeCycle - g_lastCycle) / field, g_wotmIdleCycles / field,
+                     std::chrono::duration<double, std::milli>(now - g_lastHost).count(), (idleUs - g_lastIdleUs) / 1000.0,
+                     (paceUs - g_lastPaceUs) / 1000.0);
+        for (int k = 0; k < 3; ++k)
+            if (top[k] >= 0)
+                std::fprintf(stderr, " %06x=%.2f", g_wotmProfPc[top[k]], g_wotmProfCyc[top[k]] / field);
+        std::fprintf(stderr, " syncv=%u", g_syncVCalls);
+        for (uint32_t k = 0; k < g_syncVCalls && k < 4; ++k)
+            std::fprintf(stderr, "%c%06x", k ? ',' : ':', g_syncVRa[k]);
+        g_syncVCalls = 0;
+        std::fprintf(stderr, "\n");
+        std::memset(g_wotmProfPc, 0, sizeof(g_wotmProfPc));
+        std::memset(g_wotmProfCyc, 0, sizeof(g_wotmProfCyc));
+        g_wotmIdleCycles = 0;
+        g_lastCycle = g_wotmEeCycle;
+        g_lastHost = now;
+        g_lastIdleUs = idleUs;
+        g_lastPaceUs = paceUs;
+        lastTics = tics;
+    }
+
+    void waitMinRateByVblanks(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        // so na entrada: retomada no meio (depois de um sceGsSyncV do laco) ja tem D_006F8DC0 atualizado
+        if (ctx->pc == kTimerWaitForMinUpdateRate)
+        {
+            // [field] do quadro anterior: aqui roda em todo quadro (timerGetUpdateRate nao: no menu e no inicio da fase
+            // ha quadros sem chamada, e a linha somava dois quadros)
+            if (g_fieldLog)
+                fieldLogFrame(rdram, ctx, runtime);
+            if (g_wotmFreeSpinPc != 0u && g_frameStartValid)
+            {
+                const uint64_t vblanks = runtime->eeScheduler().currentVSyncTick() - g_frameStartVsync;
+                const int32_t start = static_cast<int32_t>(READ32(kFieldCounterAtStart));
+                const int32_t measured = static_cast<int32_t>(READ32(kFieldCounter)) - start;
+                if (vblanks > 0u && vblanks < 16u && static_cast<int32_t>(vblanks) > measured)
+                    WRITE32(kFieldCounter, static_cast<uint32_t>(start + static_cast<int32_t>(vblanks)));
+            }
+        }
+        g_origWaitMinRate(rdram, ctx, runtime);
+    }
+
+    // Mesmo comportamento da original (`jr $ra; lw $v0, gp_rel(D_006F8DB8)`), exceto o limite acima.
+    void timerGetUpdateRate(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        int32_t rate = static_cast<int32_t>(READ32(kUpdateRateVar));
+        if (rate > 0 && rate < g_minRate)
+        {
+            rate = g_minRate;
+            if ((++g_clamped % 20000ull) == 0 && std::getenv("PS2X_STATS"))
+                std::fprintf(stderr, "[wotm] updateRate limitado a %d em %llu chamadas\n", g_minRate, g_clamped);
+        }
+        SET_GPR_S32(ctx, 2, rate);
+        ctx->pc = GPR_U32(ctx, 31);
+    }
+}
+
+void wotmInstallOverrides(PS2Runtime &runtime, const std::string &elfPath)
+{
+    const size_t slash = elfPath.find_last_of("/\\");
+    const std::string name = slash == std::string::npos ? elfPath : elfPath.substr(slash + 1);
+    if (name.find("SCUS_971.97") == std::string::npos)
+        return;
+
+    if (const char *e = std::getenv("WOTM_RATEMIN"))
+        g_minRate = std::atoi(e);
+    if (std::getenv("WOTM_TURNLOG") && (g_origUpdatePosition = runtime.lookupFunction(kMonsterDynamicsUpdatePosition)))
+    {
+        runtime.registerFunction(kMonsterDynamicsUpdatePosition, &updatePositionLogged);
+        std::fprintf(stderr, "[wotm] log da rotacao dos monstros ligado (WOTM_TURNLOG)\n");
+    }
+    if (std::getenv("WOTM_FIELDLOG"))
+    {
+        g_fieldLog = g_wotmCycleProf = true;
+        g_lastHost = std::chrono::steady_clock::now();
+        if ((g_origSyncV = runtime.lookupFunction(kSceGsSyncV)))
+            runtime.registerFunction(kSceGsSyncV, &syncVLogged);
+        std::fprintf(stderr, "[wotm] log de fields por quadro ligado (WOTM_FIELDLOG)\n");
+    }
+    if (g_minRate > 0 || g_fieldLog)
+        runtime.registerFunction(kTimerGetUpdateRate, &timerGetUpdateRate);
+    if ((g_origWaitMinRate = runtime.lookupFunction(kTimerWaitForMinUpdateRate)) &&
+        (g_origGetCurTics = runtime.lookupFunction(kTimerGetCurTics)))
+    {
+        runtime.registerFunction(kTimerWaitForMinUpdateRate, &waitMinRateByVblanks);
+        runtime.registerFunction(kTimerGetCurTics, &getCurTicsMarked);
+    }
+    if (g_minRate > 0)
+        std::fprintf(stderr, "[wotm] updateRate >= %d (dt <= 1/%d) para o jogo inteiro (WOTM_RATEMIN)\n", g_minRate, g_minRate);
+    else
+        std::fprintf(stderr, "[wotm] updateRate sem limite (WOTM_RATEMIN=0)\n");
+}
