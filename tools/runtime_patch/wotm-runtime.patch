@@ -0,0 +1,122 @@
+// WoTM (step 6 of docs/passos/FRONTEIRA.md in the WoTM repo): IopSubsystem for the game executable (wotm), replacing
+// iop_subsystem.cpp. No IOP interpreter and no HLE modules (mcserv, dbcman, libsd): no IRX is ever loaded (the hook on
+// sceSifLoadModule in native/runtime/wotm_snd.inc), pad, CD and memory card are EE-side stubs and sound is native, so no
+// RPC has a server. Since step 9 there is no IOP RAM either (allocateMemory and friends below). ps2EntryRunner keeps the emulated
+// IOP (iop_subsystem.cpp).
+#include "ps2x/iop/iop_subsystem.h"
+
+#include <cstdio>
+
+namespace ps2x::iop
+{
+    namespace
+    {
+        void warnNoRam(const char *what, uint32_t address, size_t size)
+        {
+            static unsigned count = 0;
+            if (count++ < 4u)
+                std::fprintf(stderr, "[iop] IOP memory requested (%s, addr=0x%08x, 0x%zx bytes): wotm has no IOP RAM (FRONTEIRA step 9)\n",
+                             what, address, size);
+        }
+    }
+
+    class IopSubsystem::Impl
+    {
+    };
+
+    IopSubsystem::IopSubsystem(IopHost &)
+        : m_impl(std::make_unique<Impl>())
+    {
+    }
+
+    IopSubsystem::~IopSubsystem() = default;
+    IopSubsystem::IopSubsystem(IopSubsystem &&) noexcept = default;
+    IopSubsystem &IopSubsystem::operator=(IopSubsystem &&) noexcept = default;
+
+    void IopSubsystem::reset()
+    {
+    }
+
+    ModuleLoadResult IopSubsystem::loadModule(std::string_view, const void *, uint32_t)
+    {
+        return {true, -1, -1};
+    }
+
+    ModuleLoadResult IopSubsystem::loadModuleBuffer(uint32_t, const void *, uint32_t)
+    {
+        return {true, -1, -1};
+    }
+
+    bool IopSubsystem::stopModule(int32_t, int32_t *)
+    {
+        return false;
+    }
+
+    void IopSubsystem::runEeCycles(uint64_t) noexcept
+    {
+    }
+
+    RpcAbi IopSubsystem::selectRpcAbi(const RpcAbiRequest &) const
+    {
+        return RpcAbi::RuntimeDefault;
+    }
+
+    bool IopSubsystem::canBindRpc(uint32_t) const noexcept
+    {
+        return false;
+    }
+
+    RpcResult IopSubsystem::handleRpc(const RpcRequest &)
+    {
+        return {};
+    }
+
+    void IopSubsystem::onSifTransfer(const SifTransfer &)
+    {
+    }
+
+    // No IOP RAM: with native movies (on by default in wotm, main.cpp) nothing in the game asks for IOP memory. Measured on
+    // 2026-10-19 going from the menu to a fight with the pad script, and in a 4-monster fight. Only the game's own movie decoder
+    // (strFileOpen/strFileClose, sendToIOP) would use it, and it waits on the IPU, which does not exist: without native movies the
+    // game already stalled there. If anything asks, it fails with a warning.
+    uint32_t IopSubsystem::allocateMemory(uint32_t size, uint32_t)
+    {
+        warnNoRam("sceSifAllocIopHeap", 0u, size);
+        return 0u;
+    }
+
+    bool IopSubsystem::freeMemory(uint32_t address)
+    {
+        warnNoRam("sceSifFreeIopHeap", address, 0u);
+        return false;
+    }
+
+    bool IopSubsystem::readMemory(uint32_t address, void *, size_t size) const
+    {
+        warnNoRam("read", address, size);
+        return false;
+    }
+
+    bool IopSubsystem::writeMemory(uint32_t address, const void *, size_t size)
+    {
+        warnNoRam("write", address, size);
+        return false;
+    }
+
+    bool IopSubsystem::zeroMemory(uint32_t address, size_t size)
+    {
+        warnNoRam("zero", address, size);
+        return false;
+    }
+
+    bool IopSubsystem::isMemoryRange(uint32_t address, size_t size) const
+    {
+        warnNoRam("range", address, size);
+        return false;
+    }
+
+    DebugSnapshot IopSubsystem::debugSnapshot() const
+    {
+        return {};
+    }
+}
