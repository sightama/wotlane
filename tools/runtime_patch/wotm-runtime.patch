diff --git a/ps2xRuntime/src/lib/ps2_hostprof.cpp b/ps2xRuntime/src/lib/ps2_hostprof.cpp
new file mode 100644
index 0000000..9d839e4
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_hostprof.cpp
@@ -0,0 +1,147 @@
+// Amostrador de perfil do HOST (Windows): com PS2X_HOSTPROF=1 uma thread suspende cada thread do processo a cada ~1 ms, le o RIP e
+// faz um histograma por funcao (via dbghelp + PDB). Grava hostprof.txt a cada 10 s. Diagnostico do projeto WotM, nao e codigo do jogo.
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#include <tlhelp32.h>
+#include <dbghelp.h>
+#pragma comment(lib, "dbghelp.lib")
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+namespace
+{
+struct Hist
+{
+    std::unordered_map<unsigned long long, unsigned> byAddr;
+    unsigned total = 0;
+};
+
+void report(std::map<DWORD, Hist> &hist, HANDLE proc)
+{
+    FILE *f = std::fopen("hostprof.txt", "w");
+    if (!f)
+        return;
+    for (auto &kv : hist)
+    {
+        if (kv.second.total < 50)
+            continue;
+        std::unordered_map<std::string, unsigned> byName;
+        for (auto &a : kv.second.byAddr)
+        {
+            alignas(SYMBOL_INFO) char buf[sizeof(SYMBOL_INFO) + 256];
+            SYMBOL_INFO *sym = reinterpret_cast<SYMBOL_INFO *>(buf);
+            sym->SizeOfStruct = sizeof(SYMBOL_INFO);
+            sym->MaxNameLen = 255;
+            DWORD64 disp = 0;
+            std::string name = "?";
+            if (SymFromAddr(proc, a.first, &disp, sym))
+                name = sym->Name;
+            else
+            {
+                char tmp[40];
+                std::snprintf(tmp, sizeof(tmp), "0x%llx", a.first);
+                name = tmp;
+            }
+            byName[name] += a.second;
+        }
+        std::vector<std::pair<std::string, unsigned>> v(byName.begin(), byName.end());
+        std::sort(v.begin(), v.end(), [](auto &x, auto &y) { return x.second > y.second; });
+        std::fprintf(f, "== thread %lu: %u amostras\n", (unsigned long)kv.first, kv.second.total);
+        for (size_t i = 0; i < v.size() && i < 30; ++i)
+            std::fprintf(f, "  %5.1f%%  %s\n", 100.0 * v[i].second / kv.second.total, v[i].first.c_str());
+    }
+    std::fclose(f);
+}
+
+void samplerMain()
+{
+    HANDLE proc = GetCurrentProcess();
+    SymSetOptions(SYMOPT_DEFERRED_LOADS | SYMOPT_UNDNAME);
+    SymInitialize(proc, nullptr, TRUE);
+    const DWORD self = GetCurrentThreadId();
+    std::map<DWORD, Hist> hist;
+    auto lastReport = std::chrono::steady_clock::now();
+    std::vector<DWORD> tids;
+    int refresh = 0;
+    const auto startTime = std::chrono::steady_clock::now();
+    const char *skipEnv = std::getenv("PS2X_HOSTPROF_SKIP");
+    const int skipSecs = skipEnv ? std::atoi(skipEnv) : 0;
+    bool skipDone = skipSecs <= 0;
+    for (;;)
+    {
+        if (refresh-- <= 0)
+        {
+            refresh = 200;
+            tids.clear();
+            HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+            if (snap != INVALID_HANDLE_VALUE)
+            {
+                THREADENTRY32 te;
+                te.dwSize = sizeof(te);
+                for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te))
+                    if (te.th32OwnerProcessID == GetCurrentProcessId() && te.th32ThreadID != self)
+                        tids.push_back(te.th32ThreadID);
+                CloseHandle(snap);
+            }
+        }
+        for (DWORD tid : tids)
+        {
+            HANDLE th = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, tid);
+            if (!th)
+                continue;
+            if (SuspendThread(th) != (DWORD)-1)
+            {
+                // Sem alocar nada enquanto a thread esta suspensa (ela pode segurar o lock do heap).
+                CONTEXT ctx;
+                ctx.ContextFlags = CONTEXT_CONTROL;
+                const bool got = GetThreadContext(th, &ctx) != 0;
+                const unsigned long long rip = got ? ctx.Rip : 0ull;
+                ResumeThread(th);
+                if (got)
+                {
+                    Hist &h = hist[tid];
+                    ++h.byAddr[rip];
+                    ++h.total;
+                }
+            }
+            CloseHandle(th);
+        }
+        Sleep(1);
+        const auto now = std::chrono::steady_clock::now();
+        if (!skipDone && now - startTime > std::chrono::seconds(skipSecs))
+        {
+            skipDone = true;
+            hist.clear();
+        }
+        if (now - lastReport > std::chrono::seconds(10))
+        {
+            lastReport = now;
+            report(hist, proc);
+        }
+    }
+}
+
+} // namespace
+
+void wotmHostProfInit()
+{
+    static bool once = false;
+    if (once)
+        return;
+    once = true;
+    if (std::getenv("PS2X_HOSTPROF"))
+        std::thread(samplerMain).detach();
+}
+#else
+void wotmHostProfInit() {}
+#endif
