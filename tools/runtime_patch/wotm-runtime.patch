+
+void EeScheduler::publishSnapshot()
+{
+    EeKernelSnapshot next{};
+    next.sequence = ++m_snapshotSequence;
+    next.eeCycle = m_eeCycle;
+    next.runningThreadId = m_currentThreadId;
+    for (const auto &[id, item] : m_threads)
+    {
+        EeThreadSnapshot s{};
+        s.id = id;
+        const R5900Context &context = item.activeContext();
+        s.pc = context.pc;
+        s.ra = getRegU32(&context, 31);
+        s.sp = getRegU32(&context, 29);
+        s.contextGp = getRegU32(&context, 28);
+        s.entry = item.entry;
+        s.stack = item.stack;
+        s.stackSize = item.stackSize;
+        s.gp = item.gp;
+        s.initialPriority = item.initialPriority;
+        s.currentPriority = item.currentPriority;
+        s.status = item.status;
+        s.waitReason = item.wait.reason;
+        s.wakeupCount = item.wakeupCount;
+        s.invocationDepth = static_cast<uint32_t>(item.invocations.size());
+        next.threads.push_back(s);
+    }
+    std::sort(next.threads.begin(), next.threads.end(), [](const auto &l, const auto &r) { return l.id < r.id; });
+    for (const auto &[id, item] : m_semaphores)
+        next.semaphores.push_back(EeSemaphoreSnapshot{id, item.count, item.maxCount, 0u});
+    std::sort(next.semaphores.begin(), next.semaphores.end(), [](const auto &l, const auto &r) { return l.id < r.id; });
+    for (const auto &[id, item] : m_eventFlags)
+        next.eventFlags.push_back(EeEventFlagSnapshot{id, item.bits, item.initBits, item.attr, 0u});
+    std::sort(next.eventFlags.begin(), next.eventFlags.end(), [](const auto &l, const auto &r) { return l.id < r.id; });
+    std::lock_guard lock(m_snapshotMutex);
+    m_snapshot = std::move(next);
+}
