+static void hook_ret1(uint8_t *, R5900Context *ctx, PS2Runtime *) { setReturnS32(ctx, 1); } // CMovie::Update: "terminou"
+extern bool g_wotmVu1Tap;   // ps2_memory.cpp (checagem VU1 x nativo)
+static PS2Runtime::RecompiledFunction g_origFlushObjQ = nullptr;
+static void hook_flushObjQ(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+{
+    if (g_wotmVu1Tap && g_origFlushObjQ)   // quadro amostrado pela checagem VU1 x nativo (wotm_vu1check.inc): o DMA vai ao VIF1/VU1
+    {
+        g_origFlushObjQ(rdram, ctx, runtime);
+        return;
+    }
+    WRITE32(0x006F87A0u, 0u); // objsInPacket
+    WRITE32(0x006F87A4u, 0u); // objsInAlphaPacket
+}
+// Relogio do jogo. O jogo mede a duracao da logica de cada quadro pelo timer 1 (fields = ticks / 9619; updateRate =
+// 60 / fields; a fisica integra com dt = 1 / updateRate). O timer anda pelo relogio virtual do EE, e o particleDraw tem
+// um laco (0x21B8A0) que espera objsInPacket | objsInAlphaPacket zerarem (conclusao do VU1). Sem VU1 quem os zerava era
+// a apresentacao (60 Hz): o laco girava queimando 32 ciclos virtuais por volta e o jogo media 2 a 4 fields por quadro
+// aleatoriamente (updateRate 15/20/60 alternando; giro do monstro e mola do pelo instaveis).
+// Agora: os contadores sao zerados na entrada do particleDraw (sem VU1 nao ha o que esperar), as voltas no laco nao
+// contam ciclos, e o relogio virtual acompanha o de parede enquanto a logica roda (EeScheduler::checkpointDue): o jogo
+// mede a duracao real da logica, como no PS2 (2 fields, rate 30, na luta). WOTM_OLDCLOCK=1 volta ao comportamento antigo.
+extern uint32_t g_wotmFreeSpinPc, g_wotmFreeSpinZero[2];
+static PS2Runtime::RecompiledFunction g_particleDraw = nullptr;
+static void hook_particleDraw(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+{
+    // Quadro amostrado pela checagem VU1 x nativo: o fim do hier deixa o ultimo pacote (a OT de alfa com os objetos que a travessia
+    // guarda na hierAlpList: OBJECT 0x8000, e 0x4000 durante o fade de LOD) para o hierFlushObjQ da interrupcao do DMA do VIF1, que
+    // no PS2 chega antes daqui. Zerar os contadores sem disparar perdia a OT, e esses objetos saiam como "so o nativo desenha".
+    if (g_wotmVu1Tap && g_origFlushObjQ && (READ32(0x006F87A0u) || READ32(0x006F87A4u)))
+    {
+        R5900Context temp = *ctx;
+        g_origFlushObjQ(rdram, &temp, runtime);
+    }
+    WRITE32(0x006F87A0u, 0u);
+    WRITE32(0x006F87A4u, 0u);
+    g_particleDraw(rdram, ctx, runtime);
+}
