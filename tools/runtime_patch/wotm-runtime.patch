diff --git a/ps2xRuntime/cmake/ReleaseMode.cmake b/ps2xRuntime/cmake/ReleaseMode.cmake
index 92ef0d5..d7c208c 100644
--- a/ps2xRuntime/cmake/ReleaseMode.cmake
+++ b/ps2xRuntime/cmake/ReleaseMode.cmake
@@ -4,6 +4,36 @@ check_ipo_supported(RESULT IPO_SUPPORTED OUTPUT IPO_ERROR)
 
 function(EnableFastReleaseMode TargetName)
     message("> Enabling optimization for: ${TargetName}")
+    # WotM: STRICT_FP (the translated game code) keeps every float operation rounded on its own, as on the PS2: no /fp:fast and no
+    # FMA contraction, so MSVC/x86 and clang/arm64 compute the same game state (online play across Windows and Mac)
+    set(_wotmFp /fp:fast)
+    if("STRICT_FP" IN_LIST ARGN)
+        set(_wotmFp /fp:precise)
+        if(NOT MSVC)
+            target_compile_options(${TargetName} PRIVATE -ffp-contract=off)
+        endif()
+    endif()
+    # WotM: gcc/clang on x86 get the same instruction set as MSVC's /arch:AVX2 below (ps2_runtime_macros.h and native/ use SSE4.1
+    # intrinsics); ARM builds go through sse2neon and need nothing here
+    if(NOT MSVC AND NOT PS2X_IS_ARM_TARGET)
+        target_compile_options(${TargetName} PRIVATE -mavx2 -mbmi2 -mlzcnt -mpopcnt)
+    endif()
+    if(PS2X_FAST_LINK)
+        # Development build: same per-file optimization, but no whole-program optimization (/GL, /LTCG, IPO).
+        # Linking drops from ~25 min to seconds/minutes; the code gets a little slower (no inlining across files).
+        if(MSVC)
+            target_compile_options(${TargetName} PRIVATE
+                $<$<CONFIG:Release>:/O2 /Ob2 /Oi /Gy /Gw /GF /Zc:inline ${_wotmFp} /DNDEBUG /arch:AVX2 /GS- /Qspectre->)
+            # WotM: PDB with public symbols only (no /Zi) plus a .map, so the host sampler (PS2X_HOSTPROF) and [CRASH] reports
+            # can show names; /OPT:REF /OPT:ICF keep the binary the same as without /DEBUG
+            get_target_property(_wotmType ${TargetName} TYPE)
+            if(_wotmType STREQUAL "EXECUTABLE")
+                target_link_options(${TargetName} PRIVATE
+                    $<$<CONFIG:Release>:/DEBUG:FULL /OPT:REF /OPT:ICF /INCREMENTAL:NO /MAP>)
+            endif()
+        endif()
+        return()
+    endif()
     if(MSVC)
         target_compile_options(${TargetName} PRIVATE
             $<$<CONFIG:Release>:
@@ -15,7 +45,7 @@ function(EnableFastReleaseMode TargetName)
                 /Gw # global data in COMDAT
                 /GF # string pooling
                 /Zc:inline # remove unreferenced inline
-                /fp:fast # fast math (graphics friendly)
+                ${_wotmFp} # fast math (graphics friendly); /fp:precise with STRICT_FP
                 /DNDEBUG
                 /arch:AVX2 # Advanced Vector Extensions 2
                 /GS- # Disable Buffer Security Check (faster)
