+// ---- semaphores and event flags (WotM creates 2 semaphores and never uses them) ----
+
+int EeScheduler::createSemaphore(int initCount, int maxCount, uint32_t attr, uint32_t option)
+{
+    if (maxCount <= 0 || initCount < 0 || initCount > maxCount)
+        return KE_ERROR;
+    const int id = allocatePositiveId(m_nextSemaphoreId, m_semaphores);
+    if (id == 0)
+        return KE_ERROR;
+    EeSemaphore semaphore{};
+    semaphore.id = id;
+    semaphore.count = initCount;
+    semaphore.maxCount = maxCount;
+    semaphore.initCount = initCount;
+    semaphore.attr = attr;
+    semaphore.option = option;
+    m_semaphores.emplace(id, std::move(semaphore));
+    publishSnapshot();
+    return id;
+}
+
+int EeScheduler::deleteSemaphore(int id, bool)
+{
+    if (m_semaphores.erase(id) == 0u)
+        return KE_UNKNOWN_SEMID;
+    publishSnapshot();
+    return id;
+}
+
+int EeScheduler::signalSemaphore(int id, bool)
+{
+    EeSemaphore *object = semaphore(id);
+    if (!object)
+        return KE_UNKNOWN_SEMID;
+    if (object->count == object->maxCount)
+        return KE_SEMA_OVF;
+    ++object->count;
+    return id;
+}
+
+int EeScheduler::pollSemaphore(int id)
+{
+    EeSemaphore *object = semaphore(id);
+    if (!object)
+        return KE_UNKNOWN_SEMID;
+    if (object->count == 0)
+        return KE_SEMA_ZERO;
+    --object->count;
+    return id;
+}
+
+void EeScheduler::waitSemaphore(int id)
+{
+    if (!semaphore(id))
+    {
+        setReturnS32(currentContext(), KE_UNKNOWN_SEMID);
+        return;
+    }
+    if (semaphore(id)->count == 0)
+    {
+        warnUnsupported("WaitSema blocked (waiting in place for an interrupt)", id);
+        wotmWaitUntil(*this, m_threads.at(kMainThreadId), EeWaitReason::Semaphore,
+                      [this, id]() { const EeSemaphore *s = semaphore(id); return !s || s->count != 0; },
+                      &EeScheduler::wotmIdleWait, &EeScheduler::wotmService, m_stopRequested);
+    }
+    EeSemaphore *object = semaphore(id);
+    if (!object)
+    {
+        setReturnS32(currentContext(), KE_WAIT_DELETE);
+        return;
+    }
+    if (object->count != 0)
+        --object->count;
+    setReturnS32(currentContext(), id);
+}
+
+int EeScheduler::createEventFlag(uint32_t initialBits, uint32_t attr, uint32_t option)
+{
+    const int id = allocatePositiveId(m_nextEventFlagId, m_eventFlags);
+    if (id == 0)
+        return KE_ERROR;
+    EeEventFlag flag{};
+    flag.id = id;
+    flag.attr = attr;
+    flag.option = option;
+    flag.initBits = initialBits;
+    flag.bits = initialBits;
+    m_eventFlags.emplace(id, std::move(flag));
+    publishSnapshot();
+    return id;
+}
+
+int EeScheduler::deleteEventFlag(int id, bool)
+{
+    if (m_eventFlags.erase(id) == 0u)
+        return KE_UNKNOWN_EVFID;
+    publishSnapshot();
+    return KE_OK;
+}
+
+int EeScheduler::setEventFlag(int id, uint32_t bits, bool)
+{
+    EeEventFlag *flag = eventFlag(id);
+    if (!flag)
+        return KE_UNKNOWN_EVFID;
+    flag->bits |= bits;
+    return KE_OK;
+}
+
+int EeScheduler::clearEventFlag(int id, uint32_t mask)
+{
+    EeEventFlag *flag = eventFlag(id);
+    if (!flag)
+        return KE_UNKNOWN_EVFID;
+    flag->bits &= mask;
+    return KE_OK;
+}
+
+int EeScheduler::pollEventFlag(int id, uint32_t bits, uint32_t mode, uint32_t &observedBits)
+{
+    EeEventFlag *flag = eventFlag(id);
+    if (!flag)
+        return KE_UNKNOWN_EVFID;
+    if (!eventCond(flag->bits, bits, mode))
+        return KE_EVF_COND;
+    observedBits = flag->bits;
+    if ((mode & WEF_CLEAR_ALL) != 0u)
+        flag->bits = 0;
+    else if ((mode & WEF_CLEAR) != 0u)
+        flag->bits &= ~bits;
+    return KE_OK;
+}
+
+void EeScheduler::waitEventFlag(int id, uint32_t bits, uint32_t mode, uint32_t resultAddress)
+{
+    if (!eventFlag(id))
+    {
+        setReturnS32(currentContext(), KE_UNKNOWN_EVFID);
+        return;
+    }
+    if (!eventCond(eventFlag(id)->bits, bits, mode))
+    {
+        warnUnsupported("WaitEventFlag blocked (waiting in place for an interrupt)", id);
+        wotmWaitUntil(*this, m_threads.at(kMainThreadId), EeWaitReason::EventFlag,
+                      [this, id, bits, mode]() { const EeEventFlag *f = eventFlag(id); return !f || eventCond(f->bits, bits, mode); },
+                      &EeScheduler::wotmIdleWait, &EeScheduler::wotmService, m_stopRequested);
+    }
+    EeEventFlag *flag = eventFlag(id);
+    if (!flag)
+    {
+        setReturnS32(currentContext(), KE_WAIT_DELETE);
+        return;
+    }
+    writeGuestU32(resultAddress, flag->bits);
+    if ((mode & WEF_CLEAR_ALL) != 0u)
+        flag->bits = 0;
+    else if ((mode & WEF_CLEAR) != 0u)
+        flag->bits &= ~bits;
+    setReturnS32(currentContext(), KE_OK);
+}
