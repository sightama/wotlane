+// O FPU do R5900 nao tem infinito nem NaN nem denormais: estouro, divisao por zero e operacoes invalidas dao +-Fmax (0x7F7FFFFF), denormais
+// viram +-0, e cvt.w.s TRUNCA (nao arredonda) e satura em 0x7FFFFFFF/0x80000000. O IEEE do PC (inf/NaN) fazia o iterador de grade da
+// colisao (HdItGridLine) nunca terminar: x/0 = inf -> cvt.w.s = INT_MIN.
+static inline float ps2_fpu_fix(float v)
+{
+    uint32_t b;
+    std::memcpy(&b, &v, sizeof(b));
+    const uint32_t e = b & 0x7F800000u;
+    if (e == 0x7F800000u) // inf ou NaN -> +-Fmax
+        b = (b & 0x80000000u) | 0x7F7FFFFFu;
+    else if (e == 0u) // zero ou denormal -> +-0
+        b &= 0x80000000u;
+    std::memcpy(&v, &b, sizeof(v));
+    return v;
+}
+static inline float ps2_fpu_div(float a, float b)
+{
+    a = ps2_fpu_fix(a);
+    b = ps2_fpu_fix(b);
+    if (b == 0.0f) // inclusive 0/0: resultado +-Fmax com o sinal do xor
+    {
+        uint32_t ba, bb;
+        std::memcpy(&ba, &a, sizeof(ba));
+        std::memcpy(&bb, &b, sizeof(bb));
+        const uint32_t r = ((ba ^ bb) & 0x80000000u) | 0x7F7FFFFFu;
+        float f;
+        std::memcpy(&f, &r, sizeof(f));
+        return f;
+    }
+    return ps2_fpu_fix(a / b);
+}
+static inline int32_t ps2_fpu_cvt_w(float v)
+{
+    v = ps2_fpu_fix(v);
+    if (v >= 2147483648.0f)
+        return 0x7FFFFFFF;
+    if (v <= -2147483648.0f)
+        return (int32_t)0x80000000u;
+    return (int32_t)v; // trunca
