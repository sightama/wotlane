     void IopEmulator::runEeCycles(uint64_t eeCycles) noexcept
     {
+        // WotM: the IOP loop (scans threads/timers/DMA) cost ~18% of the CPU because it ran at every
+        // EE checkpoint, each with only a few cycles. Accumulate and run in batches (PS2X_IOP_BATCH, in IOP cycles).
+        static const uint64_t batch = []() -> uint64_t
+        {
+            const char *e = std::getenv("PS2X_IOP_BATCH");
+            const long v = e ? std::atol(e) : 256;
+            return v > 0 ? static_cast<uint64_t>(v) : 1u;
+        }();
+        // WotM: with no module loaded (the game loads no IRX; wotm_snd.inc) and no pending event there is nothing to run: the IOP idles.
+        if (m_impl->modules.empty() && m_impl->pendingDmaInterrupts.empty() && m_impl->pendingGuestCallbacks.empty())
+        {
+            static bool s_said = false;
+            if (!s_said)
+            {
+                s_said = true;
+                std::fprintf(stderr, "[iop] no modules: the emulated IOP stays idle\n");
+            }
+            m_impl->eeCycleCarry = 0;
+            return;
+        }
         const uint64_t total = m_impl->eeCycleCarry + eeCycles;
+        if (total < batch * 8u)
+        {
+            m_impl->eeCycleCarry = total;
+            return;
+        }
         const uint64_t iopCycles = total / 8u;
         m_impl->eeCycleCarry = total % 8u;
         if (iopCycles)
