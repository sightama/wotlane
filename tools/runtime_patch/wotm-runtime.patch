+void EeScheduler::shiftHostDeadlines(std::chrono::steady_clock::duration d)
+{
+    {
+        std::lock_guard lock(m_eventMutex);
+        G.next += d;
+        G.vblankDue = 0;   // vblanks counted during the pause don't fire on resume
+    }
+    G.timerCv.notify_all();
+}
