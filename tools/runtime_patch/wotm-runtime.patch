diff --git a/ps2xRuntime/src/lib/ps2_hostprof.cpp b/ps2xRuntime/src/lib/ps2_hostprof.cpp
new file mode 100644
index 0000000..17f25f6
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_hostprof.cpp
@@ -0,0 +1,348 @@
+// HOST profiling sampler (Windows): with PS2X_HOSTPROF=1 a thread suspends every thread in the process every ~1 ms, reads the RIP and
+// builds a per-function histogram (via dbghelp + PDB). Writes hostprof.txt every 10 s. A WotM project diagnostic, not game code.
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#include <tlhelp32.h>
+#include <dbghelp.h>
+#pragma comment(lib, "dbghelp.lib")
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+namespace
+{
+struct Hist
+{
+    std::unordered_map<unsigned long long, unsigned> byAddr;
+    unsigned total = 0;
+};
+
+// Watched thread (wotmHostProfWatchThisThread; the EE one): each sample keeps the RIP and the first stack words, so that
+// wotmHostProfDump can tell where it was during an interval (a slow frame). Stack words that land in code become an approximate
+// call chain (heuristic: no real unwinding, so stale return addresses may show up in the middle).
+constexpr size_t kRing = 4096, kStackWords = 256;
+struct Sample
+{
+    long long t = 0;   // steady_clock, ns
+    unsigned long long rip = 0;
+    unsigned long long stk[kStackWords] = {};
+};
+std::atomic<DWORD> g_watchTid{0};
+std::atomic<long long> g_frameStartNs{0};   // start of the watched thread's current frame (PS2X_HOSTPROF=3)
+std::mutex g_ringMutex, g_symMutex;   // dbghelp is not thread-safe
+std::vector<Sample> g_ring;
+size_t g_ringNext = 0;
+std::atomic<bool> g_symReady{false};
+
+std::string symName(HANDLE proc, unsigned long long addr, bool *isCode = nullptr)
+{
+    alignas(SYMBOL_INFO) char buf[sizeof(SYMBOL_INFO) + 256];
+    SYMBOL_INFO *sym = reinterpret_cast<SYMBOL_INFO *>(buf);
+    sym->SizeOfStruct = sizeof(SYMBOL_INFO);
+    sym->MaxNameLen = 255;
+    DWORD64 disp = 0;
+    if (SymFromAddr(proc, addr, &disp, sym) && disp < 0x10000)
+    {
+        if (isCode)
+            *isCode = true;
+        return sym->Name;
+    }
+    if (isCode)
+        *isCode = false;
+    char tmp[40];
+    static const unsigned long long exeBase = reinterpret_cast<unsigned long long>(GetModuleHandleW(nullptr));
+    if (addr >= exeBase && addr - exeBase < 0x10000000ull)
+        std::snprintf(tmp, sizeof(tmp), "exe+0x%llx", addr - exeBase);   // no PDB: look it up in ps2EntryRunner.map
+    else
+        std::snprintf(tmp, sizeof(tmp), "0x%llx", addr);
+    return tmp;
+}
+
+void report(std::map<DWORD, Hist> &hist, HANDLE proc)
+{
+    std::lock_guard<std::mutex> symLock(g_symMutex);
+    FILE *f = std::fopen("hostprof.txt", "w");
+    if (!f)
+        return;
+    for (auto &kv : hist)
+    {
+        if (kv.second.total < 50)
+            continue;
+        std::unordered_map<std::string, unsigned> byName;
+        for (auto &a : kv.second.byAddr)
+        {
+            alignas(SYMBOL_INFO) char buf[sizeof(SYMBOL_INFO) + 256];
+            SYMBOL_INFO *sym = reinterpret_cast<SYMBOL_INFO *>(buf);
+            sym->SizeOfStruct = sizeof(SYMBOL_INFO);
+            sym->MaxNameLen = 255;
+            DWORD64 disp = 0;
+            std::string name = "?";
+            if (SymFromAddr(proc, a.first, &disp, sym))
+                name = sym->Name;
+            else
+            {
+                char tmp[40];
+                std::snprintf(tmp, sizeof(tmp), "0x%llx", a.first);
+                name = tmp;
+            }
+            byName[name] += a.second;
+        }
+        std::vector<std::pair<std::string, unsigned>> v(byName.begin(), byName.end());
+        std::sort(v.begin(), v.end(), [](auto &x, auto &y) { return x.second > y.second; });
+        std::fprintf(f, "== thread %lu: %u samples\n", (unsigned long)kv.first, kv.second.total);
+        for (size_t i = 0; i < v.size() && i < 30; ++i)
+            std::fprintf(f, "  %5.1f%%  %s\n", 100.0 * v[i].second / kv.second.total, v[i].first.c_str());
+    }
+    std::fclose(f);
+}
+
+void samplerMain()
+{
+    HANDLE proc = GetCurrentProcess();
+    SymSetOptions(SYMOPT_DEFERRED_LOADS | SYMOPT_UNDNAME);
+    {
+        std::lock_guard<std::mutex> symLock(g_symMutex);
+        SymInitialize(proc, nullptr, TRUE);
+    }
+    g_symReady.store(true);
+    {
+        std::lock_guard<std::mutex> lk(g_ringMutex);
+        g_ring.resize(kRing);
+    }
+    Sample cur;
+    const DWORD self = GetCurrentThreadId();
+    std::map<DWORD, Hist> hist;
+    auto lastReport = std::chrono::steady_clock::now();
+    std::vector<DWORD> tids;
+    int refresh = 0;
+    const auto startTime = std::chrono::steady_clock::now();
+    const char *skipEnv = std::getenv("PS2X_HOSTPROF_SKIP");
+    const int skipSecs = skipEnv ? std::atoi(skipEnv) : 0;
+    bool skipDone = skipSecs <= 0;
+    // PS2X_HOSTPROF=2: only the watched thread (the EE one), without suspending the others; disturbs the process less.
+    // PS2X_HOSTPROF=3: wakes every 50 ms and samples the watched thread only once its frame has run past 100 ms
+    // (wotmHostProfFrameStart): for stalls that vanish with the 1 ms sampler on.
+    const char *modeEnv = std::getenv("PS2X_HOSTPROF");
+    const bool slowOnly = modeEnv && modeEnv[0] == '3';
+    const bool onlyWatched = modeEnv && (modeEnv[0] == '2' || slowOnly);
+    FILE *rawFile = std::getenv("PS2X_HOSTPROF_RAW") ? std::fopen("hostprof_raw.txt", "w") : nullptr;
+    const unsigned long long exeBase = reinterpret_cast<unsigned long long>(GetModuleHandleW(nullptr));
+    const unsigned long long exeSize = 0x10000000ull;
+    std::vector<unsigned long long> rawOutside;   // RIPs outside the exe since the last flush (name resolved at flush, "#sym")
+    std::unordered_map<unsigned long long, bool> rawNamed;
+    for (;;)
+    {
+        if (onlyWatched)
+        {
+            tids.clear();
+            const long long start = g_frameStartNs.load(std::memory_order_relaxed);
+            const long long nowNs = std::chrono::steady_clock::now().time_since_epoch().count();
+            if (const DWORD w = g_watchTid.load())
+                if (!slowOnly || (start != 0 && nowNs - start > 100000000ll))
+                    tids.push_back(w);
+        }
+        else if (refresh-- <= 0)
+        {
+            refresh = 200;
+            tids.clear();
+            HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+            if (snap != INVALID_HANDLE_VALUE)
+            {
+                THREADENTRY32 te;
+                te.dwSize = sizeof(te);
+                for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te))
+                    if (te.th32OwnerProcessID == GetCurrentProcessId() && te.th32ThreadID != self)
+                        tids.push_back(te.th32ThreadID);
+                CloseHandle(snap);
+            }
+        }
+        for (DWORD tid : tids)
+        {
+            HANDLE th = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, tid);
+            if (!th)
+                continue;
+            if (SuspendThread(th) != (DWORD)-1)
+            {
+                // Allocate nothing while the thread is suspended (it may be holding the heap lock).
+                CONTEXT ctx;
+                ctx.ContextFlags = CONTEXT_CONTROL;
+                const bool got = GetThreadContext(th, &ctx) != 0;
+                const unsigned long long rip = got ? ctx.Rip : 0ull;
+                const bool watched = got && tid == g_watchTid.load(std::memory_order_relaxed);
+                SIZE_T read = 0;
+                if (watched)
+                {
+                    cur.t = std::chrono::steady_clock::now().time_since_epoch().count();
+                    cur.rip = rip;
+                    std::memset(cur.stk, 0, sizeof(cur.stk));
+                    ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<LPCVOID>(ctx.Rsp), cur.stk, sizeof(cur.stk), &read);
+                }
+                ResumeThread(th);
+                if (watched)
+                {
+                    std::lock_guard<std::mutex> lk(g_ringMutex);
+                    g_ring[g_ringNext++ % kRing] = cur;
+                }
+                // PS2X_HOSTPROF_RAW: each sample of the watched thread becomes a line "rip w1 w2 ..." (RVA in hex; the stack words
+                // that land in the executable), to resolve against the .map (which has the static functions) and sum inclusive time.
+                if (watched && rawFile && skipDone)
+                {
+                    const unsigned long long n = read / sizeof(unsigned long long);
+                    std::fprintf(rawFile, "%llx", rip - exeBase);
+                    if (rip < exeBase || rip - exeBase >= exeSize)
+                        rawOutside.push_back(rip);
+                    for (unsigned long long i = 0, k = 0; i < n && k < 48; ++i)
+                        if (cur.stk[i] > exeBase && cur.stk[i] - exeBase < exeSize)
+                        {
+                            std::fprintf(rawFile, " %llx", cur.stk[i] - exeBase);
+                            ++k;
+                        }
+                    std::fputc(10, rawFile);
+                }
+                if (got)
+                {
+                    Hist &h = hist[tid];
+                    ++h.byAddr[rip];
+                    ++h.total;
+                }
+            }
+            CloseHandle(th);
+        }
+        Sleep(slowOnly ? 50 : 1);
+        const auto now = std::chrono::steady_clock::now();
+        if (!skipDone && now - startTime > std::chrono::seconds(skipSecs))
+        {
+            skipDone = true;
+            hist.clear();
+        }
+        if (now - lastReport > std::chrono::seconds(10))
+        {
+            lastReport = now;
+            if (rawFile)
+            {
+                // name (module!function from the system's exports/PDB) of each RIP outside the exe: "#sym <rva as in the line> <name>"
+                std::lock_guard<std::mutex> symLock(g_symMutex);
+                for (const unsigned long long r : rawOutside)
+                {
+                    if (rawNamed.count(r))
+                        continue;
+                    rawNamed[r] = true;
+                    alignas(SYMBOL_INFO) char buf[sizeof(SYMBOL_INFO) + 256];
+                    SYMBOL_INFO *sym = reinterpret_cast<SYMBOL_INFO *>(buf);
+                    sym->SizeOfStruct = sizeof(SYMBOL_INFO);
+                    sym->MaxNameLen = 255;
+                    DWORD64 disp = 0;
+                    IMAGEHLP_MODULE64 mod{};
+                    mod.SizeOfStruct = sizeof(mod);
+                    const char *mname = SymGetModuleInfo64(proc, r, &mod) ? mod.ModuleName : "?";
+                    const char *fname = SymFromAddr(proc, r, &disp, sym) ? sym->Name : "?";
+                    std::fprintf(rawFile, "#sym %llx %s!%s%c", r - exeBase, mname, fname, 10);
+                }
+                rawOutside.clear();
+                std::fflush(rawFile);
+            }
+            report(hist, proc);
+        }
+    }
+}
+
+} // namespace
+
+void wotmHostProfInit()
+{
+    static bool once = false;
+    if (once)
+        return;
+    once = true;
+    if (std::getenv("PS2X_HOSTPROF"))
+        std::thread(samplerMain).detach();
+}
+
+// CPU time (user + kernel) of the calling thread, in ms (WOTM_FIELDLOG: tells a slow spinning frame from a blocked one)
+double wotmThreadCpuMs()
+{
+    FILETIME c, e, k, u;
+    if (!GetThreadTimes(GetCurrentThread(), &c, &e, &k, &u))
+        return 0.0;
+    const unsigned long long kk = (static_cast<unsigned long long>(k.dwHighDateTime) << 32) | k.dwLowDateTime;
+    const unsigned long long uu = (static_cast<unsigned long long>(u.dwHighDateTime) << 32) | u.dwLowDateTime;
+    return (kk + uu) / 10000.0;   // units of 100 ns
+}
+
+// Marks the start of a frame on the watched thread (PS2X_HOSTPROF=3 only samples frames that run past 100 ms)
+void wotmHostProfFrameStart()
+{
+    g_frameStartNs.store(std::chrono::steady_clock::now().time_since_epoch().count(), std::memory_order_relaxed);
+}
+
+// The calling thread becomes the watched one (only one; the last call wins)
+void wotmHostProfWatchThisThread()
+{
+    g_watchTid.store(GetCurrentThreadId());
+}
+
+// Stack word that may be a return address: inside a loaded module (the exe or a DLL)
+static bool inModule(HANDLE proc, unsigned long long a)
+{
+    return a >= 0x10000 && SymGetModuleBase64(proc, a) != 0;
+}
+
+// Where the watched thread was between t0 and t1 (steady_clock, ns): samples grouped by RIP and by the first 8 stack words
+// that land in a module, most frequent first, on stderr with the [hostprof] prefix. At most one dump every 2 s
+// (the dump runs on the watched thread itself and makes the next frame longer).
+void wotmHostProfDump(long long t0, long long t1, const char *tag)
+{
+    static long long lastDump = 0;
+    if (!g_symReady.load() || t1 - lastDump < 2000000000ll)
+        return;
+    lastDump = t1;
+    std::vector<Sample> sel;
+    {
+        std::lock_guard<std::mutex> lk(g_ringMutex);
+        for (const Sample &s : g_ring)
+            if (s.t >= t0 && s.t <= t1)
+                sel.push_back(s);
+    }
+    std::lock_guard<std::mutex> symLock(g_symMutex);
+    HANDLE proc = GetCurrentProcess();
+    std::unordered_map<std::string, unsigned> sig;
+    for (const Sample &s : sel)
+    {
+        std::string key = symName(proc, s.rip);
+        int n = 0;
+        for (size_t i = 0; i < kStackWords && n < 8; ++i)
+        {
+            const unsigned long long w = s.stk[i];
+            if (!inModule(proc, w))
+                continue;
+            const std::string name = symName(proc, w);
+            key += " < " + name;
+            ++n;
+        }
+        ++sig[key];
+    }
+    std::vector<std::pair<std::string, unsigned>> v(sig.begin(), sig.end());
+    std::sort(v.begin(), v.end(), [](auto &x, auto &y) { return x.second > y.second; });
+    std::fprintf(stderr, "[hostprof] %s: %zu samples of the watched thread in %.1f ms\n", tag, sel.size(), (t1 - t0) / 1e6);
+    for (size_t i = 0; i < v.size() && i < 8; ++i)
+        std::fprintf(stderr, "[hostprof]   %4u  %s\n", v[i].second, v[i].first.c_str());
+}
+#else
+void wotmHostProfInit() {}
+double wotmThreadCpuMs() { return 0.0; }
+void wotmHostProfFrameStart() {}
+void wotmHostProfWatchThisThread() {}
+void wotmHostProfDump(long long, long long, const char *) {}
+#endif
