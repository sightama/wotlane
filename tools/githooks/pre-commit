#!/bin/sh
# Blocks a commit that mixes history into reference docs or leaves a finished item in TODO.md (tools/doclint.py; rule in CLAUDE.md,
# "Documentation"). Enable once per clone: git config core.hooksPath tools/githooks
# Only looks at the .md files the commit changes; without Python, lets the commit through.
git diff --cached --name-only -- '*.md' | grep -q . || exit 0
root=$(git rev-parse --show-toplevel)
for py in python python3; do
    if "$py" -c "import sys" >/dev/null 2>&1; then
        exec "$py" "$root/tools/doclint.py"
    fi
done
exit 0
